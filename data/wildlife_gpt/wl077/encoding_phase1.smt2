(forall ((p Person) (w WaterBody) (d Device) (t Int))
  (=> (and (on_water_body p w t)
           (water_kind w WK_CoastalWater)
           (or (device_kind d DK_Seine)
               (device_kind d DK_StrikeNet)
               (device_kind d DK_GillNet)
               (device_kind d DK_TrammelNet))
           (or (uses_device p d t)
               (possesses_device p d t)))
      (or (and (has_attached_tag d t)
               (tag_discloses_owner d))
          (has_subchapter_authorization p t))))