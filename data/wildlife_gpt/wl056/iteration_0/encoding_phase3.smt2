(forall ((p Person) (fish Animal) (w WaterBody) (d Device) (county Int) (t Int))
  (=> (and (is_kind fish AK_Fish)
           (or (takes p fish t) (attempts_to_catch p fish t))
           (on_canal_or_artificial_waterway p w t)
           (in_designated_waterway_county county)
           (population_at_least county 2)
           (uses_device p d t)
           (or (device_kind d DK_Seine)
               (device_kind d DK_StrikeNet)
               (device_kind d DK_GillNet)
               (device_kind d DK_TrammelNet)
               (device_kind d DK_OtherFishingDevice))
           (not (device_kind d DK_HandsOnly))
           (not (and (device_kind d DK_Seine)
                     (has_required_buoyancy d)
                     (<= (float_spacing_feet d) 0.0))))
      (and (not (takes p fish t))
           (not (attempts_to_catch p fish t)))))