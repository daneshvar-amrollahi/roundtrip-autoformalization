(forall ((hunter Person) (a Animal) (d Device) (t Int))
  (=> (and (hunts hunter a t)
           (or (is_kind a AK_WildBird)
               (is_kind a AK_WildGameBird)
               (is_kind a AK_WildFowl)
               (is_kind a AK_WildGameAnimal)
               (is_kind a AK_NongameAnimal))
           (not (is_kind a AK_Alligator))
           (not (is_kind a AK_Frog))
           (not (is_kind a AK_Turtle))
           (or (and (device_kind d DK_Aircraft) (inside_device hunter d t))
               (and (device_kind d DK_AirborneDevice) (inside_device hunter d t))
               (and (device_kind d DK_MotorVehicle) (inside_device hunter d t))
               (and (device_kind d DK_Powerboat) (inside_device hunter d t))
               (and (device_kind d DK_Sailboat) (inside_device hunter d t))
               (and (device_kind d DK_FloatingDevice) (inside_device hunter d t))
               (and (device_kind d DK_VesselOther) (inside_device hunter d t))))
      (not (has_subchapter_authorization hunter t))))