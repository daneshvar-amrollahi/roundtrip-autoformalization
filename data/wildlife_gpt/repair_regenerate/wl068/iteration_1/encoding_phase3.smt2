(forall ((p Person) (f Animal) (t Int))
  (=> (and (possesses p f t)
           (is_kind f AK_Fish)
           (is_named_in_protected_fish_list f))
      (or (exists ((doc Document))
            (and (document_kind doc DOK_OriginVerification)
                 (keeps_with p doc f t)))
          (exists ((officer Person) (t_req Int) (doc2 Document))
            (and (is_peace_officer officer t_req)
                 (<= t_req t)
                 (document_kind doc2 DOK_OriginVerification)
                 (displays_on_request p doc2 t_req))))))