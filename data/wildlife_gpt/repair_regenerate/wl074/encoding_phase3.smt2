(and
  (forall ((p Person) (fin Animal) (t Int))
    (=> (and (possesses p fin t)
             (is_kind fin AK_Fin)
             (is_part_of fin fin))
        (fin_destroyed fin t)))
  (forall ((p Person) (fin Animal) (t Int))
    (=> (is_kind fin AK_Fin)
        (and
          (not (buys p fin t))
          (not (offers_to_buy p fin t))
          (not (sells p fin t))
          (not (offers_to_sell p fin t))
          (not (and (possesses p fin t) (for_sale p fin t)))
          (not (and (transports p fin t) (for_sale p fin t)))
          (not (and (ships p fin t) (for_sale p fin t)))
          (not (advertises_for_sale p fin t))))))
  (forall ((p Person) (t Int))
    (=> (not (has_subchapter_authorization p t))
        (not (participates_in_killing_activity p t)))))