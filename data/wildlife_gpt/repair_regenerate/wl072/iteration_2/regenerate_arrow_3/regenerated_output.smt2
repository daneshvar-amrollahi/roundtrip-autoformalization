(forall ((p Person) (f Animal) (w WaterBody) (t Int))
  (=> (and (possesses p f t)
           (on_water_body p w t)
           (water_kind w WK_CoastalWater)
           (is_kind f AK_Finfish)
           (lawfully_taken f)
           (has_tail_removed f)
           (not (is_kind f AK_Other))
           (not (is_kind f AK_GameFish))
           (not (delivered_to_certified_dealer f t)))
      (and (has_been_finally_processed f t)
           (delivered_to_final_destination f t))))