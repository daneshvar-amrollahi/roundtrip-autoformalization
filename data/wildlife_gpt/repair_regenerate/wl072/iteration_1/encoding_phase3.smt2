(forall ((p Person) (f Animal) (w WaterBody) (t Int))
  (=> (and (possesses p f t)
           (is_kind f AK_Finfish)
           (on_water_body p w t)
           (water_kind w WK_CoastalWater)
           (has_tail_removed f))
      (or (has_been_finally_processed f t)
          (delivered_to_final_destination f t)
          (delivered_to_certified_dealer f t)
          (not (possesses p f t)))))