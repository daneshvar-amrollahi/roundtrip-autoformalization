(forall ((p Person) (a Animal) (t Int))
  (=> (and (captures_by_nonlethal_means p a t)
           (or (is_kind a AK_Reptile) (is_kind a AK_Amphibian))
           (or (on_road_shoulder p t) (on_road_or_right_of_way p t)))
      (or (and (has_document_kind p DOK_ReptileAmphibianStamp t)
               (forall ((d Device) (t2 Int))
                 (=> (and (<= t t2)
                          (captures_by_nonlethal_means p a t2)
                          (or (on_road_shoulder p t2) (on_road_or_right_of_way p t2))
                          (device_kind d DK_CrabTrap))
                     (not (uses_device p d t2)))))
          (and (has_physical_disability p t)
               (carries_proof_of p DOK_ProofOfDisability t)))))