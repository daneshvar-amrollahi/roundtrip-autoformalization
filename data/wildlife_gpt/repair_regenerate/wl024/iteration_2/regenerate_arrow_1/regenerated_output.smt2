(forall ((intruder Person) (land Land) (t Int))
  (=> (and (present_on intruder land t)
           (or (is_public_land land)
               (and (is_private_land land)
                    (forall ((owner Person) (agent Person))
                      (=> (and (is_landowner_of owner land)
                               (is_agent_of agent owner))
                          (and (not (has_consent_of intruder owner t))
                               (not (has_consent_of intruder agent t)))))))
           (exists ((hunter Person))
             (and (distinct intruder hunter)
                  (lawfully_hunting_or_catching hunter t)
                  (intends_to_disrupt intruder hunter t))))
      false))