(forall ((actor Person) (hunter Person) (l Land) (t Int))
  (=> (and (present_on actor l t)
           (distinct actor hunter)
           (intends_to_disrupt actor hunter t)
           (lawfully_hunting_or_catching hunter t))
      (and
        (=> (is_public_land l)
            (not (interferes_with actor hunter t)))
        (=> (is_private_land l)
            (forall ((owner Person))
              (=> (is_landowner_of owner l)
                  (or (has_consent_of actor owner t)
                      (exists ((agent Person))
                        (and (is_agent_of agent owner)
                             (has_consent_of actor agent t)))
                      (not (interferes_with actor hunter t)))))))))