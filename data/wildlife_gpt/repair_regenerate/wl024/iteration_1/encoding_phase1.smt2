(forall ((actor Person) (land Land) (hunter Person) (t Int))
  (=> (and (present_on actor land t)
           (intends_to_disrupt actor hunter t)
           (lawfully_hunting_or_catching hunter t)
           (not (= actor hunter))
           (or (is_public_land land)
               (and (is_private_land land)
                    (forall ((owner Person))
                      (=> (or (is_landowner_of owner land)
                              (and (is_agent_of owner owner)
                                   (is_landowner_of owner land)))
                          (not (has_consent_of actor owner t)))))))
      false))