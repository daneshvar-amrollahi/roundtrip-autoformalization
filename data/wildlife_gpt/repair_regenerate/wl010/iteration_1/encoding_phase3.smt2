(forall ((hunter Person) (game Animal) (laser Device) (assistant Person) (t Int))
  (=> (and (has_physical_disability hunter t)
           (during_lawful_hunting_hours t)
           (during_open_season AK_GameAnimal t)
           (hunts hunter game t)
           (is_kind game AK_GameAnimal)
           (uses_device hunter laser t)
           (device_kind laser DK_LaserSightingDevice)
           (distinct assistant hunter)
           (<= 13 (age_of assistant))
           (not (has_physical_disability assistant t))
           (has_document_kind assistant DOK_HuntingLicense t))
      (assisted_by hunter assistant t)))