(forall ((p Person) (t Int))
  (=> (exists ((k AnimalKind))
        (and (or (= k AK_Fish) (= k AK_GameFish) (= k AK_NongameFish) (= k AK_Finfish))
             (> (count_in_possession p k t) (* 3 (possession_limit k)))))
      (exists ((a Animal))
        (and (possesses p a t)
             (is_named_in_protected_fish_list a)
             (or (is_kind a AK_Fish) (is_kind a AK_GameFish) (is_kind a AK_NongameFish) (is_kind a AK_Finfish))
             (not (has_lawful_documentation p a t))))))