(and
  (forall ((p Person) (w WaterBody) (d Device) (t Int))
    (=> (and (on_water_body p w t)
             (water_kind w WK_PublicWater)
             (or (possesses_device p d t) (uses_device p d t))
             (or (device_kind d DK_Seine)
                 (device_kind d DK_StrikeNet)
                 (device_kind d DK_GillNet)
                 (device_kind d DK_TrammelNet)))
        (and (<= (float_spacing_feet d) 6.0)
             (has_required_buoyancy d))))
  (forall ((p Person) (d Device) (t Int))
    (=> (and (on_navigation_district_water p t)
             (possesses_device p d t)
             (or (device_kind d DK_Seine)
                 (device_kind d DK_StrikeNet)
                 (device_kind d DK_GillNet)
                 (device_kind d DK_TrammelNet))
             (not (is_permitted_by_code d t)))
        (not (possesses_device p d t))))
  (forall ((p Person) (d Device) (a Animal) (t Int))
    (=> (and (on_navigation_district_water p t)
             (possesses_device p d t)
             (or (device_kind d DK_Seine)
                 (device_kind d DK_StrikeNet)
                 (device_kind d DK_GillNet)
                 (device_kind d DK_TrammelNet))
             (not (is_permitted_by_code d t))
             (fishes p a t)
             (or (is_kind a AK_Fish)
                 (is_kind a AK_GameFish)
                 (is_kind a AK_NongameFish)
                 (is_kind a AK_Finfish)
                 (is_kind a AK_Shark)))
        (not (fishes p a t)))))