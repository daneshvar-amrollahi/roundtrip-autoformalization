(forall ((p Person) (fish Animal) (w WaterBody) (t Int))
  (=> (and (leaves_to_die p fish t)
           (takes p fish t)
           (on_water_body p w t)
           (water_kind w WK_PublicWater)
           (or (and (is_kind fish AK_Fish) (is_in_edible_condition fish t))
               (is_kind fish AK_NongameFish)))
      (not (and (has_intent_to_retain p fish t)
                (or (for_sale p fish t) (for_commercial_purpose p fish t))))))