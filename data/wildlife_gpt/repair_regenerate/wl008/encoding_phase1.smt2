(exists ((hunter Person) (assistant Person) (laser Device) (t Int))
  (and (not (= hunter assistant))
       (is_legally_blind hunter t)
       (during_regular_hunting_hours t)
       (uses_device hunter laser t)
       (device_kind laser DK_LaserSightingDevice)
       (assisted_by hunter assistant t)
       (not (is_legally_blind assistant t))
       (has_document_kind assistant DOK_HuntingLicense t)
       (>= (age_of assistant) 13)))