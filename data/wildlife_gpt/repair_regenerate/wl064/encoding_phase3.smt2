(forall ((p Person) (f Animal) (t Int))
  (=> (and (is_kind f AK_Fish)
           (is_named_in_protected_fish_list f))
      (and (not (buys p f t))
           (not (offers_to_buy p f t))
           (not (sells p f t))
           (not (offers_to_sell p f t))
           (not (barters p f t))
           (not (exchanges p f t))
           (not (and (possesses p f t) (for_sale p f t)))
           (not (and (transports p f t) (for_sale p f t)))
           (not (and (ships p f t) (for_sale p f t))))))