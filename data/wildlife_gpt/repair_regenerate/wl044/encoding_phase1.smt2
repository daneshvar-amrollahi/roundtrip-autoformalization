(forall ((actor Person) (a Animal) (w WaterBody) (owner Person) (t Int))
  (=> (and (or (catches actor a t)
               (takes actor a t)
               (attempts_to_catch actor a t))
           (is_kind a AK_AquaticAnimalLife)
           (on_water_body actor w t)
           (water_kind w WK_PrivateWater)
           (is_owner_of_water owner w)
           (not (has_consent_of actor owner t))
           (forall ((agent Person))
             (=> (is_agent_of agent owner)
                 (not (has_consent_of actor agent t)))))
      (and (not (catches actor a t))
           (not (takes actor a t))
           (not (attempts_to_catch actor a t)))))