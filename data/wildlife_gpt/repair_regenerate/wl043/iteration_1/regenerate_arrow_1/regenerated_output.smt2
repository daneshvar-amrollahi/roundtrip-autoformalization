(forall ((seller Person) (buyer Person) (a Animal) (t Int))
  (=> (sells seller a t)
      (or (is_zoo_entity seller)
          (is_zoo_entity buyer)
          (and (or (is_educational_institution buyer)
                   (is_research_institution buyer))
               (for_scientific_purpose buyer t)
               (has_document_kind buyer DOK_Permit t)
               (has_subchapter_authorization buyer t))
          (and (has_document_kind buyer DOK_CommercialFishingLicense t)
               (exists ((resaleBuyer Person) (t2 Int))
                 (and (<= t t2)
                      (sells buyer a t2)
                      (or (is_zoo_entity buyer)
                          (is_zoo_entity resaleBuyer)
                          (and (or (is_educational_institution resaleBuyer)
                                   (is_research_institution resaleBuyer))
                               (for_scientific_purpose resaleBuyer t2)
                               (has_document_kind resaleBuyer DOK_Permit t2)
                               (has_subchapter_authorization resaleBuyer t2)))))))))