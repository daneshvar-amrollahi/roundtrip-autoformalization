(or
  (exists ((seller Person) (buyer Person) (a Animal) (t Int))
    (and (sells seller a t)
         (or (is_zoo_entity seller) (is_zoo_entity buyer))))
  (exists ((seller Person) (buyer Person) (a Animal) (t Int))
    (and (sells seller a t)
         (or (is_educational_institution buyer)
             (is_research_institution buyer))
         (for_scientific_purpose buyer t)
         (has_document_kind buyer DOK_Permit t)))
  (exists ((seller Person) (dealer Person) (a Animal) (t Int))
    (and (sells seller a t)
         (buys dealer a t)
         (for_commercial_purpose dealer a t)
         (exists ((resaleBuyer Person) (t2 Int))
           (and (sells dealer a t2)
                (or (is_zoo_entity dealer) (is_zoo_entity resaleBuyer)
                    (and (or (is_educational_institution resaleBuyer)
                             (is_research_institution resaleBuyer))
                         (for_scientific_purpose resaleBuyer t2)
                         (has_document_kind resaleBuyer DOK_Permit t2)))))))