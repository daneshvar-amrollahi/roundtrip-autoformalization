(forall ((seller Person) (buyer Person) (a Animal) (t Int))
  (=> (and (sells seller a t)
           (buys buyer a t))
      (or (is_zoo_entity seller)
          (is_zoo_entity buyer)
          (and (or (is_educational_institution buyer)
                   (is_research_institution buyer))
               (for_scientific_purpose buyer t)
               (has_document_kind buyer DOK_Permit t))
          (exists ((dealer Person))
            (and (= buyer dealer)
                 (for_commercial_purpose dealer a t)
                 (forall ((laterBuyer Person) (t2 Int))
                   (=> (and (sells dealer a t2)
                            (buys laterBuyer a t2))
                       (or (is_zoo_entity dealer)
                           (is_zoo_entity laterBuyer)
                           (and (or (is_educational_institution laterBuyer)
                                    (is_research_institution laterBuyer))
                                (for_scientific_purpose laterBuyer t2)
                                (has_document_kind laterBuyer DOK_Permit t2))))))))))