(forall ((p Person) (d Device) (wpub WaterBody) (t Int))
  (=> (and (possesses_device p d t)
           (on_water_body p wpub t)
           (water_kind wpub WK_PublicWater)
           (not (is_permitted_by_code d t))
           (not
             (or
               (exists ((wcoast WaterBody) (fd Device))
                 (and (inside_device p fd t)
                      (device_kind fd DK_FloatingDevice)
                      (on_water_body p wcoast t)
                      (water_kind wcoast WK_CoastalWater)
                      (delivered_to_final_destination d t)))
               (exists ((wcanal WaterBody) (wcoast2 WaterBody))
                 (and (on_canal_or_artificial_waterway p wcanal t)
                      (on_water_body p wcoast2 t)
                      (water_kind wcoast2 WK_CoastalWater)
                      (or (leaves_water_body p wcoast2 t)
                          (leaves_water_body p wpub t)))))))
      (not (possesses_device p d t))))