(forall ((p Person) (d Device) (w_pub WaterBody) (t Int))
  (=> (and (possesses_device p d t)
           (on_water_body p w_pub t)
           (water_kind w_pub WK_PublicWater)
           (not (is_permitted_by_code d t))
           (exists ((w_perm WaterBody))
             (and (water_kind w_perm WK_PublicWater)
                  (is_permitted_by_code d t))))
      (forall ((v Device) (w_coast WaterBody))
        (=> (and (inside_device p v t)
                 (device_kind v DK_VesselOther)
                 (on_water_body p w_coast t)
                 (water_kind w_coast WK_CoastalWater))
            false))))