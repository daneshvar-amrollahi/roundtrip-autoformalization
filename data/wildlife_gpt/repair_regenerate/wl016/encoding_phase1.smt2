(forall ((hunter Person) (a Animal) (t Int))
  (=> (and (hunts hunter a t)
           (or (is_kind a AK_GameBird) (is_kind a AK_GameAnimal))
           (or (kills hunter a t) (wounds hunter a t))
           (or (acts_intentionally hunter t) (acts_knowingly hunter t)))
      (forall ((t2 Int))
        (=> (and (<= t t2)
                 (not (retrieves hunter a t2)))
            (makes_reasonable_effort_to_retrieve hunter a t2)))))