(forall ((doc Document) (owner Person) (grantee Person) (l Land) (t Int))
  (=> (is_valid_consent doc owner grantee t)
      (and (document_kind doc DOK_WrittenConsent)
           (names_grantee doc grantee)
           (identifies_land doc l)
           (or (signed_by doc owner)
               (exists ((signer Person))
                 (and (signed_by doc signer)
                      (or (is_agent_of signer owner)
                          (is_employee_of signer owner))))
           (exists ((signer2 Person))
             (and (signed_by doc signer2)
                  (shows_address_and_phone_of doc signer2))))))