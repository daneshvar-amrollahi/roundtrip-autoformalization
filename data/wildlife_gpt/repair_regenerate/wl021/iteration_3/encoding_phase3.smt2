(forall ((doc Document) (owner Person) (grantee Person) (l Land) (t Int))
  (=> (and (is_valid_consent doc owner grantee t)
           (identifies_land doc l))
      (and (document_kind doc DOK_WrittenConsent)
           (names_grantee doc grantee)
           (identifies_land doc l)
           (or (signed_by doc owner)
               (exists ((s Person))
                 (and (signed_by doc s)
                      (or (is_agent_of s owner)
                          (is_employee_of s owner)))))
           (exists ((s2 Person))
             (and (signed_by doc s2)
                  (shows_address_and_phone_of doc s2))))))