(forall ((grantee Person) (owner Person) (l Land) (t Int))
  (=> (and (is_landowner_of owner l)
           (has_written_consent grantee owner t))
      (exists ((doc Document) (signer Person))
        (and (document_kind doc DOK_WrittenConsent)
             (is_valid_consent doc signer grantee t)
             (names_grantee doc grantee)
             (identifies_land doc l)
             (signed_by doc signer)
             (shows_address_and_phone_of doc signer)
             (or (= signer owner)
                 (is_agent_of signer owner))))))