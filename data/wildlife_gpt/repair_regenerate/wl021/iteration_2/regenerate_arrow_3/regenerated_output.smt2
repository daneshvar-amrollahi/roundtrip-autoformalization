(forall ((p Person) (owner Person) (l Land) (t Int))
  (=> (and (has_written_consent p owner t)
           (is_landowner_of owner l))
      (exists ((doc Document) (signer Person))
        (and (has_document p doc t)
             (document_kind doc DOK_WrittenConsent)
             (is_valid_consent doc owner p t)
             (names_grantee doc p)
             (identifies_land doc l)
             (signed_by doc signer)
             (or (= signer owner) (is_agent_of signer owner))
             (shows_address_and_phone_of doc signer)))))