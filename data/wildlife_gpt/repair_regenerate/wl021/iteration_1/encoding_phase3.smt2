(forall ((grantee Person) (owner Person) (doc Document) (l Land) (t Int))
  (=> (and (has_written_consent grantee owner t)
           (is_valid_consent doc owner grantee t)
           (is_landowner_of owner l))
      (and (names_grantee doc grantee)
           (identifies_land doc l)
           (or (signed_by doc owner)
               (exists ((agent Person))
                 (and (is_agent_of agent owner)
                      (signed_by doc agent))))
           (exists ((signer Person))
             (and (signed_by doc signer)
                  (shows_address_and_phone_of doc signer))))))