(forall ((hunter Person) (a Animal) (t Int))
  (=> (and (hunts hunter a t)
           (or (is_kind a AK_WildBird)
               (is_kind a AK_WildGameAnimal)
               (is_kind a AK_WildGameBird)
               (is_kind a AK_WildFowl)
               (and (is_kind a AK_NongameAnimal)
                    (not (is_kind a AK_Alligator))
                    (not (is_kind a AK_Frog))
                    (not (is_kind a AK_Turtle))))
           (exists ((veh Device))
             (and (inside_device hunter veh t)
                  (or (device_kind veh DK_Aircraft)
                      (device_kind veh DK_AirborneDevice)
                      (device_kind veh DK_MotorVehicle)
                      (device_kind veh DK_Powerboat)
                      (device_kind veh DK_Sailboat)
                      (device_kind veh DK_FloatingDevice)))))
      (has_subchapter_authorization hunter t)))