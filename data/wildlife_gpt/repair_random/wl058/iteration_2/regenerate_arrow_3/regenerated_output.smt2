(forall ((p Person) (f Animal) (w WaterBody) (t Int))
  (=> (and (takes p f t)
           (is_kind f AK_Fish)
           (on_water_body p w t)
           (leaves_to_die p f t)
           (or (is_kind f AK_Finfish)
               (water_kind w WK_PublicWater)))
      (not (and (has_intent_to_retain p f t)
                (or (for_home_destination p f t)
                    (is_in_edible_condition f t))))))