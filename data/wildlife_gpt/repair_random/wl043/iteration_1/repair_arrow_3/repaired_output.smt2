(forall ((seller Person) (a Animal) (t Int))
  (=> (sells seller a t)
      (or
        (exists ((buyer Person))
          (and (buys buyer a t)
               (or (is_zoo_entity buyer)
                   (and (or (is_educational_institution buyer)
                            (is_research_institution buyer))
                        (for_scientific_purpose buyer t)
                        (has_document_kind buyer DOK_Permit t)))))
        (is_zoo_entity seller)
        (and (or (is_educational_institution seller)
                 (is_research_institution seller))
             (for_scientific_purpose seller t)
             (has_document_kind seller DOK_Permit t))
        (exists ((middle Person))
          (and (distinct middle seller)
               (buys middle a t)
               (sells middle a t)
               (or (is_zoo_entity middle)
                   (exists ((endbuyer Person))
                     (and (distinct endbuyer middle)
                          (buys endbuyer a t)
                          (or (is_educational_institution endbuyer)
                              (is_research_institution endbuyer))
                          (for_scientific_purpose endbuyer t)
                          (has_document_kind endbuyer DOK_Permit t)))))))))