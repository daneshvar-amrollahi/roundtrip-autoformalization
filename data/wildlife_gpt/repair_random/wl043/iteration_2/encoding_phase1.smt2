(forall ((seller Person) (buyer Person) (a Animal) (t Int))
  (=> (sells seller a t)
      (or (is_zoo_entity seller)
          (is_zoo_entity buyer)
          (and (is_educational_institution buyer)
               (for_scientific_purpose buyer t)
               (has_document_kind buyer DOK_Permit t))
          (and (is_research_institution buyer)
               (for_scientific_purpose buyer t)
               (has_document_kind buyer DOK_Permit t))
          (exists ((dealer Person))
            (and (is_employee_of dealer buyer)
                 (sells buyer a t)
                 (or (is_zoo_entity dealer)
                     (is_zoo_entity buyer)
                     (and (is_educational_institution dealer)
                          (for_scientific_purpose dealer t)
                          (has_document_kind dealer DOK_Permit t))
                     (and (is_research_institution dealer)
                          (for_scientific_purpose dealer t)
                          (has_document_kind dealer DOK_Permit t))))))))