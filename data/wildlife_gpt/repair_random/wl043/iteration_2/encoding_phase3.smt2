(forall ((seller Person) (a Animal) (t Int))
  (=> (sells seller a t)
      (or (is_zoo_entity seller)
          (exists ((buyer Person))
            (and (buys buyer a t)
                 (or (is_zoo_entity buyer)
                     (and (or (is_educational_institution buyer)
                              (is_research_institution buyer))
                          (for_scientific_purpose buyer t)
                          (has_document_kind buyer DOK_Permit t))
                     (exists ((emp Person))
                       (and (is_employee_of emp buyer)
                            (sells emp a t)
                            (or (is_zoo_entity emp)
                                (is_zoo_entity buyer)
                                (and (or (is_educational_institution emp)
                                         (is_research_institution emp))
                                     (for_scientific_purpose emp t)
                                     (has_document_kind emp DOK_Permit t))
                                (and (or (is_educational_institution buyer)
                                         (is_research_institution buyer))
                                     (for_scientific_purpose buyer t)
                                     (has_document_kind buyer DOK_Permit t))))))))))