(forall ((p Person) (bat Animal) (part Animal) (t Int))
  (=> (and (is_kind bat AK_Bat)
           (not (has_subchapter_authorization p t)))
      (and (not (hunts p bat t))
           (not (sells p bat t))
           (not (offers_to_sell p bat t))
           (not (buys p bat t))
           (not (offers_to_buy p bat t))
           (not (possesses_after_purchase p bat t))
           (=> (is_part_of part bat)
               (and (not (sells p part t))
                    (not (offers_to_sell p part t))
                    (not (buys p part t))
                    (not (offers_to_buy p part t))
                    (not (possesses_after_purchase p part t)))))))