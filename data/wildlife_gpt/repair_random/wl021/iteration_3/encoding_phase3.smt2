(forall ((doc Document) (owner Person) (agent Person) (grantee Person) (l Land) (t Int))
  (=> (and (document_kind doc DOK_WrittenConsent)
           (or (is_valid_consent doc owner grantee t)
               (and (is_agent_of agent owner)
                    (is_valid_consent doc agent grantee t)))
           (is_landowner_of owner l)
           (identifies_land doc l))
      (and (names_grantee doc grantee)
           (identifies_land doc l)
           (or (signed_by doc owner)
               (and (is_agent_of agent owner)
                    (signed_by doc agent)))
           (or (shows_address_and_phone_of doc owner)
               (and (is_agent_of agent owner)
                    (shows_address_and_phone_of doc agent))))))