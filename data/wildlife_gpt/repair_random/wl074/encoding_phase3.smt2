(and
  (forall ((p Person) (fin Animal) (t Int))
    (=> (and (possesses p fin t)
             (is_kind fin AK_Fin)
             (is_part_of fin fin))
        (fin_destroyed fin t)))
  (forall ((p Person) (fin Animal) (t Int))
    (=> (and (is_kind fin AK_Fin)
             (for_sale p fin t))
        (and (not (buys p fin t))
             (not (offers_to_buy p fin t))
             (not (sells p fin t))
             (not (offers_to_sell p fin t))
             (not (advertises_for_sale p fin t))
             (not (possesses p fin t))
             (not (transports p fin t))
             (not (ships p fin t))))))