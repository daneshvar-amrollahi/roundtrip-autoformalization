(forall ((p Person) (fish Animal) (w WaterBody) (t Int))
  (=> (and (on_canal_or_artificial_waterway p w t)
           (in_designated_waterway_county t)
           (population_at_least 2 t)
           (is_kind fish AK_Fish)
           (or (takes p fish t)
               (attempts_to_catch p fish t)))
      (forall ((d Device))
        (=> (uses_device p d t)
            (and (not (device_kind d DK_Seine))
                 (not (device_kind d DK_StrikeNet))
                 (not (device_kind d DK_GillNet))
                 (not (device_kind d DK_TrammelNet))
                 (device_kind d DK_HandsOnly))))))