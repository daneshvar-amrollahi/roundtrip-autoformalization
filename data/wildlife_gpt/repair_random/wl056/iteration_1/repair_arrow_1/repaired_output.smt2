(forall ((angler Person) (fish Animal) (w WaterBody) (t Int))
  (=> (and (or (takes angler fish t) (attempts_to_catch angler fish t))
           (is_kind fish AK_Fish)
           (on_canal_or_artificial_waterway angler w t)
           (in_designated_waterway_county t)
           (not (exists ((net Device))
                  (and (uses_device angler net t)
                       (or (device_kind net DK_Seine)
                           (device_kind net DK_StrikeNet)
                           (device_kind net DK_GillNet)
                           (device_kind net DK_TrammelNet)
                           (device_kind net DK_OtherFishingDevice))
                       (or (device_kind net DK_HandsOnly)
                           (device_kind net DK_Seine))))))
      (not (or (takes angler fish t) (attempts_to_catch angler fish t)))))