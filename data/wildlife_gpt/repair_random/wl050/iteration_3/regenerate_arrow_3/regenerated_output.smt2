(forall ((p Person) (dev Device) (w WaterBody) (t Int))
  (=> (and (possesses_device p dev t)
           (on_water_body p w t)
           (water_kind w WK_PublicCoastalWater)
           (exists ((v Device))
             (and (inside_device p v t)
                  (or (device_kind v DK_FloatingDevice)
                      (device_kind v DK_Powerboat)
                      (device_kind v DK_Sailboat)
                      (device_kind v DK_VesselOther))
                  (on_device dev v t)))
      (or (is_permitted_by_code dev t)
          (not (on_device dev (let ((v Device)) v) t)))))