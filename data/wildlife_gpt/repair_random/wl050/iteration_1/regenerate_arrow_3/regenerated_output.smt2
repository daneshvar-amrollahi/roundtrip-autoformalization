(forall ((p Person) (d Device) (w WaterBody) (t Int))
  (=> (and (possesses_device p d t)
           (on_water_body p w t)
           (water_kind w WK_PublicWater)
           (not (is_permitted_by_code d t)))
      (exists ((fd Device) (cw WaterBody) (pw WaterBody))
        (and (inside_device p fd t)
             (device_kind fd DK_FloatingDevice)
             (on_water_body p cw t)
             (water_kind cw WK_CoastalWater)
             (water_kind pw WK_PublicWater)
             (or (in_port fd t)
                 (and (in_marked_channel fd t)
                      (going_directly_to_or_from_permitted_public_water p fd d pw t)))))))