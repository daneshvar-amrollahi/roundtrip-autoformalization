(exists ((hunter Person) (assistant Person) (laser Device) (a Animal) (t Int))
  (and (has_physical_disability hunter t)
       (not (= hunter assistant))
       (uses_device hunter laser t)
       (device_kind laser DK_LaserSightingDevice)
       (during_lawful_hunting_hours t)
       (or (and (is_kind a AK_WildBird) (during_open_season AK_WildBird t))
           (and (is_kind a AK_WildGameBird) (during_open_season AK_WildGameBird t))
           (and (is_kind a AK_WildFowl) (during_open_season AK_WildFowl t))
           (and (is_kind a AK_WildGameAnimal) (during_open_season AK_WildGameAnimal t))
           (and (is_kind a AK_GameAnimal) (during_open_season AK_GameAnimal t))
           (and (is_kind a AK_GameBird) (during_open_season AK_GameBird t))
           (and (is_kind a AK_NongameAnimal) (during_open_season AK_NongameAnimal t))
           (and (is_kind a AK_Reptile) (during_open_season AK_Reptile t))
           (and (is_kind a AK_Amphibian) (during_open_season AK_Amphibian t))
           (and (is_kind a AK_Fish) (during_open_season AK_Fish t))
           (and (is_kind a AK_GameFish) (during_open_season AK_GameFish t))
           (and (is_kind a AK_NongameFish) (during_open_season AK_NongameFish t))
           (and (is_kind a AK_Finfish) (during_open_season AK_Finfish t))
           (and (is_kind a AK_Shark) (during_open_season AK_Shark t))
           (and (is_kind a AK_Crab) (during_open_season AK_Crab t))
           (and (is_kind a AK_Shellfish) (during_open_season AK_Shellfish t))
           (and (is_kind a AK_AquaticAnimalLife) (during_open_season AK_AquaticAnimalLife t))
           (and (is_kind a AK_AquaticPlant) (during_open_season AK_AquaticPlant t))
           (and (is_kind a AK_Seagrass) (during_open_season AK_Seagrass t))
           (and (is_kind a AK_Bat) (during_open_season AK_Bat t))
           (and (is_kind a AK_Wolf) (during_open_season AK_Wolf t))
           (and (is_kind a AK_Armadillo) (during_open_season AK_Armadillo t))
           (and (is_kind a AK_DangerousWildAnimal) (during_open_season AK_DangerousWildAnimal t))
           (and (is_kind a AK_Deer) (during_open_season AK_Deer t))
           (and (is_kind a AK_MuleDeer) (during_open_season AK_MuleDeer t))
           (and (is_kind a AK_WhiteTailedDeer) (during_open_season AK_WhiteTailedDeer t))
           (and (is_kind a AK_DesertBighornSheep) (during_open_season AK_DesertBighornSheep t))
           (and (is_kind a AK_PronghornAntelope) (during_open_season AK_PronghornAntelope t))
           (and (is_kind a AK_Alligator) (during_open_season AK_Alligator t))
           (and (is_kind a AK_Frog) (during_open_season AK_Frog t))
           (and (is_kind a AK_Turtle) (during_open_season AK_Turtle t))
           (and (is_kind a AK_ExoticAnimal) (during_open_season AK_ExoticAnimal t))
           (and (is_kind a AK_ExoticLivestock) (during_open_season AK_ExoticLivestock t))
           (and (is_kind a AK_ExoticFowl) (during_open_season AK_ExoticFowl t))
           (and (is_kind a AK_Other) (during_open_season AK_Other t)))
       (assisted_by hunter assistant t)
       (not (has_physical_disability assistant t))
       (has_document_kind assistant DOK_HuntingLicense t)
       (>= (age_of assistant) 13)
       (hunts hunter a t)))