(forall ((angler Person) (fish Animal) (w WaterBody) (d Device) (t Int))
  (=> (and (catches angler fish t)
           (is_kind fish AK_Fish)
           (on_water_body angler w t)
           (water_kind w WK_NavigationDistrictWater)
           (uses_device angler d t)
           (or (device_kind d DK_Seine)
               (device_kind d DK_StrikeNet)
               (device_kind d DK_GillNet)
               (device_kind d DK_TrammelNet)
               (device_kind d DK_Trotline)
               (and (device_kind d DK_OtherFishingDevice)
                    (not (device_kind d DK_HookAndLine)))))
      (not (catches angler fish t))))