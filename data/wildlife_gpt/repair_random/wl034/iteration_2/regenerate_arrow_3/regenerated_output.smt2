(forall ((p Person) (a Animal) (t Int))
  (=> (and (possesses p a t)
           (in_cold_storage a t)
           (or (and (is_kind a AK_GameBird) (lawfully_killed a))
               (and (is_kind a AK_GameAnimal) (lawfully_killed a))))
      (and (=> (is_kind a AK_GameBird)
               (<= (count_in_possession p AK_GameBird t) (possession_limit AK_GameBird)))
           (=> (is_kind a AK_GameAnimal)
               (<= (count_in_possession p AK_GameAnimal t) (possession_limit AK_GameAnimal))))))