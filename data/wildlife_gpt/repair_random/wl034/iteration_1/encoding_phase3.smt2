(forall ((p Person) (a Animal) (k AnimalKind) (t Int))
  (=> (and (possesses p a t)
           (lawfully_killed a)
           (or (is_kind a AK_GameBird) (is_kind a AK_GameAnimal))
           (or (and (is_kind a AK_GameBird) (= k AK_GameBird))
               (and (is_kind a AK_GameAnimal) (= k AK_GameAnimal)))
           (or (in_cold_storage a t)
               (has_been_finally_processed a t)))
      (<= (count_in_possession p k t) (possession_limit k))))