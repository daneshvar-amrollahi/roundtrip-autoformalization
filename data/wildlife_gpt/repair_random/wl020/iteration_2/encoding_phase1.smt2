(forall ((actor Person) (a Animal) (l Land) (owner Person) (d Device) (t Int))
  (=> (and (possesses_device actor d t)
           (device_kind d DK_Firearm)
           (present_on actor l t)
           (is_landowner_of owner l)
           (not (= actor owner))
           (or (and (hunts actor a t)
                    (or (is_kind a AK_WildGameAnimal)
                        (is_kind a AK_WildBird)))
               (engages_in_target_shooting actor t)))
      (has_written_consent actor owner t)))