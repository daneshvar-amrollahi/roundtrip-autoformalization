(forall ((p Person) (d Device) (wpub WaterBody) (wcoast WaterBody) (v Device) (t Int))
  (=> (and (possesses_device p d t)
           (on_water_body p wpub t)
           (water_kind wpub WK_PublicWater)
           (on_device d v t)
           (inside_device p v t)
           (on_water_body p wcoast t)
           (water_kind wcoast WK_CoastalWater)
           (water_kind wcoast WK_PublicWater)
           (not (is_permitted_by_code d t))
           (not (authorized_by_commission p t)))
      (not true)))