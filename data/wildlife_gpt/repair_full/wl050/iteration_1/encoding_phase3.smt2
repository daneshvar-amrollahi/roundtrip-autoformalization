(forall ((p Person) (d Device) (w WaterBody) (t Int))
  (=> (and (possesses_device p d t)
           (on_water_body p w t)
           (water_kind w WK_PublicWater)
           (not (is_permitted_by_code d t)))
      (or (exists ((v Device))
            (and (on_device d v t)
                 (not (device_kind v DK_Powerboat))
                 (not (device_kind v DK_Sailboat))
                 (on_water_body p w t)
                 (water_kind w WK_CoastalWater)
                 (or (in_port v t)
                     (in_marked_channel v t))
                 (going_directly_to_or_from_permitted_public_water_with_device p v d t)))
          (not (possesses_device p d t)))))