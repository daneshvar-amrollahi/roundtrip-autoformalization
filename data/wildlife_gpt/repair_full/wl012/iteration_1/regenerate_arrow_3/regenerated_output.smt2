(forall ((employer Person) (hunter Person) (a Animal) (t Int))
  (=> (and (distinct employer hunter)
           (or (employs_to_hunt employer hunter t)
               (is_employed_to_hunt hunter employer t))
           (for_compensation employer hunter t)
           (hunts hunter a t)
           (protected_by_code a)
           (or (is_kind a AK_WildBird)
               (is_kind a AK_WildFowl)
               (is_kind a AK_GameAnimal)))
      false))