(forall ((employer Person) (worker Person) (a Animal) (t Int))
  (=> (and (not (= employer worker))
           (or (employs_to_hunt employer worker t)
               (is_employed_to_hunt worker employer t))
           (or (for_compensation employer worker t)
               (for_compensation worker employer t))
           (protected_by_code a)
           (or (is_kind a AK_WildBird)
               (is_kind a AK_WildFowl)
               (is_kind a AK_GameAnimal)))
      false))