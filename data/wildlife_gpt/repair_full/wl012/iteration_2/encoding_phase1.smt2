(forall ((p1 Person) (p2 Person) (a Animal) (t Int))
  (=> (and (distinct p1 p2)
           (or (and (employs_to_hunt p1 p2 t) (for_compensation p1 p2 t))
               (and (is_employed_to_hunt p1 p2 t) (for_compensation p2 p1 t)))
           (hunts p2 a t)
           (protected_by_code a)
           (or (is_kind a AK_WildBird)
               (is_kind a AK_WildFowl)
               (is_kind a AK_WildGameAnimal)))
      false))