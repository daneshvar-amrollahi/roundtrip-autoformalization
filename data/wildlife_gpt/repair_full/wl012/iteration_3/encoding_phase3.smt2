(and
  (forall ((employer Person) (hunter Person) (a Animal) (t Int))
    (=> (and (employs_to_hunt employer hunter t)
             (distinct employer hunter)
             (for_compensation employer hunter t)
             (hunts hunter a t)
             (or (is_kind a AK_WildBird)
                 (is_kind a AK_WildFowl)
                 (is_kind a AK_WildGameAnimal)
                 (is_kind a AK_GameAnimal))
             (protected_by_code a))
        (not (employs_to_hunt employer hunter t))))
  (forall ((hunter Person) (employer Person) (a Animal) (t Int))
    (=> (and (is_employed_to_hunt hunter employer t)
             (distinct hunter employer)
             (for_compensation employer hunter t)
             (hunts hunter a t)
             (or (is_kind a AK_WildBird)
                 (is_kind a AK_WildFowl)
                 (is_kind a AK_WildGameAnimal)
                 (is_kind a AK_GameAnimal))
             (protected_by_code a))
        (not (is_employed_to_hunt hunter employer t)))))