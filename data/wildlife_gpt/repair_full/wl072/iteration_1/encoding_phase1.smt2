(forall ((p Person) (fish Animal) (w WaterBody) (t Int))
  (=> (and (possesses p fish t)
           (is_kind fish AK_Finfish)
           (on_water_body p w t)
           (water_kind w WK_CoastalWater)
           (has_tail_removed fish)
           (not (is_kind fish AK_BroadbillSwordfish))
           (not (is_kind fish AK_KingMackerel))
           (not (and (has_been_finally_processed fish t)
                     (or (delivered_to_final_destination fish t)
                         (delivered_to_certified_dealer fish t)))))
      (not (possesses p fish t))))