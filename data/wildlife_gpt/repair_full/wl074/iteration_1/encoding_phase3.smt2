(and
  (forall ((p Person) (fin Animal) (t Int))
    (=> (and (possesses p fin t)
             (is_kind fin AK_Fin))
        (fin_destroyed fin t)))
  (forall ((p Person) (fin Animal) (t Int))
    (=> (and (is_kind fin AK_Fin)
             (for_sale p fin t)
             (or (buys p fin t)
                 (offers_to_buy p fin t)
                 (sells p fin t)
                 (offers_to_sell p fin t)
                 (advertises_for_sale p fin t)
                 (possesses p fin t)
                 (transports p fin t)
                 (ships p fin t)))
        false))
  (forall ((p Person) (a Animal) (t Int))
    (=> (or (hunts p a t)
            (fishes p a t))
        (has_subchapter_authorization p t))))