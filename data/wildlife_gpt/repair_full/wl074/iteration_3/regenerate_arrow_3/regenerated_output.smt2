(and
  (forall ((p Person) (fin Animal) (t_take Int) (t_poss Int))
    (=> (and (is_kind fin AK_Fin)
             (takes p fin t_take)
             (possesses p fin t_poss)
             (<= t_take t_poss))
        (forall ((t2 Int))
          (=> (and (<= t_take t2) (<= t2 t_poss))
              (and (fin_destroyed fin t2)
                   (lawfully_disposes_of p fin t2))))))
  (forall ((p Person) (fin Animal) (t Int))
    (=> (and (is_kind fin AK_Fin)
             (buys p fin t))
        false))
  (forall ((p Person) (fin Animal) (t Int))
    (=> (and (is_kind fin AK_Fin)
             (offers_to_buy p fin t))
        false))
  (forall ((p Person) (fin Animal) (t Int))
    (=> (and (is_kind fin AK_Fin)
             (sells p fin t))
        false))
  (forall ((p Person) (fin Animal) (t Int))
    (=> (and (is_kind fin AK_Fin)
             (offers_to_sell p fin t))
        false))
  (forall ((p Person) (fin Animal) (t Int))
    (=> (and (is_kind fin AK_Fin)
             (advertises_for_sale p fin t))
        false))
  (forall ((p Person) (fin Animal) (t Int))
    (=> (and (is_kind fin AK_Fin)
             (possesses p fin t)
             (for_sale p fin t))
        false))
  (forall ((p Person) (fin Animal) (t Int))
    (=> (and (is_kind fin AK_Fin)
             (transports p fin t)
             (for_sale p fin t))
        false))
  (forall ((p Person) (fin Animal) (t Int))
    (=> (and (is_kind fin AK_Fin)
             (ships p fin t)
             (for_sale p fin t))
        false)))