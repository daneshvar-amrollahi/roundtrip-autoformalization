(or
  (exists ((p Person) (fin Animal) (t Int))
    (and (is_kind fin AK_Fin)
         (possesses p fin t)
         (exists ((t0 Int))
           (and (<= t0 t)
                (takes p fin t0)
                (forall ((t1 Int))
                  (=> (and (<= t0 t1) (< t1 t))
                      (and (not (fin_destroyed fin t1))
                           (not (lawfully_disposes_of p fin t1)))))
                (and (not (fin_destroyed fin t))
                     (not (lawfully_disposes_of p fin t)))))))
  (exists ((p Person) (fin Animal) (t Int))
    (and (is_kind fin AK_Fin)
         (or (buys p fin t)
             (offers_to_buy p fin t)
             (sells p fin t)
             (offers_to_sell p fin t)
             (and (possesses p fin t) (for_sale p fin t))
             (and (or (transports p fin t) (ships p fin t)) (for_sale p fin t))
             (advertises_for_sale p fin t))))
  (exists ((p Person) (fin Animal) (t Int))
    (and (is_kind fin AK_Fin)
         (and (not (buys p fin t))
              (not (offers_to_buy p fin t))
              (not (sells p fin t))
              (not (offers_to_sell p fin t))
              (not (and (possesses p fin t) (for_sale p fin t)))
              (not (and (or (transports p fin t) (ships p fin t)) (for_sale p fin t)))
              (not (advertises_for_sale p fin t)))
         (exists ((t0 Int))
           (and (<= t0 t)
                (takes p fin t0)
                (forall ((t1 Int))
                  (=> (and (<= t0 t1) (< t1 t))
                      (and (not (fin_destroyed fin t1))
                           (not (lawfully_disposes_of p fin t1)))))
                (or (not (fin_destroyed fin t))
                    (not (lawfully_disposes_of p fin t)))))))
  (exists ((p Person) (a Animal) (t Int))
    (and (is_kind a AK_Other)
         (and (not (is_kind a AK_Fin))
              (not (is_kind a AK_Shark)))
         (takes p a t))) )