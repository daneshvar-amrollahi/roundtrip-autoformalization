(forall ((p Person) (fish Animal) (w WaterBody) (d Device) (b1 Building) (b2 Building) (t Int))
  (=> (and (or (takes p fish t) (attempts_to_catch p fish t))
           (is_kind fish AK_Fish)
           (on_canal_or_artificial_waterway p w t)
           (uses_device p d t)
           (or (device_kind d DK_StrikeNet)
               (device_kind d DK_GillNet)
               (device_kind d DK_TrammelNet)
               (device_kind d DK_OtherFishingDevice))
           (inside_or_on_building fish b1 t)
           (inside_or_on_building fish b2 t)
           (not (= b1 b2))
           (occupied_by_people b1 t)
           (occupied_by_people b2 t))
      false)))