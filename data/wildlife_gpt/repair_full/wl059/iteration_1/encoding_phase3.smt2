(forall ((p Person) (w WaterBody) (t Int))
  (=> (and (on_water_body p w t)
           (water_kind w WK_PublicFreshWater)
           (has_document_kind p DOK_FishingLicense t)
           (has_document_kind p DOK_FreshwaterFishingStamp t))
      (forall ((a Animal))
        (=> (handfishes p a t)
            (exists ((lic Document) (stamp Document))
              (and (has_document p lic t)
                   (document_kind lic DOK_FishingLicense)
                   (names_grantee lic p)
                   (has_document p stamp t)
                   (document_kind stamp DOK_FreshwaterFishingStamp)
                   (names_grantee stamp p)))))))