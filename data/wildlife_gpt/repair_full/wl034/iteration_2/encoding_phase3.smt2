(forall ((p Person) (a Animal) (t Int))
  (=> (and (possesses p a t)
           (or (is_kind a AK_GameBird) (is_kind a AK_GameAnimal))
           (lawfully_killed a)
           (<= (+ (count_in_possession p AK_GameBird t)
                  (count_in_possession p AK_GameAnimal t))
               (+ (possession_limit AK_GameBird)
                  (possession_limit AK_GameAnimal))))
      (or (places_in_cold_storage p a t)
          (forall ((t2 Int))
            (=> (and (<= t t2)
                     (in_cold_storage a t2))
                (possesses p a t2))))))