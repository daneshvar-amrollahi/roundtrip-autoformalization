(forall ((p Person) (f Animal) (t Int))
  (=> (and (possesses p f t)
           (is_kind f AK_Fish)
           (protected_by_code f)
           (is_named_in_protected_fish_list f))
      (or
        (forall ((doc Document))
          (=> (document_kind doc DOK_OriginVerification)
              (not (keeps_with p doc f t))))
        (forall ((warden Person))
          (=> (is_peace_officer warden t)
              (forall ((doc Document))
                (=> (document_kind doc DOK_OriginVerification)
                    (not (displays_on_request p doc t)))))))))