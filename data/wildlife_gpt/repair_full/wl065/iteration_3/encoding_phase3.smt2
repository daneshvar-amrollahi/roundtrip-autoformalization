(forall ((p Person) (fish Animal) (t Int))
  (=> (and (is_kind fish AK_Fish)
           (is_named_in_protected_fish_list fish)
           (or (receives_from_other_state p fish t)
               (imports_to_state p fish t)
               (transports p fish t)
               (sells p fish t))
           (not (has_document_kind p DOK_FinfishImportLicense t)))
      (not (has_subchapter_authorization p t))))