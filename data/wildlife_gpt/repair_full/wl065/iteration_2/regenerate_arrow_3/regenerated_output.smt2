(forall ((p Person) (a Animal) (t Int))
  (=> (and (or (receives_from_other_state p a t)
               (imports_to_state p a t)
               (transports p a t)
               (sells p a t))
           (or (is_named_in_protected_fish_list a)
               (exists ((part Animal))
                 (and (is_part_of part a)
                      (is_named_in_protected_fish_list part)))))
      (has_document_kind p DOK_FinfishImportLicense t)))