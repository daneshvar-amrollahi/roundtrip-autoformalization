(forall ((p Person) (l Land) (owner Person) (d Device) (a Animal) (t Int))
  (=> (and (uses_device p d t)
           (device_kind d DK_Firearm)
           (present_on p l t)
           (is_landowner_of owner l)
           (not (= p owner))
           (not (has_written_consent p owner t))
           (or (and (hunts p a t)
                    (or (is_kind a AK_WildGameAnimal)
                        (is_kind a AK_WildGameBird)
                        (is_kind a AK_WildFowl)
                        (is_kind a AK_WildBird)))
               (engages_in_target_shooting p t)))
      (and (not (hunts p a t))
           (not (engages_in_target_shooting p t)))))