(forall ((shooter Person) (owner Person) (l Land) (a Animal) (d Device) (t Int))
  (=> (and (distinct shooter owner)
           (present_on shooter l t)
           (is_landowner_of owner l)
           (not (has_written_consent shooter owner t))
           (uses_device shooter d t)
           (device_kind d DK_Firearm)
           (or (and (hunts shooter a t)
                    (or (is_kind a AK_WildGameAnimal)
                        (is_kind a AK_WildGameBird)
                        (is_kind a AK_WildFowl)
                        (is_kind a AK_WildBird)))
               (engages_in_target_shooting shooter t)))
      (and (not (hunts shooter a t))
           (not (engages_in_target_shooting shooter t)))))