(forall ((p Person) (a Animal) (t Int))
  (=> (and (or (imports_to_state p a t)
               (possesses p a t)
               (sells p a t)
               (places_in_public_water p a t))
           (or (is_kind a AK_Fish)
               (is_kind a AK_Shellfish))
           (is_exotic_harmful a)
           (not (has_introduction_permit p t))
           (not (has_subchapter_authorization p t))
           (not (authorized_by_commission p t)))
      (and (not (imports_to_state p a t))
           (not (possesses p a t))
           (not (sells p a t))
           (not (places_in_public_water p a t)))))