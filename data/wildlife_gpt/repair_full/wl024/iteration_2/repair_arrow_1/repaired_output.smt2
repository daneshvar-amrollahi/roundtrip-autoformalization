(forall ((p Person) (other Person) (l Land) (t Int))
  (=> (and (distinct p other)
           (intends_to_disrupt p other t)
           (lawfully_hunting_or_catching other t)
           (present_on p l t)
           (or (is_public_land l)
               (and (is_private_land l)
                    (exists ((owner Person))
                      (and (is_landowner_of owner l)
                           (not (or (has_consent_of p owner t)
                                    (exists ((agent Person))
                                      (and (is_agent_of agent owner)
                                           (has_consent_of p agent t))))))))))
      false))