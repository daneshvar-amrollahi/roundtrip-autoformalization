(forall ((actor Person) (other Person) (l Land) (t Int))
  (=> (and (not (= actor other))
           (intends_to_disrupt actor other t)
           (lawfully_hunting_or_catching other t)
           (present_on actor l t)
           (or (is_public_land l)
               (and (is_private_land l)
                    (forall ((owner Person))
                      (=> (or (is_landowner_of owner l)
                              (exists ((agent Person))
                                (and (is_agent_of agent owner)
                                     (is_landowner_of owner l))))
                          (not (has_consent_of actor owner t)))))))
      false))