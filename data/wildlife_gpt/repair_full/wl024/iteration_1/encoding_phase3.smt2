(forall ((actor Person) (target Person) (l Land) (owner Person) (agent Person) (t Int))
  (=> (and (present_on actor l t)
           (or (is_public_land l)
               (and (is_private_land l)
                    (is_landowner_of owner l)
                    (not (has_consent_of actor owner t))
                    (forall ((agent Person))
                      (=> (and (is_agent_of agent owner)
                               (distinct agent owner))
                          (not (has_consent_of actor agent t))))))
           (lawfully_hunting_or_catching target t)
           (distinct actor target)
           (intends_to_disrupt actor target t))
      (not (interferes_with actor target t))))