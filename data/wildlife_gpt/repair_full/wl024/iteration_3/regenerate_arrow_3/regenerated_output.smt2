(forall ((actor Person) (other Person) (l Land) (t Int))
  (=> (and (distinct actor other)
           (lawfully_hunting_or_catching other t)
           (present_on actor l t)
           (or (is_public_land l)
               (and (is_private_land l)
                    (exists ((owner Person))
                      (and (is_landowner_of owner l)
                           (not (has_consent_of actor owner t)))))))
      (not (intends_to_disrupt actor other t))))