(forall ((seller Person) (animal Animal) (t Int))
  (=> (sells seller animal t)
      (exists ((buyer Person))
        (and (buys buyer animal t)
             (or (is_zoo_entity seller)
                 (is_zoo_entity buyer)
                 (and (is_educational_institution buyer)
                      (for_scientific_purpose buyer t)
                      (has_subchapter_authorization buyer t))
                 (and (is_research_institution buyer)
                      (for_scientific_purpose buyer t)
                      (has_subchapter_authorization buyer t))
                 (exists ((dealer Person) (t2 Int) (resaleBuyer Person))
                   (and (buys dealer animal t)
                        (sells dealer animal t2)
                        (buys resaleBuyer animal t2)
                        (or (is_zoo_entity dealer)
                            (is_zoo_entity resaleBuyer)
                            (and (is_educational_institution resaleBuyer)
                                 (for_scientific_purpose resaleBuyer t2)
                                 (has_subchapter_authorization resaleBuyer t2))
                            (and (is_research_institution resaleBuyer)
                                 (for_scientific_purpose resaleBuyer t2)
                                 (has_subchapter_authorization resaleBuyer t2))))))))))