(forall ((seller Person) (a Animal) (t Int))
  (=> (sells seller a t)
      (exists ((buyer Person))
        (and (buys buyer a t)
             (or (is_zoo_entity seller)
                 (is_zoo_entity buyer)
                 (and (or (is_educational_institution buyer)
                          (is_research_institution buyer))
                      (for_scientific_purpose buyer t)
                      (has_subchapter_authorization buyer t))
                 (and (for_commercial_purpose buyer a t)
                      (exists ((t2 Int))
                        (and (<= t t2)
                             (sells buyer a t2)
                             (exists ((next_buyer Person))
                               (and (buys next_buyer a t2)
                                    (or (is_zoo_entity next_buyer)
                                        (and (or (is_educational_institution next_buyer)
                                                 (is_research_institution next_buyer))
                                             (for_scientific_purpose next_buyer t2)
                                             (has_subchapter_authorization next_buyer t2)))))))))))))