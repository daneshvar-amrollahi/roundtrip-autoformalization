(forall ((seller Person) (buyer Person) (a Animal) (t Int))
  (=> (and (sells seller a t)
           (not
             (or
               (or (is_zoo_entity seller) (is_zoo_entity buyer))
               (and (or (is_educational_institution buyer) (is_research_institution buyer))
                    (for_scientific_purpose buyer t)
                    (has_subchapter_authorization buyer t))
               (exists ((dealer Person))
                 (and (= buyer dealer)
                      (for_commercial_purpose dealer a t)
                      (exists ((resaleBuyer Person) (t2 Int))
                        (and (<= t t2)
                             (sells dealer a t2)
                             (or (or (is_zoo_entity dealer) (is_zoo_entity resaleBuyer))
                                 (and (or (is_educational_institution resaleBuyer) (is_research_institution resaleBuyer))
                                      (for_scientific_purpose resaleBuyer t2)
                                      (has_subchapter_authorization resaleBuyer t2))))))))))
      false))