(forall ((seller Person) (buyer Person) (a Animal) (t Int))
  (=> (and (sells seller a t)
           (buys buyer a t)
           (distinct seller buyer))
      (or (is_zoo_entity seller)
          (is_zoo_entity buyer)
          (and (or (is_educational_institution buyer)
                   (is_research_institution buyer))
               (for_scientific_purpose buyer t)
               (has_subchapter_authorization buyer t))
          (exists ((t2 Int) (nextBuyer Person))
            (and (< t t2)
                 (sells buyer a t2)
                 (buys nextBuyer a t2)
                 (distinct buyer nextBuyer)
                 (or (is_zoo_entity nextBuyer)
                     (and (or (is_educational_institution nextBuyer)
                              (is_research_institution nextBuyer))
                          (for_scientific_purpose nextBuyer t2)
                          (has_subchapter_authorization nextBuyer t2))))))))