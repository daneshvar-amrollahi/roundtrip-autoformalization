(forall ((grantee Person) (owner Person) (agent Person) (doc Document) (l Land) (t Int))
  (=> (and (is_landowner_of owner l)
           (is_valid_consent doc owner grantee t)
           (document_kind doc DOK_WrittenConsent))
      (and (names_grantee doc grantee)
           (identifies_land doc l)
           (or (signed_by doc owner)
               (and (is_agent_of agent owner)
                    (signed_by doc agent)
                    (shows_address_and_phone_of doc agent)))
           (=> (signed_by doc owner)
               (shows_address_and_phone_of doc owner)))))