(forall ((doc Document) (landowner Person) (grantee Person) (t Int))
  (=> (is_valid_consent doc landowner grantee t)
      (and (names_grantee doc grantee)
           (exists ((l Land))
             (identifies_land doc l))
           (exists ((signer Person))
             (and (signed_by doc signer)
                  (shows_address_and_phone_of doc signer)
                  (or (= signer landowner)
                      (is_agent_of signer landowner)
                      (has_consent_of signer landowner t)
                      (exists ((other_grantee Person))
                        (and (is_valid_consent doc landowner other_grantee t)
                             (= signer other_grantee)))))))))