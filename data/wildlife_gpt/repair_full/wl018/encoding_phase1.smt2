(forall ((hunter Person) (a Animal) (t Int))
  (=> (and (hunts hunter a t)
           (or (kills hunter a t) (wounds hunter a t))
           (or (is_kind a AK_DesertBighornSheep)
               (is_kind a AK_PronghornAntelope)
               (is_kind a AK_MuleDeer)
               (is_kind a AK_WhiteTailedDeer))
           (not (lawfully_killed a)))
      (or (and (or (acts_intentionally hunter t) (acts_knowingly hunter t))
               (not (makes_reasonable_effort_to_retrieve hunter a t)))
          (and (or (acts_intentionally hunter t)
                   (acts_knowingly hunter t)
                   (acts_recklessly hunter t)
                   (acts_with_criminal_negligence hunter t))
               (not (keeps_in_edible_condition hunter a t))))))