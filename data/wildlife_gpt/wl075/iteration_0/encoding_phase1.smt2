(forall ((p Person) (d Device) (w WaterBody) (t Int))
  (=> (and (uses_device p d t)
           (device_kind d DK_CrabTrap)
           (on_water_body p w t)
           (water_kind w WK_PublicWater)
           (not (has_attached_tag d t))
           (not (and (has_subchapter_authorization p t)
                     (has_document_kind p DOK_CommercialFishingLicense t))))
      (not (uses_device p d t))))