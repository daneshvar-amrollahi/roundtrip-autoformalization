(forall ((hunter Person) (a Animal) (l Land) (t Int))
  (=> (and (hunts hunter a t)
           (or (is_kind a AK_WildGameAnimal)
               (is_kind a AK_WildBird)
               (is_kind a AK_WildFowl))
           (or (on_state_park hunter t)
               (and (on_land hunter l t)
                    (land_kind l LK_FortOrHistoricSite)))
           (not (not (has_subchapter_authorization hunter t))))
      (authorized_by_commission hunter t)))