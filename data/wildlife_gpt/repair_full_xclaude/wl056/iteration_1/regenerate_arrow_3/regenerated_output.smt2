(forall ((p Person) (f Animal) (w WaterBody) (d Device) (b1 Building) (b2 Building) (t Int))
  (=> (and (on_canal_or_artificial_waterway p w t)
           (or (takes p f t) (attempts_to_catch p f t))
           (is_kind f AK_Fish)
           (uses_device p d t)
           (not (device_kind d DK_StrikeNet))
           (not (device_kind d DK_Seine))
           (inside_or_on_building f b1 t)
           (inside_or_on_building f b2 t)
           (not (= b1 b2))
           (occupied_by_people b1 t)
           (occupied_by_people b2 t))
      (and (not (takes p f t))
           (not (attempts_to_catch p f t)))))