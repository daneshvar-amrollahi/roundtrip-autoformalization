(forall ((p Person) (fish Animal) (w WaterBody) (d Device) (t Int))
  (=> (and (is_kind fish AK_Fish)
           (on_canal_or_artificial_waterway p w t)
           (uses_device p d t)
           (or (takes p fish t) (attempts_to_catch p fish t))
           (not (or (device_kind d DK_StrikeNet)
                    (device_kind d DK_Seine))))
      (forall ((r1 Building) (r2 Building))
        (=> (and (distinct r1 r2)
                 (inside_or_on_building fish r1 t)
                 (inside_or_on_building fish r2 t)
                 (occupied_by_people r1 t)
                 (occupied_by_people r2 t))
            (not (or (takes p fish t) (attempts_to_catch p fish t)))))))