(forall ((p Person) (a Animal) (mv Device) (light Device) (t Int))
  (=> (and (inside_device p mv t)
           (device_kind mv DK_MotorVehicle)
           (uses_device p light t)
           (device_kind light DK_ArtificialLight)
           (or (captures p a t)
               (captures_by_nonlethal_means p a t)
               (attempts_to_catch p a t))
           (or (is_kind a AK_Reptile)
               (is_kind a AK_Amphibian)))
      false))