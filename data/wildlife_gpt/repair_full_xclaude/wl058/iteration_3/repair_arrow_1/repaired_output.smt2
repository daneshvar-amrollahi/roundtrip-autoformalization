(forall ((p Person) (f Animal) (w WaterBody) (t Int))
  (=> (and (leaves_to_die p f t)
           (takes p f t)
           (on_water_body p w t)
           (water_kind w WK_PublicWater)
           (or (is_kind f AK_Fish) (is_kind f AK_Finfish))
           (not (has_intent_to_retain p f t)))
      (and (not (for_home_destination p f t))
           (not (is_in_edible_condition f t)))))