(forall ((p Person) (fish Animal) (w WaterBody) (t Int))
  (=> (and (leaves_to_die p fish t)
           (takes p fish t)
           (on_water_body p w t)
           (water_kind w WK_PublicWater)
           (or (is_kind fish AK_Finfish)
               (is_kind fish AK_Fish)))
      (not (and (has_intent_to_retain p fish t)
                (or (for_home_destination p fish t)
                    (is_in_edible_condition fish t))))))