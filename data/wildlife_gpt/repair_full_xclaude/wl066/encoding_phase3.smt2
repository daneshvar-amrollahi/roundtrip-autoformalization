(forall ((seller Person) (fish Animal) (t Int))
  (=> (and (is_kind fish AK_Fish)
           (was_imported fish t)
           (is_named_in_protected_fish_list fish)
           (or (sells seller fish t)
               (offers_to_sell seller fish t))
           (not (and (is_tagged fish t)
                     (is_packaged fish t)
                     (is_invoiced fish t)
                     (is_labeled fish t))))
      (not (or (sells seller fish t)
               (offers_to_sell seller fish t)))))