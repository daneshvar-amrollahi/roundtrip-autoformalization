(forall ((disruptor Person) (hunter Person) (l Land) (t Int))
  (=> (and (present_on disruptor l t)
           (intends_to_disrupt disruptor hunter t)
           (lawfully_hunting_or_catching hunter t))
      (and
        (=> (is_public_land l)
            (not (interferes_with disruptor hunter t)))
        (=> (and (is_private_land l)
                 (not (exists ((owner Person))
                        (and (is_landowner_of owner l)
                             (has_consent_of disruptor owner t)))))
            (not (exists ((agent Person) (owner Person))
                   (and (is_landowner_of owner l)
                        (is_agent_of agent owner)
                        (has_consent_of disruptor agent t)))))
        (=> (and (is_private_land l)
                 (not (exists ((owner Person))
                        (and (is_landowner_of owner l)
                             (has_consent_of disruptor owner t))))
                 (not (exists ((agent Person) (owner Person))
                        (and (is_landowner_of owner l)
                             (is_agent_of agent owner)
                             (has_consent_of disruptor agent t)))))
            (not (interferes_with disruptor hunter t))))))