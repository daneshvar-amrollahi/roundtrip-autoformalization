(forall ((disruptor Person) (target Person) (l Land) (t Int))
  (=> (and (present_on disruptor l t)
           (intends_to_disrupt disruptor target t)
           (lawfully_hunting_or_catching target t)
           (not (= disruptor target))
           (or (is_public_land l)
               (and (is_private_land l)
                    (forall ((owner Person))
                      (=> (is_landowner_of owner l)
                          (and (not (has_consent_of disruptor owner t))
                               (forall ((agent Person))
                                 (=> (is_agent_of agent owner)
                                     (not (has_consent_of disruptor agent t))))))))))
      false))