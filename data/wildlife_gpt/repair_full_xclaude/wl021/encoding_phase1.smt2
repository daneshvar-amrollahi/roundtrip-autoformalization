(forall ((consent Document) (grantee Person) (signer Person) (owner Person) (l Land) (t Int))
  (=> (and (document_kind consent DOK_WrittenConsent)
           (is_valid_consent consent signer grantee t)
           (is_landowner_of owner l)
           (or (= signer owner)
               (is_agent_of signer owner)))
      (and (names_grantee consent grantee)
           (identifies_land consent l)
           (signed_by consent signer)
           (shows_address_and_phone_of consent signer))))