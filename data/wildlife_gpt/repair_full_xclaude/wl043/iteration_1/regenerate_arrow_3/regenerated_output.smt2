(forall ((seller Person) (buyer Person) (a Animal) (t Int))
  (=> (sells seller a t)
      (or (is_zoo_entity seller)
          (is_zoo_entity buyer)
          (and (or (is_educational_institution buyer)
                   (is_research_institution buyer))
               (for_scientific_purpose buyer t)
               (has_subchapter_authorization buyer t))
          (exists ((dealer Person) (t2 Int) (finalBuyer Person) (t3 Int))
            (and (buys dealer a t)
                 (sells dealer a t2)
                 (<= t t2)
                 (or (is_zoo_entity dealer)
                     (is_zoo_entity buyer)
                     (and (or (is_educational_institution buyer)
                              (is_research_institution buyer))
                          (for_scientific_purpose buyer t2)
                          (has_subchapter_authorization buyer t2))
                     (and (sells dealer a t3)
                          (<= t2 t3)
                          (buys finalBuyer a t3)
                          (or (is_zoo_entity dealer)
                              (is_zoo_entity finalBuyer)
                              (and (or (is_educational_institution finalBuyer)
                                       (is_research_institution finalBuyer))
                                   (for_scientific_purpose finalBuyer t3)
                                   (has_subchapter_authorization finalBuyer t3))))))))))