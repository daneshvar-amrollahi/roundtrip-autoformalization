(or
  (exists ((seller Person) (buyer Person) (a Animal) (t Int))
    (and (sells seller a t)
         (buys buyer a t)
         (or (is_zoo_entity seller) (is_zoo_entity buyer))))
  (exists ((seller Person) (buyer Person) (a Animal) (t Int))
    (and (sells seller a t)
         (buys buyer a t)
         (or (is_educational_institution buyer)
             (is_research_institution buyer))
         (for_scientific_purpose buyer t)
         (has_subchapter_authorization buyer t)))
  (exists ((seller Person) (dealer Person) (a Animal) (t Int))
    (and (sells seller a t)
         (buys dealer a t)
         (exists ((final_buyer Person) (t2 Int))
           (and (sells dealer a t2)
                (buys final_buyer a t2)
                (or (or (is_zoo_entity dealer) (is_zoo_entity final_buyer))
                    (and (or (is_educational_institution final_buyer)
                             (is_research_institution final_buyer))
                         (for_scientific_purpose final_buyer t2)
                         (has_subchapter_authorization final_buyer t2)))))))