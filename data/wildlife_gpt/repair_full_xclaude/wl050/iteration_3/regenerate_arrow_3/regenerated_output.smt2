(forall ((p Person) (d Device) (w WaterBody) (t Int))
  (=> (and (possesses_device p d t)
           (on_water_body p w t)
           (water_kind w WK_PublicWater)
           (not (is_permitted_by_code d t)))
      (and
        (exists ((v Device))
          (and (on_device d v t)
               (not (device_kind v DK_Powerboat))))
        (exists ((cw WaterBody))
          (and (on_water_body p cw t)
               (water_kind cw WK_PublicCoastalWater)))
        (or
          (exists ((l Land))
            (and (on_land p l t)
                 (not (land_kind l LK_Other))))
          (and (on_canal_or_artificial_waterway p w t)
               (exists ((w2 WaterBody))
                 (and (water_kind w2 WK_PublicWater)
                      (is_permitted_by_code d t))))))))