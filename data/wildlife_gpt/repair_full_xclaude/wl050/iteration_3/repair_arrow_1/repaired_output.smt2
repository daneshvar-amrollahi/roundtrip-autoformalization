(forall ((p Person) (d Device) (w WaterBody) (t Int))
  (=> (and (possesses_device p d t)
           (on_water_body p w t)
           (water_kind w WK_PublicWater)
           (not (is_permitted_by_code d t)))
      (or (exists ((v Device))
            (and (device_kind v DK_VesselOther)
                 (on_device d v t)
                 (exists ((cw WaterBody))
                   (and (on_water_body p cw t)
                        (water_kind cw WK_PublicCoastalWater)))
                 (exists ((l Land))
                   (and (on_land p l t)
                        (land_kind l LK_Other)))))
          (exists ((v Device))
            (and (device_kind v DK_VesselOther)
                 (on_device d v t)
                 (exists ((cw WaterBody))
                   (and (on_water_body p cw t)
                        (water_kind cw WK_PublicCoastalWater)))
                 (on_canal_or_artificial_waterway p w t)
                 (exists ((pw WaterBody))
                   (and (water_kind pw WK_PublicWater)
                        (is_permitted_by_code d t))))))))