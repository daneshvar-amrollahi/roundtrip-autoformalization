(forall ((p Person) (d Device) (w WaterBody) (t Int))
  (=> (and (possesses_device p d t)
           (on_water_body p w t)
           (water_kind w WK_PublicWater)
           (or (device_kind d DK_OtherFishingDevice)
               (device_kind d DK_Seine)
               (device_kind d DK_StrikeNet)
               (device_kind d DK_GillNet)
               (device_kind d DK_TrammelNet)
               (device_kind d DK_Trotline)
               (device_kind d DK_HookAndLine)
               (device_kind d DK_CrabTrap))
           (not (is_permitted_by_code d t)))
      (exists ((v Device) (w2 WaterBody))
        (and (inside_device p v t)
             (or (device_kind v DK_Powerboat)
                 (device_kind v DK_Sailboat)
                 (device_kind v DK_FloatingDevice)
                 (device_kind v DK_VesselOther))
             (on_water_body p w2 t)
             (water_kind w2 WK_CoastalWater)
             (or (exists ((l Land))
                   (on_land p l t))
                 (and (on_canal_or_artificial_waterway p w t)
                      (is_permitted_by_code d t)
                      (water_kind w WK_PublicWater)))))))