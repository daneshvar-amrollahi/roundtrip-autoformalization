(forall ((p Person) (f Animal) (doc Document) (emp Person) (t Int))
  (=> (and (possesses p f t)
           (is_kind f AK_Fish)
           (is_named_in_protected_fish_list f)
           (document_kind doc DOK_OriginVerification))
      (and (or (keeps_with p doc f t)
               (and (is_department_employee emp t)
                    (displays_on_request p doc t)))
           (=> (and (is_department_employee emp t)
                    (not (displays_on_request p doc t)))
               (not (keeps_with p doc f t))))))