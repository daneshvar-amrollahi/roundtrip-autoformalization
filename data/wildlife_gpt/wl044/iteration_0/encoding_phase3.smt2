(forall ((p Person) (a Animal) (w WaterBody) (owner Person) (t Int))
  (=> (and (on_water_body p w t)
           (water_kind w WK_PrivateWater)
           (is_owner_of_water owner w)
           (is_kind a AK_AquaticAnimalLife)
           (or (catches p a t)
               (takes p a t)
               (attempts_to_catch p a t))
           (not (has_consent_of p owner t))
           (forall ((agent Person))
             (=> (is_agent_of agent owner)
                 (not (has_consent_of p agent t)))))
      (and (not (catches p a t))
           (not (takes p a t))
           (not (attempts_to_catch p a t)))))