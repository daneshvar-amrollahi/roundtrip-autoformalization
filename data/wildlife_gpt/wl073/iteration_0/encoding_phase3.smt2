(forall ((p Person) (carcass Animal) (prod Animal) (b Building) (t Int))
  (=> (and (processes_into p carcass prod t)
           (is_kind carcass AK_Carcass)
           (is_kind carcass AK_Shark)
           (inside_or_on_building carcass b t)
           (or (is_kind prod AK_Steak) (is_kind prod AK_Fillet)))
      (and
        (forall ((fin Animal))
          (=> (and (is_kind fin AK_Fin)
                   (is_part_of fin carcass))
              (and (fin_destroyed fin t)
                   (forall ((t2 Int))
                     (=> (<= t t2)
                         (fin_destroyed fin t2))))))
        (forall ((fin Animal))
          (=> (and (is_kind fin AK_Fin)
                   (is_part_of fin prod))
              (not (is_part_of fin carcass)))))))