(forall ((p Person) (carcass Animal) (product Animal) (b Building) (t Int))
  (=> (and (processes_into p carcass product t)
           (is_kind carcass AK_Carcass)
           (is_kind carcass AK_Shark)
           (or (is_kind product AK_Steak) (is_kind product AK_Fillet))
           (inside_or_on_building carcass b t))
      (and
        (forall ((fin Animal))
          (=> (and (is_kind fin AK_Fin)
                   (is_part_of fin carcass))
              (and (fin_destroyed fin t)
                   (forall ((t2 Int))
                     (=> (<= t t2)
                         (fin_destroyed fin t2))))))
        (forall ((fin2 Animal))
          (=> (and (is_kind fin2 AK_Fin)
                   (is_part_of fin2 product))
              (not (is_part_of fin2 carcass)))))))