(forall ((seller Person) (buyer Person) (a Animal) (t Int))
  (=> (sells seller a t)
      (or (is_zoo_entity seller)
          (is_zoo_entity buyer)
          (and (is_educational_institution buyer)
               (for_scientific_purpose buyer t)
               (has_document_kind buyer DOK_Permit t))
          (and (is_research_institution buyer)
               (for_scientific_purpose buyer t)
               (has_document_kind buyer DOK_Permit t))
          (exists ((dealer Person))
            (and (sells seller a t)
                 (buys dealer a t)
                 (sells dealer a t)
                 (or (is_zoo_entity dealer)
                     (exists ((edu Person))
                       (and (is_educational_institution edu)
                            (buys edu a t)
                            (for_scientific_purpose edu t)
                            (has_document_kind edu DOK_Permit t)))
                     (exists ((res Person))
                       (and (is_research_institution res)
                            (buys res a t)
                            (for_scientific_purpose res t)
                            (has_document_kind res DOK_Permit t)))))))))