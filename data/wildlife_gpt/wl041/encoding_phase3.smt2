(or
  (exists ((official Person) (w Animal) (t Int))
    (and (is_kind w AK_Wolf)
         (transports official w t)
         (on_official_duty official t)
         (is_state_or_county_official official)))
  (exists ((p Person) (w Animal) (owner Person) (t Int))
    (and (is_kind w AK_Wolf)
         (or (possesses p w t) (transports p w t))
         (or (is_licensed_circus_zoo_owner p)
             (and (is_agent_of p owner)
                  (is_licensed_circus_zoo_owner owner)))
         (or (for_exhibition p t)
             (for_scientific_purpose p t)))))