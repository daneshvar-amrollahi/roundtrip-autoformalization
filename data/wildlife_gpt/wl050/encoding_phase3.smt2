(forall ((p Person) (d Device) (wPublic WaterBody) (wCoastal WaterBody) (wCanal WaterBody) (floating Device) (t Int))
  (=> (and (possesses_device p d t)
           (on_water_body p wPublic t)
           (water_kind wPublic WK_PublicWater)
           (not (is_permitted_by_code d t))
           (device_kind floating DK_FloatingDevice)
           (on_device d floating t)
           (on_water_body p wCoastal t)
           (water_kind wCoastal WK_CoastalWater)
           (on_canal_or_artificial_waterway p wCanal t))
      (or (is_permitted_by_code floating t)
          (not (on_device d floating t)))))