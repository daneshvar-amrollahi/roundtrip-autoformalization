(forall ((disruptor Person) (hunter Person) (l Land) (t Int))
  (=> (and (intends_to_disrupt disruptor hunter t)
           (lawfully_hunting_or_catching hunter t)
           (present_on disruptor l t))
      (and
        (=> (is_public_land l)
            (not (present_on disruptor l t)))
        (=> (and (is_private_land l)
                 (forall ((landowner Person))
                   (=> (is_landowner_of landowner l)
                       (and (not (has_consent_of disruptor landowner t))
                            (forall ((agent Person))
                              (=> (and (is_agent_of agent landowner)
                                       (has_consent_of disruptor agent t))
                                  (not (is_agent_of agent landowner))))))))
            (not (present_on disruptor l t))))))