(forall ((p Person) (d Device) (t Int))
  (=> (and (on_lcra_land p t)
           (or (device_kind d DK_Firearm)
               (device_kind d DK_Bow)
               (device_kind d DK_Crossbow)
               (device_kind d DK_Slingshot)
               (device_kind d DK_Other))
           (or (uses_device p d t)
               (possesses_device p d t)
               (shoots_device p d t))
           (not (authorized_by_commission p t)))
      false))