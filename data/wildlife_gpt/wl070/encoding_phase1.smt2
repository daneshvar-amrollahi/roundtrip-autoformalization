(forall ((p Person) (fish Animal) (w WaterBody) (t Int))
  (=> (and (is_kind fish AK_Fish)
           (on_water_body p w t)
           (water_kind w WK_PublicFreshWater)
           (lawfully_taken fish))
      (and (not (buys p fish t))
           (not (offers_to_buy p fish t))
           (not (sells p fish t))
           (not (offers_to_sell p fish t))
           (not (and (possesses p fish t) (for_sale p fish t)))
           (not (and (transports p fish t) (for_sale p fish t)))
           (not (and (ships p fish t) (for_sale p fish t)))
           (not (barters p fish t))
           (not (exchanges p fish t)))))