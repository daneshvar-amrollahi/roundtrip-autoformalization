(forall ((p Person) (a Animal) (t Int))
  (=> (or (is_kind a AK_Fish) (is_kind a AK_GameFish) (is_kind a AK_NongameFish) (is_kind a AK_Finfish))
      (=> (or (is_kind a AK_Other)
              (is_kind a AK_Shark))
          (and
            (not (buys p a t))
            (not (offers_to_buy p a t))
            (not (sells p a t))
            (not (offers_to_sell p a t))
            (not (and (possesses p a t) (for_sale p a t)))
            (not (and (transports p a t) (for_sale p a t)))
            (not (and (ships p a t) (for_sale p a t)))
            (not (barters p a t))
            (not (exchanges p a t)))))))