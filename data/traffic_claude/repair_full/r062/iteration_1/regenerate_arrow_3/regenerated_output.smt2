(and
  (forall ((v Vehicle) (d TurnDir) (t Int))
    (=> (and (is_ego v)
             (intends_turn v d t))
        (turn_signal_on v d t)))
  (forall ((v Vehicle) (d TurnDir) (t Int))
    (=> (and (is_ego v)
             (intends_lane_change v d t))
        (turn_signal_on v d t)))
  (forall ((v Vehicle) (t Int))
    (=> (and (is_ego v)
             (parked v t)
             (not (parked v (+ t 1))))
        (or (turn_signal_on v TD_Left (+ t 1))
            (turn_signal_on v TD_Right (+ t 1))))))