(forall ((v Vehicle) (t Int))
  (=> (or
        (intends_turn v TD_Left t)
        (intends_turn v TD_Right t)
        (intends_turn v TD_UTurn t)
        (intends_lane_change v TD_Left t)
        (intends_lane_change v TD_Right t)
        (and (parked v t)
             (not (parked v (+ t 1)))
             (velocity v (+ t 1)) (> (velocity v (+ t 1)) 0.0)))
      (or
        (and (or (intends_turn v TD_Left t)
                 (intends_lane_change v TD_Left t)
                 (intends_turn v TD_UTurn t))
             (turn_signal_on v TD_Left t))
        (and (or (intends_turn v TD_Right t)
                 (intends_lane_change v TD_Right t))
             (turn_signal_on v TD_Right t))
        (and (parked v t)
             (not (parked v (+ t 1)))
             (or (turn_signal_on v TD_Left t)
                 (turn_signal_on v TD_Right t))))))