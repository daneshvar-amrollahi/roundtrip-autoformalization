(forall ((v Vehicle) (ev Vehicle) (r Roadway) (t Int))
  (=> (and (is_ego v)
           (not (= v ev))
           (is_authorized_emergency_vehicle ev)
           (on_roadway v r t)
           (on_roadway ev r t)
           (= (roadway_kind r) RK_Highway)
           (>= (roadway_lane_count r) 2)
           (stationary_with_signals ev t))
      (vacated_nearest_lane v ev t)))