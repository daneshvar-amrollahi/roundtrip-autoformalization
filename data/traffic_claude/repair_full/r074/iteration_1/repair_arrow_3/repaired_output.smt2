(forall ((v_emerging Vehicle) (a Access) (r Roadway) (t Int))
  (=> (and (emerging_from v_emerging a t)
           (access_on_roadway a r)
           (or (= (access_kind a) AK_Alley)
               (= (access_kind a) AK_Building)
               (= (access_kind a) AK_PrivateRoad)
               (= (access_kind a) AK_Driveway))
           (= (roadway_kind r) RK_Highway)
           (exists ((v_approaching Vehicle))
             (and (not (= v_approaching v_emerging))
                  (on_roadway v_approaching r t))))
      (stopped v_emerging t)))