(forall ((a Access) (r Roadway) (v_other Vehicle) (t Int))
  (=> (and (is_ego v_ego)
           (emerging_from v_ego a t)
           (or (= (access_kind a) AK_Alley)
               (= (access_kind a) AK_Building)
               (= (access_kind a) AK_PrivateRoad)
               (= (access_kind a) AK_Driveway))
           (access_on_roadway a r)
           (= (roadway_kind r) RK_Highway)
           (not (= v_other v_ego))
           (on_roadway v_other r t))
      (stopped v_ego t)))