(forall ((c Crossing) (r Roadway) (t Int))
  (=> (and (is_ego ego)
           (cargo_is_explosive_or_flammable ego)
           (approaching_crossing ego c t)
           (on_roadway ego r t)
           (= (district_of_roadway r) DK_Urban))
      (and (stopped ego t)
           (>= (dist_to_nearest_rail_sq ego c t) ft_15_sq)
           (<= (dist_to_nearest_rail_sq ego c t) ft_50_sq))))