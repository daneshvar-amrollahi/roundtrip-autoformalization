(forall ((v Vehicle) (i Intersection) (t Int))
  (=> (and (is_ego v)
           (approaching_intersection v i t)
           (or (= (intersection_control i) IC_StopSign)
               (= (intersection_control i) IC_YieldSign)))
      (and (stopped v t)
           (not (entering_intersection v i t))
           (forall ((u Vehicle) (t2 Int))
             (=> (and (is_immediate_hazard u v i t)
                      (>= t2 t)
                      (is_immediate_hazard u v i t2))
                 (not (entering_intersection v i t2)))))))