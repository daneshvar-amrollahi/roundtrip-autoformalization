(forall ((v_ego Vehicle) (inter Intersection) (r_ego Roadway) (t Int))
  (=> (and (approaching_intersection v_ego inter t)
           (on_roadway v_ego r_ego t)
           (road_terminates_at r_ego inter))
      (and
        (is-stopping v_ego t)
        (yield_right_of_way_to_pedestrian v_ego t)
        (forall ((v_other Vehicle) (r_other Roadway))
          (=> (and (not (= v_other v_ego))
                   (not (= r_other r_ego))
                   (on_roadway v_other r_other t)
                   (intersection_on_roadway inter r_other)
                   (or (in_intersection v_other inter t)
                       (and (approaching_intersection v_other inter t)
                            (is_immediate_hazard v_other v_ego inter t))))
              (not (entering_intersection v_ego inter t)))))))