(forall ((v_ego Vehicle) (v_other Vehicle) (i Intersection) (r_ego Roadway) (r_other Roadway) (t Int))
  (=> (and (approaching_intersection v_ego i t)
           (on_roadway v_ego r_ego t)
           (road_terminates_at r_ego i)
           (intersection_on_roadway i r_other)
           (on_roadway v_other r_other t)
           (not (= r_ego r_other))
           (not (= v_ego v_other))
           (or (in_intersection v_other i t)
               (and (approaching_intersection v_other i t)
                    (is_immediate_hazard v_other v_ego i t))))
      (and (stopped v_ego t)
           (yield_right_of_way_to_pedestrian v_ego t)
           (not (entering_intersection v_ego i t)))))