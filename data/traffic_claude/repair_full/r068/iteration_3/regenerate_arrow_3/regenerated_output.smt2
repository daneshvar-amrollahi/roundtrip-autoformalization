(forall ((v_ego Vehicle) (v_other Vehicle) (i Intersection) (t Int))
  (=> (and (is_ego v_ego)
           (not (= v_ego v_other))
           (= (intersection_control i) IC_Uncontrolled)
           (approaching_intersection v_ego i t)
           (or (and (in_intersection v_other i t)
                    (approaching_from_right v_other v_ego i t))
               (and (approaching_from_right v_other v_ego i t)
                    (is_immediate_hazard v_other v_ego i t))))
      (and (stopped v_ego t)
           (yield_right_of_way_to_pedestrian v_ego t)
           (not (entering_intersection v_ego i t)))))