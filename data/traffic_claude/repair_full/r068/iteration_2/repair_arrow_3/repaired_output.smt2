(forall ((v Vehicle) (v_other Vehicle) (i Intersection) (t Int))
  (=> (and (approaching_intersection v i t)
           (= (intersection_control i) IC_Uncontrolled)
           (not (= v v_other))
           (or (in_intersection v_other i t)
               (and (approaching_from_right v_other v i t)
                    (is_immediate_hazard v_other v i t))))
      (and (stopped v t)
           (not (entering_intersection v i t)))))