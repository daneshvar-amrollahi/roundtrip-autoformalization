(forall ((v Vehicle) (v_parked Vehicle) (r Roadway) (t Int))
  (=> (and (not (= v v_parked))
           (on_roadway v r t)
           (on_roadway v_parked r t)
           (or (stopped v_parked t)
               (parked v_parked t))
           (or (right_wheels_within_18in v_parked r t)
               (parallel_to_curb v_parked r t)))
      (not (or (= (stop_action v t) SA_Stop)
               (= (stop_action v t) SA_Stand)
               (= (stop_action v t) SA_Park)))))