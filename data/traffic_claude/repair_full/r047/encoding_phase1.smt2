(forall ((v_pass Vehicle) (v_streetcar Vehicle) (t Int))
  (=> (and (passing v_pass v_streetcar t)
           (= (kind v_streetcar) VK_Streetcar)
           (not (= v_pass v_streetcar)))
      (not (and (or (executing_turn v_pass TD_Left t)
                    (executing_turn v_pass TD_Right t)
                    (executing_turn v_pass TD_UTurn t))
                (in_front_of v_pass v_streetcar t)
                (interfered_or_impeded v_pass v_streetcar t)))))