(forall ((v_passed Vehicle) (v_passer Vehicle) (t Int))
  (=> (and (passing v_passer v_passed t)
           (not (= v_passed v_passer)))
      (forall ((t2 Int))
        (=> (and (<= t t2)
                 (not (completely_passed v_passer v_passed t2)))
            (not (is-accelerating v_passed t2))))))