(forall ((v Vehicle) (ev Vehicle) (r Roadway) (t Int))
  (=> (and (is_ego v)
           (not (= v ev))
           (is_authorized_emergency_vehicle ev)
           (emergency_vehicle_approaching ev v t)
           (on_roadway v r t)
           (on_roadway ev r t))
      (and (close_to_right_edge_practicable v r t)
           (parallel_to_curb v r t)
           (stopped v t)
           (forall ((i Intersection))
             (=> (intersection_on_roadway i r)
                 (not (in_intersection v i t))))
           (forall ((t2 Int))
             (=> (and (<= t t2)
                      (not (completely_passed ev v t2)))
                 (and (close_to_right_edge_practicable v r t2)
                      (parallel_to_curb v r t2)
                      (stopped v t2)
                      (forall ((i Intersection))
                        (=> (intersection_on_roadway i r)
                            (not (in_intersection v i t2))))))))))