(forall ((v Vehicle) (i Intersection) (t Int))
  (=> (and (approaching_intersection v i t)
           (= (intersection_control i) IC_YieldSign))
      (and (reduced_speed_appropriate v t)
           (forall ((u Vehicle) (t2 Int))
             (=> (and (not (= v u))
                      (approaching_intersection v i t2)
                      (= (intersection_control i) IC_YieldSign)
                      (or (in_intersection u i t2)
                          (is_immediate_hazard u v i t2)))
                 (yield_right_of_way_to_pedestrian v t2))))))