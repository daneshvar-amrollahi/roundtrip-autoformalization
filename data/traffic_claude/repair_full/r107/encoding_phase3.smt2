(forall ((ego Vehicle) (other Vehicle) (r Roadway) (t Int))
  (=> (and (is_ego ego)
           (not (= ego other))
           (= (roadway_kind r) RK_Highway)
           (on_roadway ego r t)
           (or (on_roadway other r t)
               (entering_main_lane other t))
           (assured_clear_distance ego other t))
      (speed_reasonable_and_prudent ego r t)))