(forall ((v Vehicle) (bus Vehicle) (r1 Roadway) (r2 Roadway) (t Int))
  (=> (and (is_ego v)
           (not (= v bus))
           (= (kind bus) VK_SchoolBus)
           (= (roadway_kind r1) RK_Highway)
           (= (roadway_divided r1) DK_Divided)
           (on_roadway v r1 t)
           (bus_stopped_for_students bus t)
           (bus_visual_signal_on bus t)
           (on_roadway bus r2 t)
           (not (= r1 r2)))
      (not (forall ((t2 Int))
             (=> (and (<= t t2)
                      (not (bus_resumed_motion bus t2)))
                 (stopped_before_reaching v bus t2))))))