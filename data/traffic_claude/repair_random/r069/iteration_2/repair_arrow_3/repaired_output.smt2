(forall ((v_ego Vehicle) (v_other Vehicle) (r1 Roadway) (r2 Roadway) (i Intersection) (t Int))
  (=> (and (approaching_intersection v_ego i t)
           (on_roadway v_ego r1 t)
           (intersection_on_roadway i r1)
           (road_terminates_at r1 i)
           (on_roadway v_other r2 t)
           (intersection_on_roadway i r2)
           (not (= r1 r2))
           (not (= v_ego v_other))
           (or (in_intersection v_other i t)
               (approaching_intersection v_other i t))
           (is_immediate_hazard v_other v_ego i t))
      (and (stopped v_ego t)
           (yield_right_of_way_to_pedestrian v_ego t)
           (not (entering_intersection v_ego i t)))))