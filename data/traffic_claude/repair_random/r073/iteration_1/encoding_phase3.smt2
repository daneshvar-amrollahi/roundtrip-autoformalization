(forall ((ego Vehicle) (other Vehicle) (r Roadway) (a Access) (t Int))
  (=> (and (is_ego ego)
           (not (= ego other))
           (on_roadway ego r t)
           (on_roadway other r t)
           (= (roadway_access_control r) AC_Limited)
           (access_on_roadway a r)
           (or (emerging_from ego a t)
               (turning_into ego a t))
           (or (emerging_from other a t)
               (turning_into other a t)
               (entering_main_lane other t)))
      (and (assured_clear_distance ego other t)
           (sufficient_space_for_vehicle_to_enter ego other t))))