(forall ((v Vehicle) (v_other Vehicle) (r Roadway) (i Intersection) (t Int))
  (=> (and (on_roadway v r t)
           (on_roadway v_other r t)
           (crossing_center_line v r t)
           (obstruction_present v r t)
           (intersection_on_roadway i r)
           (is_immediate_hazard v v_other i t)
           (roadway_free_of_obstructions r t))
      (and (stopped v t)
           (not (crossing_center_line v r t)))))