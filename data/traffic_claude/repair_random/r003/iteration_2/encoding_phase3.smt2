(forall ((v1 Vehicle) (v2 Vehicle) (r Roadway) (i Intersection) (t Int))
  (=> (and (not (= v1 v2))
           (on_roadway v1 r t)
           (obstruction_present v1 r t)
           (crossing_center_line v1 r t)
           (on_roadway v2 r t)
           (roadway_free_of_obstructions r t)
           (is_immediate_hazard v2 v1 i t))
      (and (stopped v1 t)
           (not (crossing_center_line v1 r t)))))