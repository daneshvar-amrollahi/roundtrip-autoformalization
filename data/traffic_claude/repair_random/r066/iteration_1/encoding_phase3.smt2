(forall ((ego Vehicle) (other Vehicle) (r_ego Roadway) (r_other Roadway) (ix Intersection) (t Int))
  (=> (and (is_ego ego)
           (on_roadway ego r_ego t)
           (intersection_on_roadway ix r_ego)
           (approaching_intersection ego ix t)
           (= (intersection_control ix) IC_Uncontrolled)
           (or (= (roadway_lane_count r_ego) 1)
               (= (roadway_lane_count r_ego) 2))
           (not (= r_ego r_other))
           (on_roadway other r_other t)
           (intersection_on_roadway ix r_other)
           (or (in_intersection other ix t)
               (and (approaching_intersection other ix t)
                    (is_immediate_hazard other ego ix t)))
           (or (= (roadway_divided r_other) DK_Divided)
               (and (roadway_has_marked_lanes r_other)
                    (>= (roadway_lane_count r_other) 3))))
       (and (stopped ego t)
            (yield_right_of_way_to_pedestrian ego t)
            (not (entering_intersection ego ix t)))))