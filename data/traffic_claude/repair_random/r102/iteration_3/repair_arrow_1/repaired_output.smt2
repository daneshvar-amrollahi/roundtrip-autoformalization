(forall ((v Vehicle) (t Int))
  (=> (and (is_ego v)
           (or (< (dist_to_feature v PF_FlashingSignal t) ft_30)
               (< (dist_to_feature v PF_StopSign t) ft_30)
               (< (dist_to_feature v PF_YieldSign t) ft_30)
               (< (dist_to_feature v PF_TrafficSignal t) ft_30))
           (not (and (= (stop_action v t) SA_Stop)
                     (or (exists ((v2 Vehicle) (t2 Int)) (sufficient_space_for_vehicle_to_enter v v2 t))
                         true))))
      (not (or (= (stop_action v t) SA_Stand)
               (= (stop_action v t) SA_Park)))))