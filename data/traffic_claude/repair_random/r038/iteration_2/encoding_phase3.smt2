(forall ((v_op Vehicle) (v_bus Vehicle) (t Int))
  (=> (and (stopped_before_reaching v_op v_bus t)
           (= (kind v_bus) VK_SchoolBus))
      (forall ((t2 Int))
        (=> (and (< t t2)
                 (not (bus_resumed_motion v_bus t2))
                 (not (bus_driver_signaled_proceed v_bus v_op t2))
                 (bus_visual_signal_on v_bus t2))
            (stopped v_op t2)))))