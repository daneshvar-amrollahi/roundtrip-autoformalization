(forall ((v Vehicle) (r Roadway) (t Int))
  (=> (and (on_roadway v r t)
           (= (roadway_access_control r) AC_Limited)
           (backing v t)
           (or (= (roadway_pos v r t) RP_ShoulderRight)
               (= (roadway_pos v r t) RP_ShoulderLeft)
               (= (roadway_pos v r t) RP_RightHalf)
               (= (roadway_pos v r t) RP_LeftHalf)
               (= (roadway_pos v r t) RP_RightLane)
               (= (roadway_pos v r t) RP_CenterLane)
               (= (roadway_pos v r t) RP_LeftLane)))
      false))