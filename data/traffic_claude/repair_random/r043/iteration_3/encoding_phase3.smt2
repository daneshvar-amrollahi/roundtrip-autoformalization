(forall ((v_pass Vehicle) (v_streetcar Vehicle) (t Int))
  (=> (and (not (= v_pass v_streetcar))
           (= (kind v_streetcar) VK_Streetcar)
           (passing v_pass v_streetcar t)
           (= (passing_side v_pass v_streetcar t) PS_Right)
           (= (streetcar_state v_streetcar t) SCS_StoppedForPassengers))
      (and (stopped v_pass t)
           (forall ((t2 Int))
             (=> (and (<= t t2)
                      (not (passengers_all_safe v_streetcar t2)))
                 (stopped v_pass t2))))))