(forall ((v Vehicle) (c Crossing) (t Int))
  (=> (and (is_ego v)
           (cargo_is_explosive_or_flammable v)
           (approaching_crossing v c t)
           (> (velocity v t) mph_20)
           (< (dist_to_nearest_rail_sq v c t) ft_200_sq))
      (and (is-decelerating v t)
           (forall ((t2 Int))
             (=> (and (> t2 t)
                      (< (dist_to_nearest_rail_sq v c t2) ft_200_sq))
                 (<= (velocity v t2) mph_20))))))