(forall ((v Vehicle) (r Roadway) (t Int))
  (=> (is_ego v)
      (=> (or (exists ((i Intersection))
                (or (approaching_intersection v i t)
                    (in_intersection v i t)))
              (exists ((c Crossing))
                (or (approaching_crossing v c t)
                    (and (approaching_crossing v c t)
                         (not (stopped v t))))))
          (reduced_speed_appropriate v t))))