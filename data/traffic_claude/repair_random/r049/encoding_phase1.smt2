(forall ((v Vehicle) (c Crossing) (t Int))
  (=> (and (approaching_crossing v c t)
           (rail_stop_condition_holds v c t)
           (stopped v t))
      (forall ((t2 Int))
        (=> (and (<= t t2)
                 (not (and (permitted_to_proceed v c t2)
                           (safe_to_proceed v c t2))))
            (stopped v t2)))))