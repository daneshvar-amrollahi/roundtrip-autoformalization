(forall ((v Vehicle) (v_emerg Vehicle) (r Roadway) (t Int))
  (=> (and (is_ego v)
           (is_authorized_emergency_vehicle v_emerg)
           (emergency_vehicle_approaching v_emerg v t)
           (emergency_signals_active v_emerg t)
           (on_roadway v r t))
      (and (close_to_right_edge_practicable v r t)
           (parallel_to_curb v r t)
           (not (exists ((i Intersection)) (in_intersection v i t)))
           (stopped v t)
           (forall ((t2 Int))
             (=> (and (<= t t2)
                      (not (completely_passed v_emerg v t2)))
                 (and (stopped v t2)
                      (close_to_right_edge_practicable v r t2)
                      (parallel_to_curb v r t2)
                      (not (exists ((i Intersection)) (in_intersection v i t2)))))))))