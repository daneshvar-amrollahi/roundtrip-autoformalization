(forall ((v_emerging Vehicle) (v_approaching Vehicle) (a Access) (r Roadway) (t Int))
  (=> (and (is_ego v_emerging)
           (not (= v_emerging v_approaching))
           (emerging_from v_emerging a t)
           (or (= (access_kind a) AK_Alley)
               (= (access_kind a) AK_Driveway)
               (= (access_kind a) AK_Building))
           (access_on_roadway a r)
           (on_roadway v_approaching r t)
           (approaching_opposite v_emerging v_approaching t))
       (and (yield_right_of_way_to_pedestrian v_emerging t)
            (assured_clear_distance v_emerging v_approaching t))))