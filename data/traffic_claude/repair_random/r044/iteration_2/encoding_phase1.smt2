(forall ((v Vehicle) (sc Vehicle) (z Zone) (t Int))
  (=> (and (is_ego v)
           (= (kind sc) VK_Streetcar)
           (exists ((zz Zone)) (and (is_safety_zone zz)
                                    (safety_zone_established_for_streetcar_stop sc zz t))))
      (and (exists ((t2 Int))
             (and (>= t2 t)
                  (passing v sc t2)
                  (= (passing_side v sc t2) PS_Right)
                  (not (stopped v t2))))
           (forall ((t2 Int))
             (=> (and (>= t2 t)
                      (passing v sc t2)
                      (= (passing_side v sc t2) PS_Right))
                 (proceeded_with_due_caution v t2))))))