(forall ((v Vehicle) (t Int))
  (=> (and (or (stopped v t)
               (standing_vehicle v t)
               (parked v t))
           (not (movement_can_be_made_safely v t)))
      (and (not (> (velocity v t) 0.0))
           (forall ((t2 Int))
             (=> (and (>= t2 t)
                      (not (movement_can_be_made_safely v t2)))
                 (not (> (velocity v t2) 0.0)))))))