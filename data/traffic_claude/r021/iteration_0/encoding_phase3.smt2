(forall ((v_pass Vehicle) (v_passed Vehicle) (t Int))
  (=> (and (passing v_pass v_passed t)
           (= (passing_side v_pass v_passed t) PS_Right)
           (not (= v_pass v_passed)))
      (and (movement_can_be_made_safely v_pass t)
           (or (intends_turn v_passed TD_Left t)
               (executing_turn v_passed TD_Left t))
           (exists ((r Roadway))
             (and (on_roadway v_pass r t)
                  (on_roadway v_passed r t)
                  (or (and (roadway_sufficient_width r)
                           (roadway_free_of_obstructions r t))
                      (and (roadway_has_marked_lanes r)
                           (>= (roadway_lane_count r) 2))
                      (= (roadway_flow r) FK_OneWay)))))))