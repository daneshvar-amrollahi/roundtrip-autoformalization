(forall ((v Vehicle) (bus Vehicle) (t Int))
  (=> (and (not (= v bus))
           (= (kind bus) VK_SchoolBus)
           (approaching_bus v bus t)
           (bus_stopped_for_students bus t)
           (bus_visual_signal_on bus t)
           (exists ((r Roadway))
             (and (on_roadway v r t)
                  (= (roadway_divided r) DK_Divided)
                  (not (exists ((r2 Roadway))
                    (and (on_roadway v r2 t)
                         (on_roadway bus r2 t)))))))
      (not (forall ((t2 Int))
        (=> (and (<= t t2)
                 (not (completely_passed v bus t2)))
            (stopped_before_reaching v bus t2))))))