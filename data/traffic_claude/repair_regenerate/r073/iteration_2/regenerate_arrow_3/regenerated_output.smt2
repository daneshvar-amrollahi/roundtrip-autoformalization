(forall ((v_ego Vehicle) (v_other Vehicle) (r Roadway) (a Access) (t Int))
  (=> (and (is_ego v_ego)
           (not (= v_ego v_other))
           (on_roadway v_ego r t)
           (= (roadway_access_control r) AC_Limited)
           (or (and (emerging_from v_other a t)
                    (access_on_roadway a r))
               (and (turning_into v_other a t)
                    (access_on_roadway a r))
               (at_established_entrance_or_exit v_other r t)
               (entering_main_lane v_other t)))
       (and (assured_clear_distance v_ego v_other t)
            (sufficient_space_for_vehicle_to_enter v_ego v_other t))))