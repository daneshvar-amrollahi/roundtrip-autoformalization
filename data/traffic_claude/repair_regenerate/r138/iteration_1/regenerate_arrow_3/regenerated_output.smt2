(forall ((v Vehicle) (t Int))
  (=> (and (is_ego v)
           (or (crossing_sidewalk v t)
               (exists ((a Access))
                 (and (turning_into v a t)
                      (or (= (access_kind a) AK_Driveway)
                          (= (access_kind a) AK_Building)
                          (= (access_kind a) AK_Other))))))
      (exists ((t2 Int))
        (and (< t2 t)
             (stopped_before_sidewalk v t2)))))