(forall ((v_follower Vehicle) (v_leader Vehicle) (t Int))
  (=> (and
        (or (= (kind v_follower) VK_Truck) (drawing_another_vehicle v_follower t))
        (or (= (kind v_leader) VK_Truck) (drawing_another_vehicle v_leader t))
        (not (= v_follower v_leader))
        (following v_follower v_leader t)
        (exists ((r Roadway))
          (and (on_roadway v_follower r t)
               (on_roadway v_leader r t)
               (not (= (district_of_roadway r) DK_Business))
               (not (= (district_of_roadway r) DK_Residence)))))
      (forall ((v_passing Vehicle))
        (=> (and (not (= v_passing v_follower))
                 (not (= v_passing v_leader)))
            (sufficient_space_for_vehicle_to_enter v_follower v_passing t)))))