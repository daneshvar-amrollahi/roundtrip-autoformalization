(forall ((v Vehicle) (inter Intersection) (t Int))
  (=> (and (approaching_intersection v inter t)
           (= (intersection_control inter) IC_YieldSign)
           (exists ((v_other Vehicle))
             (and (not (= v v_other))
                  (or (in_intersection v_other inter t)
                      (is_immediate_hazard v_other v inter t)))))
      (and (reduced_speed_appropriate v t)
           (yield_right_of_way_to_pedestrian v t))))