(forall ((v Vehicle) (sc Vehicle) (t Int))
  (=> (and (not (= v sc))
           (= (kind sc) VK_Streetcar)
           (= (roadway_pos v (lane_on_roadway (let ((dummy v)) dummy)) t) RP_StreetcarTrack)
           (in_front_of v sc t)
           (streetcar_operator_signaled sc v t))
      (forall ((t2 Int))
        (=> (>= t2 t)
            (moved_off_track_asap v t2)))))