(forall ((v_streetcar Vehicle) (v_emergency Vehicle) (t Int))
  (=> (and (= (kind v_streetcar) VK_Streetcar)
           (is_authorized_emergency_vehicle v_emergency)
           (emergency_vehicle_approaching v_emergency v_streetcar t)
           (emergency_signals_active v_emergency t))
      (and
        (forall ((i Intersection))
          (not (in_intersection v_streetcar i t)))
        (stopped v_streetcar t)
        (forall ((t2 Int))
          (=> (and (>= t2 t)
                   (not (completely_passed v_emergency v_streetcar t2)))
              (and (stopped v_streetcar t2)
                   (forall ((i Intersection))
                     (not (in_intersection v_streetcar i t2)))))))))