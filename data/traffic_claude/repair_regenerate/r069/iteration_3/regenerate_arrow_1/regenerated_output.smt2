(forall ((v_term Vehicle) (v_other Vehicle) (i Intersection) (r_term Roadway) (r_other Roadway) (t Int))
  (=> (and (not (= v_term v_other))
           (not (= r_term r_other))
           (approaching_intersection v_term i t)
           (on_roadway v_term r_term t)
           (road_terminates_at r_term i)
           (intersection_on_roadway i r_other)
           (on_roadway v_other r_other t)
           (or (in_intersection v_other i t)
               (approaching_intersection v_other i t))
           (is_immediate_hazard v_other v_term i t))
      (and (stopped v_term t)
           (yield_right_of_way_to_pedestrian v_term t)
           (not (entering_intersection v_term i t)))))