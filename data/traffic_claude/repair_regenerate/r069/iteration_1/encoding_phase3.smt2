(forall ((v_ego Vehicle) (i Intersection) (r_ego Roadway) (r_through Roadway) (t Int))
  (=> (and (on_roadway v_ego r_ego t)
           (approaching_intersection v_ego i t)
           (road_terminates_at r_ego i)
           (intersection_on_roadway i r_through)
           (not (road_terminates_at r_through i)))
      (and (stopped v_ego t)
           (yield_right_of_way_to_pedestrian v_ego t)
           (forall ((v_other Vehicle))
             (=> (and (not (= v_other v_ego))
                      (on_roadway v_other r_through t)
                      (or (in_intersection v_other i t)
                          (approaching_intersection v_other i t))
                      (is_immediate_hazard v_other v_ego i t))
                 (not (entering_intersection v_ego i t)))))))