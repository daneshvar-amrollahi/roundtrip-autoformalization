(forall ((v Vehicle) (bus Vehicle) (t Int))
  (=> (and (not (= v bus))
           (= (kind bus) VK_SchoolBus)
           (approaching_bus v bus t)
           (bus_stopped_for_students bus t)
           (bus_visual_signal_on bus t)
           (exists ((r1 Roadway) (r2 Roadway))
             (and (not (= r1 r2))
                  (on_roadway v r1 t)
                  (on_roadway bus r2 t)
                  (= (roadway_divided r1) DK_Divided)
                  (= (roadway_divided r2) DK_Divided))))
      (not (forall ((t2 Int))
             (=> (and (<= t t2)
                      (not (stopped_before_reaching v bus t2)))
                 (stopped_before_reaching v bus t2))))))