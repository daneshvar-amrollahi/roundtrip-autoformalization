(forall ((v Vehicle) (a Access) (r Roadway) (v_other Vehicle) (t Int))
  (=> (and (or (emerging_from v a t)
               (turning_into v a t))
           (access_on_roadway a r)
           (or (= (access_kind a) AK_Alley)
               (= (access_kind a) AK_Building)
               (= (access_kind a) AK_PrivateRoad)
               (= (access_kind a) AK_Driveway))
           (not (= v v_other))
           (on_roadway v_other r t))
      (yield_right_of_way_to_pedestrian v t)))