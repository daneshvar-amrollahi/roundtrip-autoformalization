(forall ((v_emerging Vehicle) (acc Access) (r Roadway) (v_other Vehicle) (t Int))
  (=> (and (emerging_from v_emerging acc t)
           (access_on_roadway acc r)
           (or (= (access_kind acc) AK_Alley)
               (= (access_kind acc) AK_Building)
               (= (access_kind acc) AK_PrivateRoad)
               (= (access_kind acc) AK_Driveway))
           (not (= v_emerging v_other))
           (on_roadway v_other r t))
      (=> (not (and (sufficient_space_for_vehicle_to_enter v_emerging v_other t)
                    (movement_can_be_made_safely v_emerging t)))
          (not (entering_main_lane v_emerging t)))))