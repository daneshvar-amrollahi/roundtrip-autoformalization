(forall ((v Vehicle) (t Int))
  (=> (and (or (= (stop_action v t) SA_Stand)
               (= (stop_action v t) SA_Park))
           (or (and (<= (dist_to_feature v PF_FlashingSignal t) ft_30))
               (and (<= (dist_to_feature v PF_StopSign t) ft_30))
               (and (<= (dist_to_feature v PF_YieldSign t) ft_30))
               (and (<= (dist_to_feature v PF_TrafficSignal t) ft_30)))
           (not (stopping_or_sudden_decrease_speed v t)))
      false))