(forall ((v Vehicle) (v_oncoming Vehicle) (r Roadway) (t Int))
  (=> (and (on_roadway v r t)
           (on_roadway v_oncoming r t)
           (approaching_opposite v v_oncoming t)
           (not (= v v_oncoming)))
      (or (= (roadway_pos v r t) RP_RightHalf)
          (= (roadway_pos v r t) RP_RightLane))))