(forall ((v Vehicle) (r Roadway) (t Int))
  (=> (and (on_roadway v r t)
           (= (approach_kind v r t) APK_IntersectionOrRailInMunicipality_100ft)
           (or (and (intends_turn v TD_Left t)
                    (exists ((a Access))
                      (and (access_on_roadway a r)
                           (turning_into v a t)
                           (or (= (access_kind a) AK_Alley)
                               (= (access_kind a) AK_PrivateRoad)
                               (= (access_kind a) AK_Driveway)))))
               (exists ((a Access))
                 (and (access_on_roadway a r)
                      (emerging_from v a t)
                      (or (= (access_kind a) AK_Alley)
                          (= (access_kind a) AK_PrivateRoad)
                          (= (access_kind a) AK_Driveway))))))
      (divider_crossing_allowed v r t)))