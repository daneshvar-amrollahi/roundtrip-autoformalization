(forall ((v_ego Vehicle) (v_other Vehicle) (r_ego Roadway) (r_other Roadway) (i Intersection) (t Int))
  (=> (and
        (is_ego v_ego)
        (not (= v_ego v_other))
        (not (= r_ego r_other))
        (approaching_intersection v_ego i t)
        (intersection_on_roadway i r_ego)
        (intersection_on_roadway i r_other)
        (on_roadway v_ego r_ego t)
        (on_roadway v_other r_other t)
        (= (intersection_control i) IC_Uncontrolled)
        (<= 1 (roadway_lane_count r_ego))
        (<= (roadway_lane_count r_ego) 2)
        (or (= (roadway_divided r_other) DK_Divided)
            (and (roadway_has_marked_lanes r_other)
                 (>= (roadway_lane_count r_other) 3)))
        (or (in_intersection v_other i t)
            (and (approaching_intersection v_other i t)
                 (is_immediate_hazard v_other v_ego i t))))
      (and
        (stopped v_ego t)
        (yield_right_of_way_to_pedestrian v_ego t)
        (sufficient_space_for_vehicle_to_enter v_ego v_other t))))