(forall ((v Vehicle) (v_other Vehicle) (r Roadway) (r_other Roadway) (i Intersection) (t Int))
  (=> (and (is_ego v)
           (approaching_intersection v i t)
           (on_roadway v r t)
           (on_roadway v_other r_other t)
           (not (= v v_other))
           (not (= r r_other))
           (intersection_on_roadway i r)
           (intersection_on_roadway i r_other)
           (or (= (roadway_lane_count r) 1)
               (= (roadway_lane_count r) 2))
           (= (intersection_control i) IC_Uncontrolled)
           (or (= (roadway_divided r_other) DK_Divided)
               (and (roadway_has_marked_lanes r_other)
                    (>= (roadway_lane_count r_other) 3)))
           (or (in_intersection v_other i t)
               (approaching_intersection v_other i t))
           (is_immediate_hazard v v_other i t))
      (and (stopped v t)
           (yield_right_of_way_to_pedestrian v t)
           (sufficient_space_for_vehicle_to_enter v_other v t))))