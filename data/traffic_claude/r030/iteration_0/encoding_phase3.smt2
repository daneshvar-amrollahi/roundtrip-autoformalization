(forall ((v1 Vehicle) (v2 Vehicle) (l Lane) (r Roadway) (t Int))
  (=> (and (not (= v1 v2))
           (= (lane_on_roadway l) r)
           (= (roadway_flow r) FK_OneWay)
           (>= (roadway_lane_count r) 3)
           (on_lane v1 l t)
           (on_lane v2 l t)
           (intends_lane_change v1 TD_Left t)
           (intends_lane_change v2 TD_Right t))
      (and (sufficient_space_for_vehicle_to_enter v1 v2 t)
           (sufficient_space_for_vehicle_to_enter v2 v1 t))))