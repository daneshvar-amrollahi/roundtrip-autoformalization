(forall ((v_cross Vehicle) (v_hazard Vehicle) (r Roadway) (i Intersection) (t Int))
  (=> (and (on_roadway v_cross r t)
           (crossing_center_line v_cross r t)
           (obstruction_present v_cross r t)
           (on_roadway v_hazard r t)
           (not (= v_cross v_hazard))
           (intersection_on_roadway i r)
           (is_immediate_hazard v_hazard v_cross i t)
           (roadway_free_of_obstructions r t))
      (and (stopped v_cross t)
           (not (crossing_center_line v_cross r (+ t 1))))))