(forall ((v Vehicle) (sc Vehicle) (r Roadway) (t Int))
  (=> (and (is_ego v)
           (= (kind sc) VK_Streetcar)
           (not (= v sc))
           (on_roadway v r t)
           (on_roadway sc r t)
           (or (= (streetcar_state sc t) SCS_Moving)
               (= (streetcar_state sc t) SCS_StoppedForPassengers)
               (= (streetcar_state sc t) SCS_AboutToStopForPassengers)
               (= (streetcar_state sc t) SCS_CrossingIntersection))
           (not (directed_by_police v t))
           (not (= (roadway_flow r) FK_OneWay))
           (not (track_location_prevents_compliance v sc r t)))
      (and (not (and (passing v sc t)
                     (= (passing_side v sc t) PS_Left)))
           (not (= (roadway_pos v r t) RP_LeftHalf)))))