(forall ((v Vehicle) (ev Vehicle) (r Roadway) (t Int))
  (=> (and (is_authorized_emergency_vehicle ev)
           (stationary_with_signals ev t)
           (on_roadway ev r t)
           (on_roadway v r t)
           (not (= v ev))
           (or (= (roadway_kind r) RK_Highway)
               (not (= (roadway_kind r) RK_Highway)))
           (>= (roadway_lane_count r) 2)
           (emergency_vehicle_approaching v ev t))
       (vacated_nearest_lane v ev t)))