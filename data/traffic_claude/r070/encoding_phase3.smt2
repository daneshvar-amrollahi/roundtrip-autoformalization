(forall ((v_turner Vehicle) (i Intersection) (t Int))
  (=> (and (intends_turn v_turner TD_Left t)
           (or (approaching_intersection v_turner i t)
               (exists ((a Access))
                 (and (turning_into v_turner a t)
                      (or (= (access_kind a) AK_Alley)
                          (= (access_kind a) AK_PrivateRoad)
                          (= (access_kind a) AK_Driveway))))))
      (and
        (forall ((v_other Vehicle))
          (=> (and (not (= v_turner v_other))
                   (approaching_opposite v_turner v_other t)
                   (or (in_intersection v_other i t)
                       (is_immediate_hazard v_other v_turner i t)))
              (not (entering_intersection v_turner i t))))
        (=> (not (intersection_can_be_safely_entered v_turner i t))
            (not (entering_intersection v_turner i t))))))