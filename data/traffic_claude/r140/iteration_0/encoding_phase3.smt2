(forall ((v_passed Vehicle) (v_passer Vehicle) (r Roadway) (t Int))
  (=> (and (on_roadway v_passed r t)
           (on_roadway v_passer r t)
           (not (= v_passed v_passer))
           (passing v_passer v_passed t)
           (= (passing_side v_passer v_passed t) PS_Left))
      (and
        (forall ((t2 Int))
          (=> (and (<= t t2)
                   (not (completely_passed v_passer v_passed t2)))
              (not (is-accelerating v_passed t2))))
        (forall ((t2 Int))
          (=> (and (<= t t2)
                   (audible_signal v_passer v_passed t2))
              (close_to_right_edge_practicable v_passed r t2))))))