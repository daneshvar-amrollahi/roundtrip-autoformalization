(forall ((v_mc Vehicle) (v_mv Vehicle) (t Int))
  (=> (and (= (kind v_mc) VK_Motorcycle)
           (or (= (kind v_mv) VK_Regular)
               (= (kind v_mv) VK_Ambulance)
               (= (kind v_mv) VK_FireApparatus)
               (= (kind v_mv) VK_Streetcar)
               (= (kind v_mv) VK_SchoolBus)
               (= (kind v_mv) VK_Moped)
               (= (kind v_mv) VK_Truck)
               (= (kind v_mv) VK_Bus)
               (= (kind v_mv) VK_TowTruck)
               (= (kind v_mv) VK_HeavyEquipment)
               (= (kind v_mv) VK_PoliceVehicle)
               (= (kind v_mv) VK_UtilityVehicle)
               (= (kind v_mv) VK_WasteVehicle)
               (= (kind v_mv) VK_Motorcycle))
           (passing v_mc v_mv t)
           (passing_in_same_lane v_mc v_mv t))
      false))