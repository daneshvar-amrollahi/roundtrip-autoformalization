(forall ((v_pass Vehicle) (v_passed Vehicle) (t Int))
  (=> (and (passing v_pass v_passed t)
           (passing_in_same_lane v_pass v_passed t)
           (= (kind v_pass) VK_Motorcycle)
           (or (= (kind v_passed) VK_Regular)
               (= (kind v_passed) VK_Ambulance)
               (= (kind v_passed) VK_FireApparatus)
               (= (kind v_passed) VK_Streetcar)
               (= (kind v_passed) VK_SchoolBus)
               (= (kind v_passed) VK_Motorcycle)
               (= (kind v_passed) VK_Moped)
               (= (kind v_passed) VK_Truck)
               (= (kind v_passed) VK_Bus)
               (= (kind v_passed) VK_TowTruck)
               (= (kind v_passed) VK_HeavyEquipment)
               (= (kind v_passed) VK_PoliceVehicle)
               (= (kind v_passed) VK_UtilityVehicle)
               (= (kind v_passed) VK_WasteVehicle)))
      false))