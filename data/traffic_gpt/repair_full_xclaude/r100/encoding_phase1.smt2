(forall ((v Vehicle) (t Int))
  (=> (and (or (= (stop_action v t) SA_Stand)
               (= (stop_action v t) SA_Park))
           (< (dist_to_feature v PF_FireHydrant t) ft_15))
      (or (and (= (stop_action v t) SA_Stand)
               (not (parked v t)))
          (not (or (= (stop_action v t) SA_Stand)
                   (= (stop_action v t) SA_Park))))))