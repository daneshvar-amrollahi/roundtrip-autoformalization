(forall ((v Vehicle) (r Roadway) (t Int))
  (=> (and (on_roadway v r t)
           (or (standing_vehicle v t) (parked v t))
           (not (= (stop_action v t) SA_Stop))
           (not (and (= (kind v) VK_Streetcar)
                     (= (streetcar_state v t) SCS_StoppedForPassengers))))
      (and (not (<= (dist_to_feature v PF_FireStationDriveway t) ft_20))
           (=> (or (= (roadway_pos v r t) RP_LeftHalf)
                   (= (roadway_pos v r t) RP_RightHalf))
               (not (<= (dist_to_feature v PF_FireStationDriveway t) ft_75))))))