(forall ((v Vehicle) (r Roadway) (t Int))
  (=> (and (on_roadway v r t)
           (not (or (and (standing_vehicle v t)
                         (not (parked v t)))
                    (and (parked v t)
                         (not (standing_vehicle v t)))))
           (or (<= (dist_to_feature v PF_FireStationDriveway t) ft_20)
               (and (= (roadway_flow r) FK_TwoWay)
                    (or (= (roadway_pos v r t) RP_LeftHalf)
                        (= (roadway_pos v r t) RP_LeftLane)
                        (= (roadway_pos v r t) RP_CenterLane))
                    (<= (dist_to_feature v PF_FireStationDriveway t) ft_75))))
      (not (or (standing_vehicle v t) (parked v t)))))