(forall ((v_enter Vehicle) (a Access) (r Roadway) (t Int))
  (=> (and (or (= (access_kind a) AK_Alley)
               (= (access_kind a) AK_Building)
               (= (access_kind a) AK_PrivateRoad)
               (= (access_kind a) AK_Driveway))
           (access_on_roadway a r)
           (emerging_from v_enter a t))
      (forall ((v_app Vehicle))
        (=> (and (not (= v_app v_enter))
                 (on_roadway v_app r t))
            (yield_right_of_way_to_pedestrian v_enter t)))))