(forall ((v Vehicle) (ev Vehicle) (r Roadway) (t Int))
  (=> (and (on_roadway v r t)
           (on_roadway ev r t)
           (not (= v ev))
           (is_authorized_emergency_vehicle ev)
           (emergency_vehicle_approaching ev v t))
      (exists ((t_move Int))
        (and (<= t t_move)
             (not (approaching_intersection v (Intersection) t_move))
             (parallel_to_curb v r t_move)
             (close_to_right_edge_practicable v r t_move)
             (forall ((t2 Int))
               (=> (and (<= t_move t2)
                        (not (completely_passed ev v t2)))
                   (and (parallel_to_curb v r t2)
                        (close_to_right_edge_practicable v r t2)
                        (standing_vehicle v t2))))))))