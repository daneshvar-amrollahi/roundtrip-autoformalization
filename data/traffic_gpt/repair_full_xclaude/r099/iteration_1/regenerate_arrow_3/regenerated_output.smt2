(forall ((v Vehicle) (t Int))
  (=> (and (or (standing_vehicle v t) (parked v t))
           (in_front_of_driveway v t)
           (forall ((t2 Int))
             (=> (<= t t2)
                 (or (not (stopped v t2))
                     (forall ((t3 Int))
                       (=> (<= t2 t3)
                           (in_front_of_driveway v t3)))))))
      (forall ((t2 Int))
        (=> (<= t t2)
            (not (pedestrian_present_on_sidewalk v t2))))))