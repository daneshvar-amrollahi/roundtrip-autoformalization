(forall ((v Vehicle) (r Roadway) (t Int))
  (=> (and (on_roadway v r t)
           (using_opposing_direction_lane_to_pass v t))
      (or (and (in_authorized_lane v t)
               (left_side_clear_for_passing v r t)
               (forall ((u Vehicle))
                 (=> (and (on_roadway u r t)
                          (approaching_opposite u v t))
                     (safely_clear v u t))))
          (not (using_opposing_direction_lane_to_pass v t)))))