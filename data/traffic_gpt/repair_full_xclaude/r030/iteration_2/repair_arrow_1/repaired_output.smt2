(forall ((v_from_right Vehicle) (v_from_left Vehicle) (l_target Lane) (l_from_right Lane) (l_from_left Lane) (t Int))
  (=> (and (not (= v_from_right v_from_left))
           (not (= l_target l_from_right))
           (not (= l_target l_from_left))
           (not (= l_from_right l_from_left))
           (= (lane_on_roadway l_target) (lane_on_roadway l_from_right))
           (= (lane_on_roadway l_target) (lane_on_roadway l_from_left))
           (= (roadway_flow (lane_on_roadway l_target)) FK_OneWay)
           (>= (roadway_lane_count (lane_on_roadway l_target)) 3)
           (lane_adjacent l_from_right l_target)
           (lane_adjacent l_from_left l_target)
           (lane_adjacent l_from_right l_from_left)
           (on_lane v_from_right l_from_right t)
           (on_lane v_from_right l_target t)
           (on_lane v_from_left l_from_left t)
           (on_lane v_from_left l_target t))
      (approaching_from_right v_from_right v_from_left (Intersection) t)))