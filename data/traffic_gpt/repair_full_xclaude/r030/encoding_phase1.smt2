(forall ((v_from_right Vehicle) (v_from_left Vehicle) (l_target Lane) (l_right Lane) (l_left Lane) (t Int) (r Roadway))
  (=> (and (not (= v_from_right v_from_left))
           (= (lane_on_roadway l_target) r)
           (= (lane_on_roadway l_right) r)
           (= (lane_on_roadway l_left) r)
           (= (roadway_flow r) FK_OneWay)
           (>= (roadway_lane_count r) 3)
           (on_lane v_from_right l_right t)
           (on_lane v_from_left l_left t)
           (on_lane v_from_right l_target (+ t 1))
           (on_lane v_from_left l_target (+ t 1))
           (lane_adjacent l_right l_target)
           (lane_adjacent l_target l_left))
      (yield_right_of_way_to_pedestrian v_from_right t)))