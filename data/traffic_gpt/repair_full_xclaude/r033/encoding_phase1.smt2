(forall ((v_op Vehicle) (r Roadway) (t Int))
  (=> (and (on_roadway v_op r t)
           (or (= (district_of_roadway r) DK_Other)
               (= (district_of_roadway r) DK_Urban))
           (in_caravan_or_motorcade v_op t)
           (not (is_funeral_procession v_op t)))
      (exists ((v_other Vehicle))
        (and (not (= v_other v_op))
             (sufficient_space_for_vehicle_to_enter v_op v_other t)))))