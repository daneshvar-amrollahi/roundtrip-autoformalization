(forall ((v1 Vehicle) (v2 Vehicle) (r Roadway) (t Int))
  (=> (and (on_roadway v1 r t)
           (on_roadway v2 r t)
           (not (= v1 v2))
           (= (roadway_flow r) FK_TwoWay)
           (not (roadway_sufficient_width r))
           (approaching_opposite v1 v2 t))
      (or (and (= (roadway_pos v1 r t) RP_RightHalf)
               (= (roadway_pos v2 r t) RP_LeftHalf))
          (and (= (roadway_pos v1 r t) RP_LeftHalf)
               (= (roadway_pos v2 r t) RP_RightHalf))
          (and (not (practicable_within_single_lane v1 r t))
               (proceeded_with_due_caution v1 t))
          (and (not (practicable_within_single_lane v2 r t))
               (proceeded_with_due_caution v2 t)))))