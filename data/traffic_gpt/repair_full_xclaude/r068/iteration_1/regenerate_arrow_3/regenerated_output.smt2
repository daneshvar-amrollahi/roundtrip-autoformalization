(forall ((v Vehicle) (u Vehicle) (i Intersection) (t Int))
  (=> (and (not (= v u))
           (approaching_intersection v i t)
           (= (intersection_control i) IC_Uncontrolled)
           (approaching_from_right u v i t)
           (or (and (in_intersection u i t)
                    (approaching_from_right u v i t))
               (and (approaching_intersection u i t)
                    (is_immediate_hazard u v i t))))
      (and (stopped v t)
           (not (entering_intersection v i t)))))