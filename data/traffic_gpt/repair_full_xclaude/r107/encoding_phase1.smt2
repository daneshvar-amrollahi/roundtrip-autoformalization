(forall ((v Vehicle) (r Roadway) (t Int))
  (=> (on_roadway v r t)
      (forall ((u Vehicle))
        (=> (and (not (= v u))
                 (on_roadway u r t)
                 (in_authorized_lane u t)
                 (not (racing u t))
                 (not (reckless_driving u t)))
            (speed_reasonable_and_prudent v r t)))))