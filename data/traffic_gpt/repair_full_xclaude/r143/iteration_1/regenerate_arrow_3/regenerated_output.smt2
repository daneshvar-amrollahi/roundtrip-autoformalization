(forall ((v Vehicle) (bus Vehicle) (r Roadway) (t Int))
  (=> (and (on_roadway v r t)
           (= (roadway_kind r) RK_Highway)
           (= (roadway_divided r) DK_Divided)
           (approaching_bus v bus t)
           (bus_stopped_for_students bus t)
           (bus_visual_signal_on bus t)
           (not (same_roadway_as_bus v bus r t)))
      (not (stopped_before_reaching v bus t))))