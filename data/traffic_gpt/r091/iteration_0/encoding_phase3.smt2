(forall ((v_op Vehicle) (v_other Vehicle) (r Roadway) (t Int))
  (=> (and (on_roadway v_op r t)
           (or (= (stop_action v_op t) SA_Stop)
               (= (stop_action v_op t) SA_Stand)
               (= (stop_action v_op t) SA_Park))
           (on_roadway v_other r t)
           (distinct v_op v_other)
           (or (stopped v_other t) (parked v_other t))
           (or (right_wheels_within_18in v_other r t)
               (left_wheels_within_18in v_other r t)))
      (not (or (right_wheels_within_18in v_op r t)
               (left_wheels_within_18in v_op r t)))))