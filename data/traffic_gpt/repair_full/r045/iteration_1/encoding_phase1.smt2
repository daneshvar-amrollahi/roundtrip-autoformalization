(forall ((v Vehicle) (sc Vehicle) (r Roadway) (t Int))
  (=> (and (= (kind sc) VK_Streetcar)
           (on_roadway v r t)
           (= (roadway_pos v r t) RP_StreetcarTrack)
           (in_front_of v sc t)
           (exists ((t_sig Int))
             (and (<= t_sig t)
                  (streetcar_operator_signaled sc v t_sig))))
      (moved_off_track_asap v t)))