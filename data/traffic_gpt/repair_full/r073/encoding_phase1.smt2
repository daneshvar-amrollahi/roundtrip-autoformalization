(forall ((v_op Vehicle) (v_other Vehicle) (a Access) (r Roadway) (t Int))
  (=> (and (on_roadway v_op r t)
           (= (roadway_access_control r) AC_Limited)
           (or (emerging_from v_op a t)
               (turning_into v_op a t))
           (access_on_roadway a r)
           (not (= v_op v_other))
           (on_roadway v_other r t)
           (or (entering_main_lane v_other t)
               (emerging_from v_other a t)
               (turning_into v_other a t)))
      (yield_right_of_way_to_pedestrian v_op t)))