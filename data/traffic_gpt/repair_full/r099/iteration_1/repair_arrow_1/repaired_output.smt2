(forall ((v Vehicle) (t Int))
  (=> (and (in_front_of_driveway v t)
           (or (= (stop_action v t) SA_Stand)
               (= (stop_action v t) SA_Park))
           (not (and (exists ((t0 Int))
                       (and (<= t0 t)
                            (not (in_front_of_driveway v t0))))
                     (exists ((t1 Int))
                       (and (<= t t1)
                            (not (in_front_of_driveway v t1)))))))
      false))