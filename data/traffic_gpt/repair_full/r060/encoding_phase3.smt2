(forall ((v Vehicle) (r Roadway) (t Int))
  (=> (and (on_roadway v r t)
           (or (approaching_curve_or_crest v r t)
               (roadway_has_grade r)))
      (forall ((v_opp Vehicle))
        (=> (and (not (= v v_opp))
                 (approaching_opposite v_opp v t)
                 (<= (distance v v_opp t) ft_500_sq)
                 (not (vehicle_visible_within_500ft v t)))
            (and (not (intends_turn v TD_UTurn t))
                 (not (executing_turn v TD_UTurn t)))))))