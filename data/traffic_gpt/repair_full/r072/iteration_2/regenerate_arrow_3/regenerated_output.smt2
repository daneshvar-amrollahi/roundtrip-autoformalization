(forall ((v Vehicle) (i Intersection) (t Int))
  (=> (and (approaching_intersection v i t)
           (= (intersection_control i) IC_YieldSign))
      (and (reduced_speed_appropriate v t)
           (forall ((v_other Vehicle))
             (=> (and (not (= v_other v))
                      (or (in_intersection v_other i t)
                          (exists ((r Roadway))
                            (and (intersection_on_roadway i r)
                                 (= (roadway_kind r) RK_Highway)
                                 (approaching_intersection v_other i t)
                                 (is_immediate_hazard v_other v i t)))))
                 (yield_right_of_way_to_pedestrian v t))))))