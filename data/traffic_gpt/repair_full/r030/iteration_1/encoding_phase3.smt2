(forall ((v_left Vehicle) (v_right Vehicle) (r Roadway) (l_target Lane) (l_left Lane) (l_right Lane) (t Int))
  (=> (and (not (= v_left v_right))
           (on_roadway v_left r t)
           (on_roadway v_right r t)
           (= (roadway_flow r) FK_OneWay)
           (>= (roadway_lane_count r) 3)
           (= (lane_on_roadway l_target) r)
           (= (lane_on_roadway l_left) r)
           (= (lane_on_roadway l_right) r)
           (on_lane v_left l_left t)
           (on_lane v_right l_right t)
           (lane_adjacent l_left l_target)
           (lane_adjacent l_right l_target)
           (intends_lane_change v_left TD_Left t)
           (intends_lane_change v_right TD_Right t)
           (on_lane v_left l_target (+ t 1))
           (on_lane v_right l_target (+ t 1)))
      (yield_right_of_way_to_pedestrian v_left t)))