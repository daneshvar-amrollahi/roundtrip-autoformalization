(forall ((v_right Vehicle) (v_left Vehicle) (l_target Lane) (l_right Lane) (l_left Lane) (t Int))
  (=> (and (on_lane v_right l_right t)
           (on_lane v_left l_left t)
           (lane_adjacent l_right l_target)
           (lane_adjacent l_left l_target)
           (not (= l_right l_left))
           (not (= v_right v_left))
           (= (lane_on_roadway l_right) (lane_on_roadway l_target))
           (= (lane_on_roadway l_left) (lane_on_roadway l_target))
           (= (roadway_flow (lane_on_roadway l_target)) FK_OneWay)
           (>= (roadway_lane_count (lane_on_roadway l_target)) 3)
           (on_lane v_right l_target (+ t 1))
           (on_lane v_left l_target (+ t 1)))
      (yield_right_of_way_to_pedestrian v_right t))))