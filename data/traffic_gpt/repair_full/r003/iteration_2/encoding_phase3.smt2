(forall ((v Vehicle) (u Vehicle) (r Roadway) (t Int))
  (=> (and (on_roadway v r t)
           (on_roadway u r t)
           (not (= v u))
           (obstruction_present v r t)
           (crossing_center_line v r t)
           (approaching_opposite v u t)
           (not (crossing_center_line u r t))
           (not (safe-distance v u t)))
      (proceeded_with_due_caution v t)))