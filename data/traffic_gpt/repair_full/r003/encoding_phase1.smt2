(forall ((v_op Vehicle) (v_other Vehicle) (r Roadway) (t Int))
  (=> (and (on_roadway v_op r t)
           (on_roadway v_other r t)
           (not (= v_op v_other))
           (obstruction_present v_op r t)
           (crossing_center_line v_op r t)
           (not (crossing_center_line v_other r t))
           (approaching_opposite v_op v_other t)
           (not (safe-distance v_op v_other t)))
      (proceeded_with_due_caution v_op t)))