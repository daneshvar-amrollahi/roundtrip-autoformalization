(forall ((v Vehicle) (r Roadway) (t Int))
  (=> (and (on_roadway v r t)
           (= (roadway_kind r) RK_Highway)
           (not (= (district_of_roadway r) DK_Business))
           (not (= (district_of_roadway r) DK_Residence))
           (or (= (stop_action v t) SA_Stop)
               (= (stop_action v t) SA_Stand)
               (= (stop_action v t) SA_Park)))
      (or (and (not (off_main_traveled_part_practicable v r t))
               (width_unobstructed v r t)
               (clear_view_200ft v r t))
          (not (parked_on_roadway v r t)))))