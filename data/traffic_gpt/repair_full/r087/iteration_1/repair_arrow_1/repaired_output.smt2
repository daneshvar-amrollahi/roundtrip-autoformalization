(forall ((v Vehicle) (c Crossing) (t Int))
  (=> (and (cargo_is_explosive_or_flammable v)
           (approaching_crossing v c t)
           (> (velocity v t) mph_20))
      (forall ((t2 Int))
        (=> (and (<= t t2)
                 (< (dist_to_nearest_rail_sq v c t2) ft_200_sq))
            (exists ((t1 Int))
              (and (<= t t1)
                   (< t1 t2)
                   (<= (velocity v t1) mph_20)))))))