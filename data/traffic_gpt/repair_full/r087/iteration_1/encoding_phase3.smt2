(forall ((v Vehicle) (c Crossing) (t Int))
  (=> (and (cargo_is_explosive_or_flammable v)
           (approaching_crossing v c t)
           (> (velocity v t) mph_20)
           (<= (dist_to_nearest_rail_sq v c t) ft_200_sq))
      (exists ((t0 Int))
        (and (<= t0 t)
             (approaching_crossing v c t0)
             (<= (velocity v t0) mph_20)
             (forall ((t1 Int))
               (=> (and (<= t0 t1) (<= t1 t))
                   (approaching_crossing v c t1)))))))