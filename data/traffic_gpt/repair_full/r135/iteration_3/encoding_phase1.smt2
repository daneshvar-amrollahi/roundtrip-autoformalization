(forall ((v Vehicle) (p Vehicle) (t Int))
  (=> (and (police_signal_given p v t)
           (or (audible_signal p v t)
               (emergency_signals_active p t))
           (or (and (not (stopped v t))
                    (fleeing_police v t))
               (and (not (stopped v t))
                    (not (fleeing_police v t)))))
      (or (and (not (stopped v t))
               (fleeing_police v t))
          (and (not (stopped v t))
               (not (fleeing_police v t))))))