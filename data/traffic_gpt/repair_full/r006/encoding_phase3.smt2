(forall ((v Vehicle) (r Roadway) (a Access) (t Int))
  (=> (and (on_roadway v r t)
           (= (roadway_flow r) FK_TwoWay)
           (>= (roadway_lane_count r) 4)
           (not (in_authorized_lane v t))
           (not (obstruction_present v r t)))
      (or (and (or (= (access_kind a) AK_Alley)
                   (= (access_kind a) AK_PrivateRoad)
                   (= (access_kind a) AK_Driveway))
               (access_on_roadway a r)
               (or (emerging_from v a t)
                   (turning_into v a t))
               (intends_turn v TD_Left t))
          (not (crossing_center_line v r t))))))