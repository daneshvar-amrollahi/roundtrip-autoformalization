(forall ((v_main Vehicle) (r_main Roadway) (i Intersection) (t Int) (v_other Vehicle) (r_other Roadway))
  (=> (and (on_roadway v_main r_main t)
           (or (= (roadway_lane_count r_main) 1)
               (= (roadway_lane_count r_main) 2))
           (approaching_intersection v_main i t)
           (intersection_on_roadway i r_main)
           (= (intersection_control i) IC_Uncontrolled)
           (on_roadway v_other r_other t)
           (intersection_on_roadway i r_other)
           (not (= r_other r_main))
           (or (= (roadway_divided r_other) DK_Divided)
               (and (roadway_has_marked_lanes r_other)
                    (>= (roadway_lane_count r_other) 3)))
           (or (in_intersection v_other i t)
               (approaching_intersection v_other i t))
           (is_immediate_hazard v_other v_main i t))
      (and (stopped v_main t)
           (not (entering_intersection v_main i t)))))