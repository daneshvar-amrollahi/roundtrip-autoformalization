(forall ((v_follower Vehicle) (v_leader Vehicle) (r Roadway) (t Int))
  (=> (and (on_roadway v_follower r t)
           (on_roadway v_leader r t)
           (following v_follower v_leader t)
           (not (= v_follower v_leader))
           (or (= (kind v_follower) VK_Truck)
               (drawing_another_vehicle v_follower t))
           (or (= (kind v_leader) VK_Truck)
               (drawing_another_vehicle v_leader t))
           (not (= (district_of_roadway r) DK_Business))
           (not (= (district_of_roadway r) DK_Residence)))
      (exists ((v_passing Vehicle))
        (and (not (= v_passing v_follower))
             (not (= v_passing v_leader))
             (passing v_passing v_leader t)
             (sufficient_space_for_vehicle_to_enter v_passing v_follower t)
             (in_front_of v_passing v_follower t)
             (in_front_of v_leader v_passing t))))))