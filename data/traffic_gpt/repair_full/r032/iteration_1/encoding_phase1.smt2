(forall ((v_follower Vehicle) (v_leader Vehicle) (v_passing Vehicle) (t Int))
  (=> (and (not (= v_follower v_leader))
           (not (= v_follower v_passing))
           (not (= v_leader v_passing))
           (or (= (kind v_follower) VK_Truck) (drawing_another_vehicle v_follower t))
           (or (= (kind v_leader) VK_Truck) (drawing_another_vehicle v_leader t))
           (following v_follower v_leader t)
           (exists ((r Roadway))
             (and (on_roadway v_follower r t)
                  (not (or (= (district_of_roadway r) DK_Business)
                           (= (district_of_roadway r) DK_Residence))))))
      (sufficient_space_for_vehicle_to_enter v_passing v_follower t)))