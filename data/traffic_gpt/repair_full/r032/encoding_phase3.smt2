(forall ((v_follow Vehicle) (v_lead Vehicle) (r Roadway) (t Int))
  (=> (and (following v_follow v_lead t)
           (not (= v_follow v_lead))
           (on_roadway v_follow r t)
           (on_roadway v_lead r t)
           (or (= (kind v_follow) VK_Truck) (drawing_another_vehicle v_follow t))
           (or (= (kind v_lead) VK_Truck) (drawing_another_vehicle v_lead t))
           (not (= (district_of_roadway r) DK_Business))
           (not (= (district_of_roadway r) DK_Residence)))
      (exists ((v_pass Vehicle))
        (and (not (= v_pass v_follow))
             (not (= v_pass v_lead))
             (sufficient_space_for_vehicle_to_enter v_pass v_follow t)
             (in_front_of v_pass v_follow t)
             (in_front_of v_lead v_pass t)))))