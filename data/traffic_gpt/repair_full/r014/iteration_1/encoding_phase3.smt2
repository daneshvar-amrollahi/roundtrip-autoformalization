(forall ((v_pass Vehicle) (v_oncoming Vehicle) (t Int))
  (=> (and (using_opposing_direction_lane_to_pass v_pass t)
           (approaching_opposite v_oncoming v_pass t)
           (<= (distance v_pass v_oncoming t) ft_200_sq))
      (exists ((t_back Int))
        (and (<= t_back t)
             (in_authorized_lane v_pass t_back)
             (exists ((t_start Int))
               (and (<= t_start t_back)
                    (using_opposing_direction_lane_to_pass v_pass t_start)
                    (forall ((t0 Int))
                      (=> (and (<= t_start t0) (< t0 t_back))
                          (not (in_authorized_lane v_pass t0))))))))))