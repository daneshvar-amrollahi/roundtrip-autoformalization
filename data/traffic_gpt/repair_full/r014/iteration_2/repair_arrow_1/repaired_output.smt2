(forall ((v_pass Vehicle) (v_oncoming Vehicle) (t Int))
  (=> (and (using_opposing_direction_lane_to_pass v_pass t)
           (approaching_opposite v_pass v_oncoming t)
           (not (= v_pass v_oncoming)))
      (forall ((t_first Int))
        (=> (and (<= t t_first)
                 (<= (distance v_pass v_oncoming t_first) ft_200_sq)
                 (forall ((t_prev Int))
                   (=> (and (<= t t_prev) (< t_prev t_first))
                       (< ft_200_sq (distance v_pass v_oncoming t_prev)))))
            (exists ((t_ret Int))
              (and (<= t t_ret)
                   (< t_ret t_first)
                   (in_authorized_lane v_pass t_ret)))))))