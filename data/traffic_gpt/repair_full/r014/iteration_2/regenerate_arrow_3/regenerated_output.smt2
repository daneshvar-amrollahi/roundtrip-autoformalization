(forall ((v_pass Vehicle) (v_oncoming Vehicle) (t Int))
  (=> (and (not (= v_pass v_oncoming))
           (using_opposing_direction_lane_to_pass v_pass t)
           (approaching_opposite v_pass v_oncoming t)
           (<= (distance v_pass v_oncoming t) ft_200_sq)
           (forall ((t_prev Int))
             (=> (< t_prev t)
                 (or (not (using_opposing_direction_lane_to_pass v_pass t_prev))
                     (not (approaching_opposite v_pass v_oncoming t_prev))
                     (> (distance v_pass v_oncoming t_prev) ft_200_sq)))))
      (exists ((t_ret Int))
        (and (< t_ret t)
             (in_authorized_lane v_pass t_ret)
             (exists ((t_start Int))
               (and (<= t_start t_ret)
                    (using_opposing_direction_lane_to_pass v_pass t_start)
                    (forall ((t0 Int))
                      (=> (< t0 t_start)
                          (not (using_opposing_direction_lane_to_pass v_pass t0))))))))))