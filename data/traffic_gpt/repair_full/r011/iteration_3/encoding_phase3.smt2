(forall ((v_pass Vehicle) (v_passed Vehicle) (r Roadway) (t_sig Int))
  (=> (and (passing v_pass v_passed t_sig)
           (on_roadway v_passed r t_sig)
           (audible_signal v_pass v_passed t_sig))
      (exists ((t_move Int))
        (and (<= t_sig t_move)
             (on_roadway v_passed r t_move)
             (or (= (roadway_pos v_passed r t_move) RP_RightHalf)
                 (= (roadway_pos v_passed r t_move) RP_RightLane))
             (forall ((t2 Int))
               (=> (and (<= t_move t2)
                        (not (completely_passed v_pass v_passed t2)))
                   (or (= (roadway_pos v_passed r t2) RP_RightHalf)
                       (= (roadway_pos v_passed r t2) RP_RightLane))))))))