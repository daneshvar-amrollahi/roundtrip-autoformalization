(forall ((v_passer Vehicle) (v_passed Vehicle) (t Int))
  (=> (and (audible_signal v_passer v_passed t)
           (passing v_passer v_passed t)
           (not (= v_passer v_passed)))
      (exists ((r Roadway) (t_move Int))
        (and (on_roadway v_passed r t)
             (<= t t_move)
             (or (= (roadway_pos v_passed r t) RP_RightHalf)
                 (= (roadway_pos v_passed r t) RP_RightLane)
                 (and (not (= (roadway_pos v_passed r t) RP_RightHalf))
                      (not (= (roadway_pos v_passed r t) RP_RightLane))
                      (or (= (roadway_pos v_passed r t_move) RP_RightHalf)
                          (= (roadway_pos v_passed r t_move) RP_RightLane))))
             (forall ((t2 Int))
               (=> (and (<= t_move t2)
                        (not (completely_passed v_passer v_passed t2)))
                   (or (= (roadway_pos v_passed r t2) RP_RightHalf)
                       (= (roadway_pos v_passed r t2) RP_RightLane))))))))