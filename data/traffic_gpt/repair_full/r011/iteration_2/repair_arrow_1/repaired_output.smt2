(forall ((v_passing Vehicle) (v_passed Vehicle) (t Int))
  (=> (and (audible_signal v_passing v_passed t)
           (passing v_passing v_passed t)
           (not (= v_passing v_passed)))
      (forall ((r Roadway))
        (=> (and (on_roadway v_passing r t)
                 (on_roadway v_passed r t))
            (forall ((t2 Int))
              (=> (and (<= t t2)
                       (not (completely_passed v_passing v_passed t2)))
                  (or (= (roadway_pos v_passed r t2) RP_RightHalf)
                      (= (roadway_pos v_passed r t2) RP_RightLane)))))))))