(forall ((v Vehicle) (t Int))
  (=> (and (in_front_of_driveway v t)
           (or (= (stop_action v t) SA_Stand)
               (= (stop_action v t) SA_Park))
           (not (and (exists ((t_not Int))
                       (and (< t t_not)
                            (not (in_front_of_driveway v t_not))))
                     (exists ((t_in Int))
                       (and (< t t_in)
                            (in_front_of_driveway v t_in))))))
      false))