(forall ((v Vehicle) (t Int))
  (=> (and (in_front_of_driveway v t)
           (or (= (stop_action v t) SA_Stand)
               (= (stop_action v t) SA_Park))
           (not (and (exists ((t2 Int))
                       (and (< t t2)
                            (not (in_front_of_driveway v t2))))
                     (exists ((t3 Int))
                       (and (< t t3)
                            (in_front_of_driveway v t3))))))
      false))