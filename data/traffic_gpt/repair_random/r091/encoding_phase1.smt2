(forall ((v Vehicle) (u Vehicle) (r Roadway) (t Int))
  (=> (and (on_roadway v r t)
           (or (= (stop_action v t) SA_Stop)
               (= (stop_action v t) SA_Stand)
               (= (stop_action v t) SA_Park))
           (on_roadway u r t)
           (or (stopped u t)
               (parked u t))
           (or (right_wheels_within_18in u r t)
               (left_wheels_within_18in u r t))
           (not (= v u)))
      (not (or (right_wheels_within_18in v r t)
               (left_wheels_within_18in v r t)))))