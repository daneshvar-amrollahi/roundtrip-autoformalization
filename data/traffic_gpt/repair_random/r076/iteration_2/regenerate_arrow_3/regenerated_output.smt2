(forall ((v_op Vehicle) (v_em Vehicle) (r Roadway) (t Int))
  (=> (and (on_roadway v_op r t)
           (on_roadway v_em r t)
           (is_authorized_emergency_vehicle v_em)
           (emergency_vehicle_approaching v_em v_op t))
      (and (close_to_right_edge_practicable v_op r t)
           (parallel_to_curb v_op r t)
           (forall ((i Intersection))
             (=> (intersection_on_roadway i r)
                 (not (in_intersection v_op i t))))
           (stopped v_op t)
           (standing_vehicle v_op t)
           (forall ((t2 Int))
             (=> (and (<= t t2)
                      (not (completely_passed v_em v_op t2)))
                 (and (stopped v_op t2)
                      (standing_vehicle v_op t2)))))))