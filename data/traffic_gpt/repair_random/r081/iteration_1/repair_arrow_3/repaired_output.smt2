(forall ((v_op Vehicle) (a Access) (r Roadway) (v_oncoming Vehicle) (t Int))
  (=> (and (emerging_from v_op a t)
           (access_on_roadway a r)
           (or (= (access_kind a) AK_Alley)
               (= (access_kind a) AK_Driveway)
               (= (access_kind a) AK_Building))
           (on_roadway v_op r t)
           (on_roadway v_oncoming r t)
           (not (= v_op v_oncoming))
           (approaching_opposite v_oncoming v_op t))
      (assured_clear_distance v_op v_oncoming t)))