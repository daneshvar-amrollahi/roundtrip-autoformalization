(forall ((v_op Vehicle) (i Intersection) (t Int))
  (=> (and (approaching_intersection v_op i t)
           (= (intersection_control i) IC_Uncontrolled))
      (forall ((v_right Vehicle))
        (=> (and (not (= v_right v_op))
                 (or (in_intersection v_right i t)
                     (approaching_intersection v_right i t))
                 (approaching_from_right v_op v_right i t)
                 (is_immediate_hazard v_op v_right i t))
            (and (stopped v_op t)
                 (yield_right_of_way_to_pedestrian v_op t)
                 (not (entering_intersection v_op i t)))))))