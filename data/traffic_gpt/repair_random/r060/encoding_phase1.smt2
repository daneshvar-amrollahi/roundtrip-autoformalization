(forall ((v_turn Vehicle) (r Roadway) (v_other Vehicle) (t Int))
  (=> (and (on_roadway v_turn r t)
           (or (approaching_curve_or_crest v_turn r t)
               (roadway_has_grade r))
           (or (intends_turn v_turn TD_UTurn t)
               (executing_turn v_turn TD_UTurn t))
           (approaching_opposite v_other v_turn t)
           (not (= v_other v_turn))
           (not (vehicle_visible_within_500ft v_turn t))
           (<= (distance v_other v_turn t) ft_500_sq))
      (and (not (intends_turn v_turn TD_UTurn t))
           (not (executing_turn v_turn TD_UTurn t)))))