(forall ((v_op Vehicle) (r_unpaved Roadway) (i Intersection) (t Int) (r_paved Roadway) (v_paved Vehicle))
  (=> (and (on_roadway v_op r_unpaved t)
           (not (roadway_is_paved r_unpaved))
           (approaching_intersection v_op i t)
           (intersection_on_roadway i r_paved)
           (roadway_is_paved r_paved)
           (on_roadway v_paved r_paved t)
           (or (in_intersection v_paved i t)
               (approaching_intersection v_paved i t))
           (is_immediate_hazard v_paved v_op i t))
      (and (stopped v_op t)
           (yield_right_of_way_to_pedestrian v_op t)
           (not (entering_intersection v_op i t)))))