(forall ((v Vehicle) (sc Vehicle) (r Roadway) (t Int))
  (=> (and (not (= v sc))
           (on_roadway v r t)
           (on_roadway sc r t)
           (= (kind sc) VK_Streetcar)
           (or (= (streetcar_state sc t) SCS_Moving)
               (= (streetcar_state sc t) SCS_StoppedForPassengers)
               (= (streetcar_state sc t) SCS_AboutToStopForPassengers))
           (= (heading v t) (heading sc t))
           (or (and (passing v sc t)
                    (= (passing_side v sc t) PS_Left))
               (= (roadway_pos v r t) RP_LeftHalf)
               (= (roadway_pos v r t) RP_LeftLane)))
      (or (directed_by_police v t)
          (= (roadway_flow r) FK_OneWay)
          (track_location_prevents_compliance v sc r t))))