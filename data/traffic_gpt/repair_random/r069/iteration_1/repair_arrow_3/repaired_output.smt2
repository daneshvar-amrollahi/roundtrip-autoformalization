(forall ((v Vehicle) (r Roadway) (i Intersection) (t Int) (u Vehicle) (r2 Roadway))
  (=> (and (on_roadway v r t)
           (intersection_on_roadway i r)
           (road_terminates_at r i)
           (approaching_intersection v i t)
           (on_roadway u r2 t)
           (intersection_on_roadway i r2)
           (not (= r r2))
           (or (in_intersection u i t) (approaching_intersection u i t))
           (is_immediate_hazard u v i t))
      (and (stopped v t)
           (forall ((t2 Int))
             (=> (and (<= t t2)
                      (or (and (on_roadway u r2 t2)
                               (or (in_intersection u i t2) (approaching_intersection u i t2))
                               (is_immediate_hazard u v i t2))
                          (and (not (on_roadway u r2 t2))
                               (is_immediate_hazard u v i t2))))
                 (not (entering_intersection v i t2))))
           (not (is_immediate_hazard v u i t)))))