(forall ((v Vehicle) (bus Vehicle) (t Int))
  (=> (and (approaching_bus v bus t)
           (stopped_before_reaching v bus t))
      (forall ((t2 Int))
        (=> (and (<= t t2)
                 (not (or (bus_resumed_motion bus t2)
                          (bus_driver_signaled_proceed bus v t2)
                          (not (bus_visual_signal_on bus t2)))))
            (stopped v t2)))))