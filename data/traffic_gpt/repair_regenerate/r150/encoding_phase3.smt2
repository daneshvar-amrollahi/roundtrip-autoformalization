(forall ((v Vehicle) (c Crossing) (t Int))
  (=> (and (= (kind v) VK_HeavyEquipment)
           (approaching_crossing v c t))
      (and
        (=> (and (<= ft_15_sq (dist_to_nearest_rail_sq v c t))
                 (<= (dist_to_nearest_rail_sq v c t) ft_50_sq))
            (stopped v t))
        (=> (rail_stop_condition_holds v c t)
            (and (stopped v t)
                 (<= ft_15_sq (dist_to_nearest_rail_sq v c t))
                 (<= (dist_to_nearest_rail_sq v c t) ft_50_sq)))
        (forall ((t2 Int))
          (=> (and (<= t t2)
                   (not (safe_to_proceed v c t2)))
              (not (permitted_to_proceed v c t2)))))))