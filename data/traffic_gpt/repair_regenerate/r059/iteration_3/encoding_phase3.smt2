(forall ((v Vehicle) (r_from Roadway) (i Intersection) (r_to Roadway) (t Int))
  (=> (and (on_roadway v r_from t)
           (= (roadway_flow r_from) FK_OneWay)
           (approaching_intersection v i t)
           (intersection_on_roadway i r_from)
           (intends_turn v TD_Left t)
           (exists ((a Access))
             (and (turning_into v a t)
                  (access_on_roadway a r_to)
                  (= (roadway_flow r_to) FK_OneWay))))
      (forall ((t2 Int))
        (=> (and (<= t t2)
                 (executing_turn_at_intersection v TD_Left i t2))
            (close_to_left_curb v r_from t2)))))