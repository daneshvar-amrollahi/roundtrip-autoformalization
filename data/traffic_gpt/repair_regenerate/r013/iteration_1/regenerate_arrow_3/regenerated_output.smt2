(forall ((v_pass Vehicle) (v_passed Vehicle) (r Roadway) (t Int))
  (=> (and (on_roadway v_pass r t)
           (on_roadway v_passed r t)
           (passing v_pass v_passed t)
           (using_opposing_direction_lane_to_pass v_pass t))
      (or (in_authorized_lane v_pass t)
          (and (left_side_clear_for_passing v_pass r t)
               (forall ((t2 Int))
                 (=> (and (<= t t2)
                          (not (completely_passed v_pass v_passed t2)))
                     (forall ((v_oncoming Vehicle))
                       (=> (and (distinct v_oncoming v_pass)
                                (approaching_opposite v_oncoming v_pass t2))
                           (not (interfered_or_impeded v_pass v_oncoming t2))))))))))