(forall ((bus Vehicle) (c Crossing) (t Int))
  (=> (and (= (kind bus) VK_SchoolBus)
           (approaching_crossing bus c t))
      (exists ((t_stop Int))
        (and (<= t t_stop)
             (stopped bus t_stop)
             (and (<= ft_15 (dist_to_nearest_rail_sq bus c t_stop))
                  (<= (dist_to_nearest_rail_sq bus c t_stop) ft_50))))))