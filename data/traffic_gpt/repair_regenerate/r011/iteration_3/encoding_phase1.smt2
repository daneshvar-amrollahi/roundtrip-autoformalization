(forall ((v_passed Vehicle) (v_passer Vehicle) (r Roadway) (t Int))
  (=> (and (passing v_passer v_passed t)
           (audible_signal v_passer v_passed t)
           (on_roadway v_passed r t)
           (on_roadway v_passer r t))
      (forall ((t2 Int))
        (=> (and (<= t t2)
                 (not (completely_passed v_passer v_passed t2)))
            (or (= (roadway_pos v_passed r t2) RP_RightHalf)
                (= (roadway_pos v_passed r t2) RP_RightLane))))))