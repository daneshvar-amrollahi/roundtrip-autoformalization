(forall ((m1 Vehicle) (m2 Vehicle) (m3 Vehicle) (l Lane) (t Int))
  (=> (and (= (kind m1) VK_Motorcycle)
           (= (kind m2) VK_Motorcycle)
           (= (kind m3) VK_Motorcycle)
           (not (= m1 m2))
           (not (= m1 m3))
           (not (= m2 m3))
           (on_lane m1 l t)
           (on_lane m2 l t)
           (on_lane m3 l t))
      (not (and (operating_abreast m1 m2 l t)
                (operating_abreast m1 m3 l t)
                (operating_abreast m2 m3 l t)))))