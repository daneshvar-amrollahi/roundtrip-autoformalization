(forall ((v Vehicle) (t Int))
  (=> (and (or (= (kind v) VK_Regular)
               (= (kind v) VK_Ambulance)
               (= (kind v) VK_FireApparatus)
               (= (kind v) VK_Streetcar)
               (= (kind v) VK_SchoolBus)
               (= (kind v) VK_Motorcycle)
               (= (kind v) VK_Moped)
               (= (kind v) VK_Truck)
               (= (kind v) VK_Bus)
               (= (kind v) VK_TowTruck)
               (= (kind v) VK_HeavyEquipment)
               (= (kind v) VK_PoliceVehicle)
               (= (kind v) VK_UtilityVehicle)
               (= (kind v) VK_WasteVehicle))
           (on_sidewalk_or_trail v t)
           (not (crossing_sidewalk v t)))
      (not (on_sidewalk_or_trail v t))))