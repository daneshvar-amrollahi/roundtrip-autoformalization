(forall ((v_op Vehicle) (v_sc Vehicle) (r Roadway) (t Int))
  (=> (and (on_roadway v_op r t)
           (on_roadway v_sc r t)
           (not (= v_op v_sc))
           (= (kind v_sc) VK_Streetcar)
           (or (= (streetcar_state v_sc t) SCS_Moving)
               (= (streetcar_state v_sc t) SCS_StoppedForPassengers)
               (= (streetcar_state v_sc t) SCS_AboutToStopForPassengers))
           (= (heading v_op t) (heading v_sc t))
           (or (and (passing v_op v_sc t)
                    (= (passing_side v_op v_sc t) PS_Left))
               (= (roadway_pos v_op r t) RP_LeftHalf)
               (= (roadway_pos v_op r t) RP_LeftLane)))
      (or (directed_by_police v_op t)
          (= (roadway_flow r) FK_OneWay)
          (track_location_prevents_compliance v_op v_sc r t))))