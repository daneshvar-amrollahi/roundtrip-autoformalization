(forall ((v_op Vehicle) (i Intersection) (t Int))
  (=> (and (approaching_intersection v_op i t)
           (= (intersection_control i) IC_Uncontrolled))
      (forall ((v_right Vehicle))
        (=> (and (not (= v_right v_op))
                 (or (and (in_intersection v_right i t)
                          (approaching_from_right v_right v_op i t))
                     (and (approaching_intersection v_right i t)
                          (approaching_from_right v_right v_op i t)
                          (is_immediate_hazard v_right v_op i t))))
            (and (stopped v_op t)
                 (not (entering_intersection v_op i t)))))))