(forall ((v Vehicle) (i Intersection) (r Roadway) (t Int))
  (=> (and (on_roadway v r t)
           (intersection_on_roadway i r)
           (road_terminates_at r i)
           (approaching_intersection v i t))
      (and (stopped v t)
           (forall ((u Vehicle) (r2 Roadway))
             (=> (and (not (= u v))
                      (intersection_on_roadway i r2)
                      (not (= r2 r))
                      (on_roadway u r2 t)
                      (or (in_intersection u i t)
                          (approaching_intersection u i t))
                      (is_immediate_hazard u v i t))
                 (not (entering_intersection v i t)))))))