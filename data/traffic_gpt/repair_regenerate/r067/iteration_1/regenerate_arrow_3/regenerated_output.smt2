(forall ((v_unpaved Vehicle) (i Intersection) (t Int))
  (=> (and (exists ((r_unpaved Roadway))
             (and (on_roadway v_unpaved r_unpaved t)
                  (not (roadway_is_paved r_unpaved))))
           (approaching_intersection v_unpaved i t)
           (exists ((r_paved Roadway))
             (and (intersection_on_roadway i r_paved)
                  (roadway_is_paved r_paved))))
      (and (stopped v_unpaved t)
           (yield_right_of_way_to_pedestrian v_unpaved t)
           (forall ((v_paved Vehicle))
             (=> (and (not (= v_paved v_unpaved))
                      (exists ((r_paved_at_i Roadway))
                        (and (intersection_on_roadway i r_paved_at_i)
                             (roadway_is_paved r_paved_at_i)
                             (on_roadway v_paved r_paved_at_i t)))
                      (or (in_intersection v_paved i t)
                          (approaching_intersection v_paved i t))
                      (is_immediate_hazard v_paved v_unpaved i t))
                 (not (entering_intersection v_unpaved i t)))))))