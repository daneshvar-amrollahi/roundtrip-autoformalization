(forall ((m Vehicle) (r Roadway) (l1 Lane) (l2 Lane) (t Int))
  (=> (and (= (kind m) VK_Motorcycle)
           (between_lanes m t)
           (on_roadway m r t)
           (on_lane m l1 t)
           (on_lane m l2 t)
           (distinct l1 l2)
           (= (lane_on_roadway l1) r)
           (= (lane_on_roadway l2) r)
           (lane_adjacent l1 l2)
           (or (= (roadway_flow r) FK_OneWay)
               (= (roadway_direction r) (heading m t))))
      (not (between_lanes m t))))