(forall ((v_passer Vehicle) (v_oncoming Vehicle) (t Int))
  (=> (and (using_opposing_direction_lane_to_pass v_passer t)
           (approaching_opposite v_oncoming v_passer t)
           (not (= v_passer v_oncoming)))
      (forall ((t2 Int))
        (=> (and (<= t t2)
                 (using_opposing_direction_lane_to_pass v_passer t2)
                 (approaching_opposite v_oncoming v_passer t2)
                 (< (distance v_passer v_oncoming t2) ft_200_sq))
            (in_authorized_lane v_passer t2)))))