(forall ((v Vehicle) (z Zone) (r Roadway) (t Int))
  (=> (and (on_roadway v r t)
           (in_zone v z t)
           (is_safety_zone z)
           (or (= (stop_action v t) SA_Stop)
               (= (stop_action v t) SA_Stand)
               (= (stop_action v t) SA_Park)))
      (and (not (driving_through_safety_zone v z t))
           (or (and (not (close_to_right_curb v r t))
                    (not (close_to_left_curb v r t)))
               (and (>= (dist_to_feature v PF_SafetyZone t) ft_30)
                    (>= (dist_to_feature v PF_SafetyZone t) ft_30))))))