(forall ((v Vehicle) (r Roadway) (i Intersection) (v_other Vehicle) (t Int))
  (=> (and (on_roadway v r t)
           (obstruction_present v r t)
           (crossing_center_line v r t)
           (on_roadway v_other r t)
           (not (crossing_center_line v_other r t))
           (approaching_intersection v i t)
           (approaching_intersection v_other i t)
           (is_immediate_hazard v v_other i t)
           (not (= v v_other)))
      (yield_right_of_way_to_pedestrian v t)))