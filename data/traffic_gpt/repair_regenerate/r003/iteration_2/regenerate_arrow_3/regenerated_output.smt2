(forall ((v Vehicle) (u Vehicle) (r Roadway) (i Intersection) (t Int))
  (=> (and (on_roadway v r t)
           (obstruction_present v r t)
           (crossing_center_line v r t)
           (on_roadway u r t)
           (not (crossing_center_line u r t))
           (approaching_intersection v i t)
           (approaching_intersection u i t)
           (is_immediate_hazard v u i t)
           (not (= v u)))
      (yield_right_of_way_to_pedestrian v t)))