(forall ((v Vehicle) (r Roadway) (a Access) (td TurnDir) (t Int))
  (=> (and (on_roadway v r t)
           (or (turning_into v a t)
               (intends_lane_change v td t)
               (crossing_center_line v r t)))
      (or (movement_can_be_made_safely v t)
          (and (turning_into v a t)
               (not (or (= (access_kind a) AK_PrivateRoad)
                        (= (access_kind a) AK_Driveway))))))))