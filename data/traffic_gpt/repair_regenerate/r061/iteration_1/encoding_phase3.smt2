(forall ((v Vehicle) (r Roadway) (a Access) (t Int))
  (=> (and (on_roadway v r t)
           (or (turning_into v a t)
               (intends_turn v TD_Left t)
               (intends_turn v TD_Right t)
               (intends_turn v TD_UTurn t)
               (intends_lane_change v TD_Left t)
               (intends_lane_change v TD_Right t)
               (intends_lane_change v TD_UTurn t))
           (not (movement_can_be_made_safely v t)))
      (not (or (turning_into v a t)
               (executing_turn v TD_Left t)
               (executing_turn v TD_Right t)
               (executing_turn v TD_UTurn t)
               (intends_lane_change v TD_Left t)
               (intends_lane_change v TD_Right t)
               (intends_lane_change v TD_UTurn t)))))