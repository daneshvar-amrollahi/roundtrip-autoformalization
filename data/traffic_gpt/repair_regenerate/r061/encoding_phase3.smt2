(forall ((v Vehicle) (r Roadway) (a Access) (t Int))
  (=> (and (on_roadway v r t)
           (or (turning_into v a t)
               (exists ((td TurnDir)) (intends_lane_change v td t))
               (crossing_center_line v r t))
           (not (and (turning_into v a t)
                     (not (= (access_kind a) AK_PrivateRoad))
                     (not (= (access_kind a) AK_Driveway)))))
      (movement_can_be_made_safely v t)))