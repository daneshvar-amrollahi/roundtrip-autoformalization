(forall ((v_left Vehicle) (v_right Vehicle) (r Roadway) (l_from_left Lane) (l_to Lane) (l_from_right Lane) (i Intersection) (t Int))
  (=> (and (not (= v_left v_right))
           (is_ego v_left)
           (on_roadway v_left r t)
           (on_roadway v_right r t)
           (= (roadway_flow r) FK_OneWay)
           (>= (roadway_lane_count r) 3)
           (on_lane v_left l_from_left t)
           (on_lane v_right l_from_right t)
           (lane_adjacent l_from_left l_to)
           (lane_adjacent l_from_right l_to)
           (= (lane_on_roadway l_from_left) r)
           (= (lane_on_roadway l_from_right) r)
           (= (lane_on_roadway l_to) r)
           (intends_lane_change v_left TD_Left t)
           (intends_lane_change v_right TD_Right t)
           (pedestrian_present_in_crosswalk i t))
      (yield_right_of_way_to_pedestrian v_left t)))