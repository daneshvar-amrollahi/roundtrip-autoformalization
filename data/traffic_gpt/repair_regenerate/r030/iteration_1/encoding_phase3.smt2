(forall ((v Vehicle) (u Vehicle) (r Roadway) (l Lane) (t Int))
  (=> (and (not (= v u))
           (on_roadway v r t)
           (on_roadway u r t)
           (= (roadway_flow r) FK_OneWay)
           (>= (roadway_lane_count r) 3)
           (on_lane v l t)
           (on_lane u l t)
           (= (lane_on_roadway l) r)
           (intends_lane_change v TD_Left t)
           (intends_lane_change u TD_Right t))
      (yield_right_of_way_to_pedestrian v t)))