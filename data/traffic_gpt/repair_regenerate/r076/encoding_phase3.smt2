(forall ((v Vehicle) (ev Vehicle) (r Roadway) (t Int))
  (=> (and (not (= v ev))
           (on_roadway v r t)
           (on_roadway ev r t)
           (is_authorized_emergency_vehicle ev)
           (emergency_vehicle_approaching v ev t))
      (and
        (=> (close_to_right_edge_practicable v r t)
            (and (= (roadway_pos v r t) RP_RightHalf)
                 (parallel_to_curb v r t)))
        (forall ((i Intersection) (t2 Int))
          (=> (and (intersection_on_roadway i r)
                   (<= t t2)
                   (not (completely_passed ev v t2)))
              (not (entering_intersection v i t2))))
        (forall ((t2 Int))
          (=> (and (<= t t2)
                   (not (completely_passed ev v t2)))
              (and (stopped v t2)
                   (standing_vehicle v t2)))))))