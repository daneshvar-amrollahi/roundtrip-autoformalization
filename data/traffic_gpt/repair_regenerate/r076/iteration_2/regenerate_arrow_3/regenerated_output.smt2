(forall ((v Vehicle) (ev Vehicle) (r Roadway) (i Intersection) (t Int))
  (=> (and (on_roadway v r t)
           (on_roadway ev r t)
           (is_authorized_emergency_vehicle ev)
           (intersection_on_roadway i r)
           (approaching_intersection v i t)
           (approaching_intersection ev i t)
           (emergency_vehicle_approaching ev v t))
      (forall ((t2 Int))
        (=> (and (<= t t2)
                 (not (completely_passed ev v t2)))
            (and (parallel_to_curb v r t2)
                 (close_to_right_edge_practicable v r t2)
                 (not (in_intersection v i t2))
                 (stopped v t2)
                 (standing_vehicle v t2))))))