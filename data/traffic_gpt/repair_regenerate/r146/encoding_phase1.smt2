(forall ((v_sc Vehicle) (v_em Vehicle) (i Intersection) (t Int))
  (=> (and (= (kind v_sc) VK_Streetcar)
           (is_authorized_emergency_vehicle v_em)
           (emergency_vehicle_approaching v_em v_sc t))
      (and (stopped v_sc t)
           (forall ((i2 Intersection))
             (not (in_intersection v_sc i2 t)))
           (forall ((t2 Int))
             (=> (and (<= t t2)
                      (not (completely_passed v_em v_sc t2)))
                 (and (stopped v_sc t2)
                      (forall ((i3 Intersection))
                        (not (in_intersection v_sc i3 t2)))))))))