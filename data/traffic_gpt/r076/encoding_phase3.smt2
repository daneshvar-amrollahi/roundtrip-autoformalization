(forall ((v Vehicle) (ev Vehicle) (r Roadway) (t Int))
  (=> (and (on_roadway v r t)
           (emergency_vehicle_approaching v ev t)
           (is_authorized_emergency_vehicle ev))
      (and (close_to_right_edge_practicable v r t)
           (parallel_to_curb v r t)
           (forall ((i Intersection))
             (not (entering_intersection v i t)))
           (forall ((t2 Int))
             (=> (and (<= t t2)
                      (not (completely_passed ev v t2)))
                 (and (stopped v t2)
                      (standing_vehicle v t2)
                      (forall ((i2 Intersection))
                        (not (entering_intersection v i2 t2)))))))))