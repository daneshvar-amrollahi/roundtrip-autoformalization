(forall ((v_obstructed Vehicle) (v_hazard Vehicle) (r Roadway) (i Intersection) (t Int))
  (=> (and (on_roadway v_obstructed r t)
           (on_roadway v_hazard r t)
           (not (= v_obstructed v_hazard))
           (obstruction_present v_obstructed r t)
           (crossing_center_line v_obstructed r t)
           (intersection_on_roadway i r)
           (is_immediate_hazard v_hazard v_obstructed i t))
      (assured_clear_distance v_obstructed v_hazard t)))