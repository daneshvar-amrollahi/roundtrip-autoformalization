(forall ((v Vehicle) (r Roadway) (a Access) (u Vehicle) (t Int))
  (=> (and (on_roadway v r t)
           (= (roadway_access_control r) AC_Limited)
           (access_on_roadway a r)
           (or (emerging_from v a t)
               (turning_into v a t))
           (on_roadway u r t)
           (not (= v u))
           (or (entering_main_lane u t)
               (emerging_from u a t)
               (turning_into u a t)))
      (yield_right_of_way_to_pedestrian v t)))