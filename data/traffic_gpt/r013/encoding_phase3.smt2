(forall ((v_pass Vehicle) (r Roadway) (t Int))
  (=> (and (on_roadway v_pass r t)
           (using_opposing_direction_lane_to_pass v_pass t))
      (and (in_authorized_lane v_pass t)
           (left_side_clear_for_passing v_pass r t)
           (forall ((v_oncoming Vehicle))
             (=> (and (on_roadway v_oncoming r t)
                      (not (= v_oncoming v_pass))
                      (approaching_opposite v_oncoming v_pass t))
                 (safely_clear v_pass v_oncoming t))))))