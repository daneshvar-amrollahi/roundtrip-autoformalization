(forall ((v_op Vehicle) (a Access) (r Roadway) (v_opp Vehicle) (t Int))
  (=> (and (emerging_from v_op a t)
           (or (= (access_kind a) AK_Alley)
               (= (access_kind a) AK_Driveway)
               (= (access_kind a) AK_Building))
           (access_on_roadway a r)
           (on_roadway v_op r t)
           (on_roadway v_opp r t)
           (not (= v_op v_opp))
           (approaching_opposite v_opp v_op t))
      (assured_clear_distance v_op v_opp t)))