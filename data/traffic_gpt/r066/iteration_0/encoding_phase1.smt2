(forall ((v_op Vehicle) (r Roadway) (i Intersection) (t Int) (v_other Vehicle))
  (=> (and (on_roadway v_op r t)
           (approaching_intersection v_op i t)
           (= (intersection_control i) IC_Uncontrolled)
           (intersection_on_roadway i r)
           (or (= (roadway_lane_count r) 1)
               (= (roadway_lane_count r) 2))
           (or (= (roadway_divided r) DK_Divided)
               (and (roadway_has_marked_lanes r)
                    (>= (roadway_lane_count r) 3)))
           (not (= v_op v_other))
           (approaching_opposite v_op v_other t)
           (or (in_intersection v_other i t)
               (approaching_intersection v_other i t))
           (is_immediate_hazard v_other v_op i t))
      (and (stopped v_op t)
           (yield_right_of_way_to_pedestrian v_op t)
           (not (entering_intersection v_op i t)))))