(forall ((v_op Vehicle) (i Intersection) (r Roadway) (t Int) (v_opp Vehicle))
  (=> (and (on_roadway v_op r t)
           (approaching_intersection v_op i t)
           (intersection_on_roadway i r)
           (= (intersection_control i) IC_Uncontrolled)
           (or (<= (roadway_lane_count r) 2)
               (and (= (roadway_divided r) DK_Divided)
                    (and (roadway_has_marked_lanes r)
                         (>= (roadway_lane_count r) 3))))
           (not (= v_op v_opp))
           (approaching_opposite v_opp v_op t)
           (or (in_intersection v_opp i t)
               (approaching_intersection v_opp i t))
           (is_immediate_hazard v_op v_opp i t))
      (and (stopped v_op t)
           (yield_right_of_way_to_pedestrian v_op t)
           (not (entering_intersection v_op i t)))))