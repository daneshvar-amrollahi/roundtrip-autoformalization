(forall ((v Vehicle) (t Int))
  (=> (and (in_front_of_driveway v t)
           (or (= (stop_action v t) SA_Stand)
               (= (stop_action v t) SA_Park))
           (not (exists ((t_off Int))
                  (and (< t t_off)
                       (not (in_front_of_driveway v t_off)))))
           (exists ((t_on2 Int))
             (and (< t t_on2)
                  (in_front_of_driveway v t_on2))))
      false))