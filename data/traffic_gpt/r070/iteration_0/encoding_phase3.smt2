(forall ((v_turn Vehicle) (v_opp Vehicle) (i Intersection) (a Access) (t Int))
  (=> (and (or (executing_turn_at_intersection v_turn TD_Left i t)
               (and (turning_into v_turn a t)
                    (or (= (access_kind a) AK_Alley)
                        (= (access_kind a) AK_PrivateRoad)
                        (= (access_kind a) AK_Driveway))
                    (intends_turn v_turn TD_Left t)))
           (not (= v_turn v_opp))
           (approaching_opposite v_opp v_turn t)
           (or (in_intersection v_opp i t)
               (is_immediate_hazard v_opp v_turn i t)))
      (yield_right_of_way_to_pedestrian v_turn t)))