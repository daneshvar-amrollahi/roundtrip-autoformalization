(forall ((v_op Vehicle) (r Roadway) (t Int))
  (=> (and (on_roadway v_op r t)
           (= (roadway_flow r) FK_TwoWay)
           (= (roadway_lane_count r) 3)
           (= (roadway_pos v_op r t) RP_CenterLane)
           (not (intends_turn v_op TD_Left t))
           (not (directed_by_traffic_control_device v_op t)))
      (exists ((v_other Vehicle))
        (and (not (= v_other v_op))
             (passing v_op v_other t)
             (safe-distance v_op v_other t)))))