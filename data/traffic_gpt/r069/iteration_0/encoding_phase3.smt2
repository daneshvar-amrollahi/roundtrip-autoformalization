(forall ((v_term Vehicle) (r_term Roadway) (i Intersection) (t Int))
  (=> (and (on_roadway v_term r_term t)
           (approaching_intersection v_term i t)
           (intersection_on_roadway i r_term)
           (road_terminates_at r_term i))
      (forall ((v_other Vehicle) (r_other Roadway))
        (=> (and (not (= v_other v_term))
                 (on_roadway v_other r_other t)
                 (intersection_on_roadway i r_other)
                 (not (= r_other r_term))
                 (or (in_intersection v_other i t)
                     (approaching_intersection v_other i t))
                 (is_immediate_hazard v_other v_term i t))
            (and (stopped v_term t)
                 (forall ((t2 Int))
                   (=> (and (<= t t2)
                            (not (is_immediate_hazard v_other v_term i t2)))
                       (not (entering_intersection v_term i t2))))
                 (not (is_immediate_hazard v_term v_other i t)))))))