(forall ((v Vehicle) (u Vehicle) (r Roadway) (l_target Lane) (l_u_from Lane) (l_v_from Lane) (t Int))
  (=> (and (not (= v u))
           (= (lane_on_roadway l_target) r)
           (= (roadway_flow r) FK_OneWay)
           (>= (roadway_lane_count r) 3)
           (on_roadway v r t)
           (on_roadway u r t)
           (on_lane v l_target t)
           (on_lane u l_target t)
           (intends_lane_change u TD_Left t)
           (intends_lane_change v TD_Right t)
           (lane_adjacent l_u_from l_target)
           (lane_adjacent l_v_from l_target)
           (not (= l_u_from l_v_from))
           (on_lane u l_u_from t)
           (on_lane v l_v_from t)
           (movement_can_be_made_safely u t)
           (movement_can_be_made_safely v t))
      (yield_right_of_way_to_pedestrian v t)))