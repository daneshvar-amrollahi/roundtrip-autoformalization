(forall ((p Person) (d Device) (l Land) (t Int))
  (=> (and (on_land p l t)
           (land_kind l LK_LCRALand)
           (or (device_kind d DK_Firearm)
               (device_kind d DK_Bow)
               (device_kind d DK_Crossbow)
               (device_kind d DK_Slingshot)
               (device_kind d DK_Other))
           (or (and (is_hunting p t) (uses_device p d t))
               (possesses_device p d t)
               (discharges_firearm p t)))
      (has_subchapter_authorization p t)))