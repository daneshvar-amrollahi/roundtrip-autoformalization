(forall ((p Person) (d Device) (t Int))
  (=> (and (device_kind d DK_ElectricityDevice)
           (possesses_device p d t)
           (not (has_subchapter_authorization p t)))
      (and (not (possesses_device p d t))
           (forall ((d2 Device))
             (=> (or (device_kind d2 DK_Powerboat)
                     (device_kind d2 DK_VesselOther)
                     (device_kind d2 DK_FloatingDevice))
                 (not (on_device d d2 t))))
           (not (within_half_mile_of_water d t)))))