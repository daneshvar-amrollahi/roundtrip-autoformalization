(forall ((p Person) (a Animal) (w WaterBody) (t Int))
  (=> (and (on_water_body p w t)
           (water_kind w WK_PublicFreshWater)
           (is_kind a AK_Fish)
           (or (buys p a t)
               (offers_to_buy p a t)
               (sells p a t)
               (offers_to_sell p a t)
               (and (possesses p a t) (for_sale p a t))
               (and (transports p a t) (for_sale p a t))
               (and (ships p a t) (for_sale p a t))
               (barters p a t)
               (exchanges p a t)))
      (has_subchapter_authorization p t)))