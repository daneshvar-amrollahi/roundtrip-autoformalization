(forall ((p Person) (a Animal) (t Int))
  (=> (and (protected_by_code a)
           (or (and (imports_to_state p a t)
                    (or (for_sale p a t)
                        (barters p a t)
                        (exchanges p a t)))
               (and (ships p a t)
                    (for_sale p a t))))
      (has_subchapter_authorization p t)))