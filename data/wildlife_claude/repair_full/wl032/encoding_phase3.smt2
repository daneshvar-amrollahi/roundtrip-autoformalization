(forall ((p Person) (a Animal) (t Int))
  (=> (and (imports_to_state p a t)
           (protected_by_code a)
           (exists ((k AnimalKind)) (and (is_kind a k) (during_open_season k t)))
           (or (for_sale p a t)
               (barters p a t)
               (exchanges p a t)
               (and (imports_to_state p a t) (ships p a t) (for_sale p a t)))
           (not (has_subchapter_authorization p t)))
      false))