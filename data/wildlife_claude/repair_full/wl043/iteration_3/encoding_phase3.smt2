(forall ((seller Person) (a Animal) (t Int))
  (=> (sells seller a t)
      (or
        (exists ((buyer Person))
          (and (buys buyer a t)
               (or (is_zoo_entity seller) (is_zoo_entity buyer))))
        (exists ((buyer Person))
          (and (buys buyer a t)
               (or (is_educational_institution buyer) (is_research_institution buyer))
               (for_scientific_purpose buyer t)
               (has_document_kind buyer DOK_Permit t)
               (has_subchapter_authorization buyer t)))
        (exists ((buyer Person))
          (and (buys buyer a t)
               (for_commercial_purpose buyer a t)
               (exists ((t2 Int))
                 (and (< t t2)
                      (sells buyer a t2)
                      (exists ((buyer2 Person))
                        (and (buys buyer2 a t2)
                             (or
                               (is_zoo_entity buyer2)
                               (and (or (is_educational_institution buyer2) (is_research_institution buyer2))
                                    (for_scientific_purpose buyer2 t2)
                                    (has_document_kind buyer2 DOK_Permit t2)
                                    (has_subchapter_authorization buyer2 t2))))))))))))