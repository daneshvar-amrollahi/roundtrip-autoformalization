(forall ((p Person) (d Device) (t Int))
  (=> (and (device_kind d DK_ElectricityDevice)
           (possesses_device p d t)
           (not (has_subchapter_authorization p t)))
      (and (not (possesses_device p d t))
           (forall ((b Device) (w WaterBody))
             (=> (or (and (device_kind b DK_Powerboat) (on_device d b t))
                     (and (device_kind b DK_VesselOther) (on_device d b t))
                     (and (device_kind b DK_FloatingDevice) (on_device d b t))
                     (within_half_mile_of_water d t))
                 (not (possesses_device p d t)))))))