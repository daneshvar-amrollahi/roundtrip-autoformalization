(forall ((p Person) (a Animal) (t Int))
  (and
    (=> (and (is_kind a AK_DangerousWildAnimal)
             (exists ((t_rel Int)) (and (<= t_rel t) (released_for_killing a t_rel))))
        (and (not (sells p a t))
             (not (offers_to_sell p a t))
             (not (transports p a t))
             (not (consigns_for_transport p a t))))
    (forall ((part Animal))
      (=> (and (is_part_of part a)
               (is_kind a AK_DangerousWildAnimal)
               (exists ((t_rel Int) (t_kill Int) (killer Person))
                 (and (<= t_rel t_kill)
                      (<= t_kill t)
                      (released_for_killing a t_rel)
                      (kills killer a t_kill))))
          (and (not (sells p part t))
               (not (offers_to_sell p part t)))))))