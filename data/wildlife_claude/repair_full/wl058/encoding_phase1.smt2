(forall ((p Person) (a Animal) (t Int))
  (=> (and (is_kind a AK_Fish)
           (is_in_edible_condition a t)
           (leaves_to_die p a t)
           (exists ((w WaterBody))
             (and (water_kind w WK_PublicWater)
                  (takes p a t)
                  (on_water_body p w t)))
           (not (has_intent_to_retain p a t)))
      false))