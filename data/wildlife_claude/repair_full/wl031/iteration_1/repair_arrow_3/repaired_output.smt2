(forall ((p Person) (a Animal) (t Int))
  (=>
    (and
      (imports_to_state p a t)
      (protected_by_code a)
      (or
        (and (is_kind a AK_WildBird) (during_closed_season AK_WildBird t))
        (and (is_kind a AK_WildGameBird) (during_closed_season AK_WildGameBird t))
        (and (is_kind a AK_WildFowl) (during_closed_season AK_WildFowl t))
        (and (is_kind a AK_GameBird) (during_closed_season AK_GameBird t))
        (and (is_kind a AK_WildGameAnimal) (during_closed_season AK_WildGameAnimal t))
        (and (is_kind a AK_GameAnimal) (during_closed_season AK_GameAnimal t))
        (and (is_kind a AK_NongameAnimal) (during_closed_season AK_NongameAnimal t))
        (and (is_kind a AK_Deer) (during_closed_season AK_Deer t))
        (and (is_kind a AK_MuleDeer) (during_closed_season AK_MuleDeer t))
        (and (is_kind a AK_WhiteTailedDeer) (during_closed_season AK_WhiteTailedDeer t))
        (and (is_kind a AK_DesertBighornSheep) (during_closed_season AK_DesertBighornSheep t))
        (and (is_kind a AK_PronghornAntelope) (during_closed_season AK_PronghornAntelope t))
        (and (is_kind a AK_Alligator) (during_closed_season AK_Alligator t))
        (and (is_kind a AK_GameFish) (during_closed_season AK_GameFish t))
        (and (is_kind a AK_Fish) (during_closed_season AK_Fish t))
        (and (is_kind a AK_Frog) (during_closed_season AK_Frog t))
        (and (is_kind a AK_Turtle) (during_closed_season AK_Turtle t))
      )
      (not (has_subchapter_authorization p t))
    )
    (not (imports_to_state p a t))
  )
)