(forall ((blind_hunter Person) (d Device) (t Int))
  (=> (and (is_legally_blind blind_hunter t)
           (uses_device blind_hunter d t)
           (device_kind d DK_LaserSightingDevice)
           (is_hunting blind_hunter t))
      (and (during_regular_hunting_hours t)
           (exists ((assistant Person))
             (and (not (= assistant blind_hunter))
                  (not (is_legally_blind assistant t))
                  (has_document_kind assistant DOK_HuntingLicense t)
                  (>= (age_of assistant) 13)
                  (assisted_by blind_hunter assistant t))))))