(forall ((p Person) (a Animal) (w WaterBody) (d Device) (t Int))
  (=> (and (catches p a t)
           (is_kind a AK_Fish)
           (on_water_body p w t)
           (water_kind w WK_NavigationDistrictWater)
           (uses_device p d t)
           (not (device_kind d DK_HookAndLine)))
      (and (not (device_kind d DK_Seine))
           (not (device_kind d DK_StrikeNet))
           (not (device_kind d DK_GillNet))
           (not (device_kind d DK_TrammelNet))
           (not (device_kind d DK_Trotline))
           (not (device_kind d DK_OtherFishingDevice)))))