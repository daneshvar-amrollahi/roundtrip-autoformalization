(forall ((p Person) (a Animal) (t Int))
  (=> (and (is_hunting p t)
           (or (kills p a t) (wounds p a t))
           (or (is_kind a AK_GameBird) (is_kind a AK_GameAnimal))
           (acts_intentionally p t)
           (not (has_subchapter_authorization p t)))
      (forall ((t2 Int))
        (=> (and (<= t t2)
                 (not (retrieves p a t2)))
            (makes_reasonable_effort_to_retrieve p a t2)))))