(forall ((p Person) (a Animal) (t Int))
  (=> (and (hunts p a t)
           (or (kills p a t) (wounds p a t))
           (or (is_kind a AK_DesertBighornSheep)
               (is_kind a AK_PronghornAntelope)
               (is_kind a AK_MuleDeer)
               (is_kind a AK_WhiteTailedDeer))
           (not (during_open_season AK_DesertBighornSheep t))
           )
      (and
        (forall ((t2 Int))
          (=> (and (<= t t2)
                   (not (retrieves p a t2)))
              (not (and (or (acts_intentionally p t2)
                            (acts_knowingly p t2))
                        (not (makes_reasonable_effort_to_retrieve p a t2))))))
        (forall ((t2 Int))
          (=> (<= t t2)
              (not (and (or (acts_intentionally p t2)
                            (acts_knowingly p t2)
                            (acts_recklessly p t2)
                            (acts_with_criminal_negligence p t2))
                        (not (keeps_in_edible_condition p a t2)))))))))