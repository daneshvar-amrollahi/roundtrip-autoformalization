(forall ((p Person) (a Animal) (d Device) (t Int))
  (=> (and (or (is_kind a AK_GameAnimal) (is_kind a AK_GameBird))
           (protected_by_code a)
           (hunts p a t)
           (uses_device p d t)
           (device_kind d DK_ArtificialLight)
           (illuminates d a t)
           (not (has_subchapter_authorization p t)))
      false))