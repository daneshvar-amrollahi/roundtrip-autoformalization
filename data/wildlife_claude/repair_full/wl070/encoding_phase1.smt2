(forall ((p Person) (a Animal) (t Int) (w WaterBody))
  (=> (and (is_kind a AK_Fish)
           (on_water_body p w t)
           (water_kind w WK_PublicFreshWater)
           (not (has_subchapter_authorization p t)))
      (and (not (buys p a t))
           (not (offers_to_buy p a t))
           (not (sells p a t))
           (not (offers_to_sell p a t))
           (not (and (possesses p a t) (for_sale p a t)))
           (not (and (transports p a t) (for_sale p a t)))
           (not (and (ships p a t) (for_sale p a t)))
           (not (barters p a t))
           (not (exchanges p a t)))))