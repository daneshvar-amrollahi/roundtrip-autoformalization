(forall ((p Person) (a Animal) (t Int))
  (=> (and (is_kind a AK_Bat)
           (not (has_subchapter_authorization p t)))
      (and (not (hunts p a t))
           (not (sells p a t))
           (not (offers_to_sell p a t))
           (not (buys p a t))
           (not (offers_to_buy p a t))
           (not (possesses_after_purchase p a t)))))