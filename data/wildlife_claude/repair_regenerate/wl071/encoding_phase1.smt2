(forall ((p Person) (a Animal) (t Int))
  (=> (and (possesses p a t)
           (is_kind a AK_Finfish)
           (not (is_kind a AK_Shark))
           (has_head_removed a)
           (exists ((w WaterBody)) (and (on_water_body p w t) (water_kind w WK_CoastalWater))))
      (or (and (has_been_finally_processed a t)
               (or (delivered_to_final_destination a t)
                   (delivered_to_certified_dealer a t))))))