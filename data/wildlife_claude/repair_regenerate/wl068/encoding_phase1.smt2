(forall ((p Person) (a Animal) (t Int))
  (=> (and (is_kind a AK_Fish)
           (is_named_in_protected_fish_list a)
           (possesses p a t)
           (was_imported a t))
      (and
        (exists ((d Document))
          (and (document_kind d DOK_OriginVerification)
               (keeps_with p d a t)))
        (forall ((warden Person))
          (=> (and (is_peace_officer warden t)
                   (is_department_employee warden t))
              (exists ((d Document))
                (and (document_kind d DOK_OriginVerification)
                     (displays_on_request p d t))))))))