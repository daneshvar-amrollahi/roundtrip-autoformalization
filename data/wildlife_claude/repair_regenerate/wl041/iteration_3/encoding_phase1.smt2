(forall ((p Person) (a Animal) (t Int))
  (=> (and (is_kind a AK_Wolf)
           (or
             (and (is_state_or_county_official p)
                  (on_official_duty p t)
                  (transports p a t))
             (and (or (is_licensed_circus_zoo_owner p)
                      (is_agent_of p q))
                  (exists ((q Person))
                    (and (is_licensed_circus_zoo_owner q)
                         (or (is_agent_of p q) (= p q))))
                  (or (for_exhibition p t)
                      (for_scientific_purpose p t))
                  (or (possesses p a t)
                      (transports p a t)))))
       (not (subsection_a_applies p a t))))