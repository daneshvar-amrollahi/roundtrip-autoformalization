(forall ((p Person) (a Animal) (t Int))
  (=> (and (fishes p a t)
           (is_kind a AK_Fish)
           (has_subchapter_authorization p t))
      (not (or (exists ((d Device))
                 (and (uses_device p d t)
                      (not (is_permitted_by_code d t))))
               (not (during_open_season AK_Fish t))
               (exists ((w WaterBody) (d2 Device))
                 (and (on_water_body p w t)
                      (uses_device p d2 t)
                      (not (is_permitted_by_code d2 t))))))))