(forall ((hunter Person) (a Animal) (d Device) (assistant Person) (t Int))
  (=> (and (has_physical_disability hunter t)
           (hunts hunter a t)
           (during_lawful_hunting_hours t)
           (uses_device hunter d t)
           (device_kind d DK_LaserSightingDevice))
      (exists ((ak AnimalKind))
        (and (is_kind a ak)
             (during_open_season ak t)
             (exists ((asst Person))
               (and (not (= asst hunter))
                    (assisted_by hunter asst t)
                    (not (has_physical_disability asst t))
                    (has_document_kind asst DOK_HuntingLicense t)
                    (>= (age_of asst) 13)))))))