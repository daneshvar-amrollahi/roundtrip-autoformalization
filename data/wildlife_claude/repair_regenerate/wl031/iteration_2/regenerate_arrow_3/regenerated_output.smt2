(forall ((p Person) (a Animal) (t Int))
  (=> (and (imports_to_state p a t)
           (protected_by_code a)
           (or (and (is_kind a AK_WildBird) (during_closed_season AK_WildBird t))
               (and (is_kind a AK_WildGameBird) (during_closed_season AK_WildGameBird t))
               (and (is_kind a AK_GameAnimal) (during_closed_season AK_GameAnimal t))
               (and (is_kind a AK_GameBird) (during_closed_season AK_GameBird t)))
           (not (has_subchapter_authorization p t)))
      (not (imports_to_state p a t))))