(forall ((p Person) (a Animal) (t Int))
  (=> (and (is_hunting p t)
           (or (kills p a t) (wounds p a t))
           (or (is_kind a AK_DesertBighornSheep)
               (is_kind a AK_PronghornAntelope)
               (is_kind a AK_MuleDeer)
               (is_kind a AK_WhiteTailedDeer)))
      (and
        (=> (or (acts_intentionally p t) (acts_knowingly p t))
            (forall ((t2 Int))
              (=> (and (<= t t2) (not (retrieves p a t2)))
                  (makes_reasonable_effort_to_retrieve p a t2))))
        (=> (or (acts_intentionally p t)
                (acts_knowingly p t)
                (acts_recklessly p t)
                (acts_with_criminal_negligence p t))
            (forall ((t2 Int))
              (=> (<= t t2)
                  (keeps_in_edible_condition p a t2)))))))