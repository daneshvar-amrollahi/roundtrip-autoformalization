(forall ((p Person) (a Animal) (t Int))
  (=> (and (acts_intentionally p t)
           (or (is_kind a AK_GameBird)
               (is_kind a AK_GameAnimal)
               (is_kind a AK_GameFish))
           (or (takes p a t)
               (possesses p a t))
           (not (has_subchapter_authorization p t)))
      (keeps_in_edible_condition p a t)))