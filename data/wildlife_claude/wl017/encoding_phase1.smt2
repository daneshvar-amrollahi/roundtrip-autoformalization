(forall ((p Person) (a Animal) (t Int))
  (=> (and (acts_intentionally p t)
           (or (takes p a t) (possesses p a t))
           (or (is_kind a AK_GameBird) (is_kind a AK_GameAnimal) (is_kind a AK_Fish))
           (or (acts_intentionally p t)
               (acts_knowingly p t)
               (acts_recklessly p t)
               (acts_with_criminal_negligence p t))
           (not (keeps_in_edible_condition p a t))
           (not (has_subchapter_authorization p t)))
      false))