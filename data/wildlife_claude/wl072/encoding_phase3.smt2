(forall ((p Person) (a Animal) (w WaterBody) (t Int))
  (=> (and (possesses p a t)
           (is_kind a AK_Finfish)
           (has_tail_removed a)
           (takes p a t)
           (water_kind w WK_CoastalWater)
           (on_water_body p w t))
      (or (and (has_been_finally_processed a t)
               (or (delivered_to_final_destination a t)
                   (delivered_to_certified_dealer a t)))
          (is_kind a AK_Other))))