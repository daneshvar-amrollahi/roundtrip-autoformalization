(forall ((p Person) (a Animal) (t Int))
  (=> (and (sells p a t)
           (is_kind a AK_GameAnimal))
      (or
        (and (is_zoo_entity p))
        (exists ((buyer Person))
          (and (sells p a t)
               (is_zoo_entity buyer)
               (buys buyer a t)))
        (exists ((buyer Person))
          (and (buys buyer a t)
               (or (is_educational_institution buyer)
                   (is_research_institution buyer))
               (for_scientific_purpose buyer t)
               (has_subchapter_authorization buyer t)))
        (exists ((dealer Person))
          (and (buys dealer a t)
               (for_commercial_purpose dealer a t)
               (exists ((t2 Int) (buyer2 Person))
                 (and (> t2 t)
                      (sells dealer a t2)
                      (buys buyer2 a t2)
                      (or
                        (is_zoo_entity buyer2)
                        (and (or (is_educational_institution buyer2)
                                 (is_research_institution buyer2))
                             (for_scientific_purpose buyer2 t2)
                             (has_subchapter_authorization buyer2 t2))))))))))