(forall ((seller Person) (a Animal) (t Int))
  (=> (sells seller a t)
      (or
        (is_zoo_entity seller)
        (exists ((buyer Person))
          (and (buys buyer a t)
               (is_zoo_entity buyer)))
        (exists ((buyer Person))
          (and (buys buyer a t)
               (or (is_educational_institution buyer)
                   (is_research_institution buyer))
               (for_scientific_purpose buyer t)
               (has_subchapter_authorization buyer t)))
        (exists ((dealer Person))
          (and (buys dealer a t)
               (for_commercial_purpose seller a t)
               (exists ((t2 Int))
                 (and (> t2 t)
                      (sells dealer a t2)
                      (exists ((final_buyer Person))
                        (and (buys final_buyer a t2)
                             (or
                               (is_zoo_entity final_buyer)
                               (and (or (is_educational_institution final_buyer)
                                        (is_research_institution final_buyer))
                                    (for_scientific_purpose final_buyer t2)
                                    (has_subchapter_authorization final_buyer t2))))))))))))