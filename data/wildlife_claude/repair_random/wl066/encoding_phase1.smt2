(forall ((p Person) (a Animal) (t Int))
  (=> (and (is_kind a AK_Fish)
           (was_imported a t)
           (is_named_in_protected_fish_list a)
           (or (sells p a t)
               (offers_to_sell p a t))
           (not (and (is_tagged a t)
                     (is_packaged a t)
                     (is_invoiced a t)
                     (is_labeled a t))))
      false))