(forall ((p Person) (a Animal) (t Int))
  (=> (and (or (is_kind a AK_Fish) (is_kind a AK_Shellfish))
           (is_exotic_harmful a)
           (or (imports_to_state p a t)
               (possesses p a t)
               (sells p a t)
               (exists ((w WaterBody))
                 (and (places_in_public_water p a t)
                      (on_water_body p w t)
                      (water_kind w WK_PublicWater))))
           (not (authorized_by_commission p t))
           (not (has_document_kind p DOK_Permit t)))
      false))