(forall ((p Person) (a Animal) (d Device) (t Int))
  (=> (and (on_lcra_land p t)
           (not (has_subchapter_authorization p t))
           (or (device_kind d DK_Firearm)
               (device_kind d DK_Bow)
               (device_kind d DK_Crossbow)
               (device_kind d DK_Slingshot)
               (device_kind d DK_Other)))
      (and (not (and (hunts p a t) (uses_device p d t)))
           (not (possesses_device p d t))
           (not (shoots_device p d t)))))