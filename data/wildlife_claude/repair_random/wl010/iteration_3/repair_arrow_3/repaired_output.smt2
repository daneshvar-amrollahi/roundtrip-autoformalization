(forall ((p Person) (a Animal) (d Device) (t Int))
  (=> (and (has_physical_disability p t)
           (uses_device p d t)
           (device_kind d DK_LaserSightingDevice)
           (hunts p a t))
      (and (during_lawful_hunting_hours t)
           (exists ((ak AnimalKind))
             (during_open_season ak t))
           (exists ((helper Person))
             (and (assisted_by p helper t)
                  (not (has_physical_disability helper t))
                  (has_document_kind helper DOK_HuntingLicense t)
                  (>= (age_of helper) 13))))))