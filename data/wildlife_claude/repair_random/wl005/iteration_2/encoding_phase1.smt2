(forall ((p Person) (a Animal) (light Device) (vehicle Device) (t Int))
  (=> (and (or (device_kind light DK_ArtificialLight))
           (or (device_kind vehicle DK_MotorVehicle))
           (uses_device p light t)
           (inside_device p vehicle t)
           (illuminates light a t)
           (or (is_kind a AK_Reptile)
               (is_kind a AK_Amphibian))
           (has_subchapter_authorization p t))
      (not (or (captures p a t)
               (attempts_to_catch p a t)
               (pursues p a t)))))