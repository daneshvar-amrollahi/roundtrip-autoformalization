(forall ((p Person) (a Animal) (t Int))
  (=> (and (possesses p a t)
           (is_kind a AK_Finfish)
           (has_tail_removed a)
           (exists ((fisher Person) (w WaterBody) (t_take Int))
             (and (takes fisher a t_take)
                  (<= t_take t)
                  (on_water_body fisher w t_take)
                  (water_kind w WK_CoastalWater))))
      (or (and (has_been_finally_processed a t)
               (or (delivered_to_final_destination a t)
                   (delivered_to_certified_dealer a t)))
          (is_kind a AK_Other))))