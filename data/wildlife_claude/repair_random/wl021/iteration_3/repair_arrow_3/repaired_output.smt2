(forall ((doc Document) (grantor Person) (grantee Person) (t Int) (l Land))
  (=> (is_valid_consent doc grantor grantee t)
      (and (names_grantee doc grantee)
           (identifies_land doc l)
           (signed_by doc grantor)
           (shows_address_and_phone_of doc grantor)
           (document_kind doc DOK_WrittenConsent)
           (or (is_landowner_of grantor l)
               (exists ((owner Person))
                 (and (is_landowner_of owner l)
                      (is_agent_of grantor owner)))))))