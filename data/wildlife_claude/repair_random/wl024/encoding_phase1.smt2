(forall ((p Person) (target Person) (l Land) (t Int))
  (=> (and (present_on p l t)
           (intends_to_disrupt p target t)
           (lawfully_hunting_or_catching target t)
           (not (= p target)))
      (not (or (and (is_public_land l)
                    (present_on p l t))
               (and (is_private_land l)
                    (not (or (exists ((owner Person))
                               (and (is_landowner_of owner l)
                                    (has_consent_of p owner t)))
                            (exists ((owner Person) (agent Person))
                               (and (is_landowner_of owner l)
                                    (is_agent_of agent owner)
                                    (has_consent_of p agent t))))))))))