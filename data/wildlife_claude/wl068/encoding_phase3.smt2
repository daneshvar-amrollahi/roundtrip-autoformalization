(forall ((p Person) (a Animal) (t Int))
  (=> (and (possesses p a t)
           (is_kind a AK_Fish)
           (was_imported a t)
           (is_named_in_protected_fish_list a))
      (and (exists ((d Document))
             (and (document_kind d DOK_OriginVerification)
                  (keeps_with p d a t)))
           (forall ((officer Person))
             (=> (and (is_peace_officer officer t)
                      (is_department_employee officer t))
                 (exists ((d2 Document))
                   (and (document_kind d2 DOK_OriginVerification)
                        (displays_on_request p d2 t))))))))