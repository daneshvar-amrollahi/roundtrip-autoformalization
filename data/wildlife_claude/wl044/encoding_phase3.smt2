(forall ((p Person) (a Animal) (w WaterBody) (t Int))
  (=> (and (is_kind a AK_AquaticAnimalLife)
           (water_kind w WK_PrivateWater)
           (on_water_body p w t)
           (or (catches p a t)
               (takes p a t)
               (attempts_to_catch p a t)))
      (exists ((owner Person))
        (and (is_owner_of_water owner w)
             (or (has_consent_of p owner t)
                 (exists ((agent Person))
                   (and (is_agent_of agent owner)
                        (has_consent_of p agent t))))))))