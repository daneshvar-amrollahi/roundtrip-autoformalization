(and
  (forall ((p Person) (a Animal) (t Int))
    (=> (and (is_kind a AK_DangerousWildAnimal)
             (released_for_killing a t)
             (in_captivity a t))
        (and (not (sells p a t))
             (not (offers_to_sell p a t))
             (not (transports p a t))
             (not (consigns_for_transport p a t)))))
  (forall ((p Person) (a Animal) (part Animal) (t Int) (t2 Int))
    (=> (and (is_kind a AK_DangerousWildAnimal)
             (released_for_killing a t)
             (in_captivity a t)
             (kills p a t)
             (is_part_of part a)
             (<= t t2))
        (and (not (sells p part t2))
             (not (offers_to_sell p part t2))))))