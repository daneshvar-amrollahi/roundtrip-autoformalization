(forall ((p Person) (a Animal) (t Int))
  (=> (and (or (is_kind a AK_WildBird)
               (is_kind a AK_GameBird)
               (is_kind a AK_GameAnimal))
           (or (sells p a t)
               (offers_to_sell p a t)
               (buys p a t)
               (offers_to_buy p a t)
               (possesses_after_purchase p a t))
           (not (has_subchapter_authorization p t)))
      false))