(forall ((p Person) (a Animal) (t Int))
  (=> (and (hunts p a t)
           (or (is_kind a AK_WildGameAnimal)
               (is_kind a AK_WildBird)
               (is_kind a AK_WildFowl))
           (on_state_park p t)
           (not (authorized_by_commission p t))
           (not (has_subchapter_authorization p t)))
      false))